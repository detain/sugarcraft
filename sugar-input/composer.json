{
    "name": "sugarcraft/sugar-input",
    "description": "Terminal escape sequence decoder for keyboard (legacy, Kitty progressive protocol, xterm modifyOtherKeys) and mouse (X10, urxvt 1015, SGR 1006/1016), with typed terminal-reply draining. Provides the InputDriver interface and the EscapeDecoder implementation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "input",
        "keyboard",
        "mouse",
        "escape-sequences",
        "kitty",
        "sgr",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-input",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-input/issues",
        "source": "https://github.com/sugarcraft/sugar-input",
        "docs": "https://sugarcraft.github.io/lib/sugar-input.html"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "evenement/evenement": "^3.0",
        "react/event-loop": "^1.6",
        "react/stream": "^1.2",
        "sugarcraft/sugar-core": "dev-master"
    },
    "suggest": {
        "ext-pcntl": "Required by SignalResizeDriver for SIGWINCH detection; without it arm() returns false.",
        "ext-posix": "Used by the test suite to self-signal SIGWINCH."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Input\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Input\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
