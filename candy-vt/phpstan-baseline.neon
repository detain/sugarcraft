			message: '#^Parameter &\$pending by\-ref type of method SugarCraft\\Vt\\Handler\\EraseHandler\:\:apply\(\) expects array\<int, array\{row\: int, col\: int, cell\: SugarCraft\\Vt\\Cell\}\>\|null, array\|null given\.$#'
			identifier: parameterByRef.type
			count: 5
			path: src/Handler/EraseHandler.php

