{
    "name": "sugarcraft/sugar-widgets",
    "description": "PHP port of charmbracelet/bubbles \u2014 pre-built TUI components (text input, dynamic-height textarea, list, table with per-cell styleFunc, tree, viewport, file picker, progress, spinner, etc.) for SugarCraft.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "cli",
        "components",
        "widgets",
        "text-input",
        "textarea",
        "list",
        "table",
        "viewport",
        "file-picker",
        "progress-bar",
        "spinner",
        "bubbles",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-widgets",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-widgets/issues",
        "source": "https://github.com/sugarcraft/sugar-widgets",
        "docs": "https://sugarcraft.github.io/lib/sugar-widgets.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-forms": "dev-master",
        "sugarcraft/sugar-style": "dev-master",
        "sugarcraft/sugar-mouse": "dev-master",
        "sugarcraft/sugar-spring": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Widgets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Widgets\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
