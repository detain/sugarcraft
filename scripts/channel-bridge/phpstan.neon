# Lane-local static analysis for the P0 channel-bridge (bridge.review m4).
# Product configs are untouched; run from the repo copy root:
#   candy-code/vendor/bin/phpstan analyse -c scripts/channel-bridge/phpstan.neon
parameters:
    level: 5
    # The bridge treats every wire array as hostile even when a sibling
    # docblock promises a shape: is_array()/?? legs are deliberate
    # defense-in-depth, so PHPDoc-derived types must not call them dead code.
    treatPhpDocTypesAsCertain: false
    phpVersion: 80300
    paths:
        - bridge.php
        - selfcheck.php
        - src
    bootstrapFiles:
        - src/autoload.php
    # --- justified ignores: each entry covers a proven analyzer limitation
    # (writes made by reference across callbacks phpstan cannot see) or a
    # deliberately kept API shape. No entry hides a real defect. ---
    ignoreErrors:
        # selfcheck drives $done from a loop callback: phpstan cannot see
        # writes made across $loop->run().
        -
                identifier: booleanNot.alwaysTrue
                path: selfcheck.php
        # the wire-capture $events list grows by reference inside handlers;
        # the empty-array comparisons are phpstan reading the declaration
        # point, not real dead code.
        -
                identifier: foreach.emptyArray
                path: selfcheck.php
        -
                identifier: nullCoalesce.offset
                path: selfcheck.php
        -
                identifier: identical.alwaysTrue
                path: selfcheck.php
        -
                identifier: notIdentical.alwaysFalse
                path: selfcheck.php
        -
                identifier: booleanAnd.alwaysFalse
                path: selfcheck.php
        -
                identifier: identical.alwaysFalse
                path: selfcheck.php
        # defensive ?? on a file-sourced DiscoveryFile record whose fields
        # may predate the property.
        -
                identifier: nullCoalesce.property
                path: selfcheck.php
        # Bridge stores the loop to mirror sibling constructor arity; the P1
        # refactor reads it — dropping the param now would churn every
        # positional call site for cosmetics.
        -
                identifier: property.onlyWritten
                path: src/Bridge.php
