# VHS runner toolchain pins — RT-22 (repo-tooling-024).
#
# OG-5 recommend arm: in-repo version pins, verified by sha256 at build time.
# The weekly cron in .github/workflows/vhs-runner-image.yml no longer resolves
# upstream and overwrites `:latest` out from under the render jobs; instead it
# compares upstream against THIS file and opens a bump PR when they diverge,
# so a released-asset substitution surfaces as a reviewable PR — and "why did
# the GIFs change" is bisectable to the commit that moved a pin.
#
# Consumers: the image build args in vhs-runner-image.yml, the image tag the
# render jobs pull (derived in vhs.yml's `changed` job as
# vhs-${VHS_VERSION}-ttyd-${TTYD_VERSION}), and the sha256 verification legs
# in scripts/vhs-runner/Dockerfile.
#
# Style: a shell-sourceable KEY=value file (the splitsh-lite pinned+hashed
# download in sync-sugarcraft.yml is the in-repo exemplar of this discipline).

VHS_VERSION=v0.12.1
TTYD_VERSION=1.7.7

# charmbracelet/vhs -> vhs_${VHS_VERSION#v}_Linux_x86_64.tar.gz (whole tarball)
VHS_SHA256=eb33787a5b1cebf91fe0b18bd231e2d71d36c1ff4babd99ddac1a6ab411efd10
# tsl0922/ttyd -> ttyd.x86_64 (standalone binary asset)
TTYD_SHA256=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
