#!/usr/bin/env php
<?php

declare(strict_types=1);

// ---------------------------------------------------------------------------
// Autoloader (archive-aware). A phar build stamps THIS file as the archive
// stub, so under `php candy-image.phar` __FILE__ names the archive and its
// bundled vendor/ is the only correct source. Measured PHP 8.3 law: in the
// stub context \Phar::running(false) answers '' and a bare '/x.phar/entry'
// path fails is_file — resolve from BOTH identities ('phar://' . __FILE__
// under the stub, 'phar://' . running() when required from inside), and once
// an archive is found DROP the filesystem candidates so a working-tree vendor
// beside a published .phar can never outrank the archive. The three original
// candidates are preserved verbatim for every non-archive run.
// ---------------------------------------------------------------------------
(static function (): void {
    // strtolower: Windows/macOS filesystems are case-insensitive by default,
    // so a renamed candy-image.PHAR is just as much the archive — the suffix
    // identity test must not be case-sensitive (candy-image-052). Phar::running
    // cannot rescue a fall-through here: in stub context it answers '' (the
    // file's own measured law above), so the old case-sensitive test died on
    // 'cannot find composer autoload.php' for the uppercase spelling.
    $archive = str_ends_with(strtolower(__FILE__), '.phar')
        ? 'phar://' . __FILE__
        : (\Phar::running(false) !== '' ? 'phar://' . \Phar::running(false) : '');
    $candidates = $archive !== ''
        ? [$archive . '/vendor/autoload.php']
        : ['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    foreach ($candidates as $candidate) {
        // phar:// URIs are absolute too — the old '/'-only prefix test would
        // re-anchor them onto __DIR__ and miss the archive.
        $path = (str_starts_with($candidate, '/') || str_starts_with($candidate, 'phar://'))
            ? $candidate
            : __DIR__ . '/../' . $candidate;
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-image: cannot find composer autoload.php\n");
    exit(1);
})();

// Locale before the first message is formatted — the --help text and every
// flag/format refusal land in the user's language (sugar-core documents
// T::setLocale(T::detect()) at startup). detect() answers 'en' when the
// environment is silent, so a package shipping only lang/en.php behaves
// byte-identically to the pre-wiring shape; machine-facing output (the
// --version line, --dump-detect labels) is deliberately never translated.
\SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());

// Two-line shim by design: every branch lives in Cli::main() so the argv
// handling, format refusal, decode failures, and viewport sizing are
// testable in-process.
exit(\SugarCraft\CandyImage\Cli::main($argv ?? [], STDOUT, STDERR));
