{
    "name": "sugarcraft/sugar-panels",
    "description": "Box-drawing layout engine \u2014 composes terminal content into horizontal and vertical panels with box-drawing borders, padding, and dynamic dimension calculation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "box",
        "layout",
        "panel",
        "border",
        "terminal",
        "sugarcraft",
        "bubbleboxer"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-panels",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-panels/issues",
        "source": "https://github.com/sugarcraft/sugar-panels"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-cellbuffer": "dev-master",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-constraints": "dev-master",
        "sugarcraft/sugar-style": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Panels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Panels\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
