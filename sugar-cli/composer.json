{
    "name": "sugarcraft/sugar-cli",
    "description": "Opinionated CLI presentation helpers shaped after charmbracelet/fang's output layer: StatusLine (✓/✗/⚠/ℹ), Banner, Section header, Stage step, HelpText page, Frame, Logo, and stock themes (ansi/plain/charm/dracula/nord/catppuccin, plus terminal-adaptive auto).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cli",
        "console",
        "presentation",
        "status-line",
        "banner",
        "help",
        "fang",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-cli",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-cli/issues",
        "source": "https://github.com/sugarcraft/sugar-cli",
        "docs": "https://sugarcraft.github.io/lib/sugar-cli.html"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-style": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Cli\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
