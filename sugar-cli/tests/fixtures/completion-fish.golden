# fish completion for candy-code
# Generated by sugar-cli from the command spec; do not edit.

function __candy_code_complete
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l cur (commandline -ct)
    set -l cstate 0
    set -l pending ''
    set -l ended 0
    set -l args 0
    for word in $tokens
        if test -n "$pending"
            set pending ''
            continue
        end
        if test $ended = 1
            continue
        end
        if test "$word" = '--'
            set ended 1
            continue
        end
        if test $cstate = 0
            if contains -- "$word" '--tag'
                set pending 'tag'
            else if contains -- "$word" '--model' '-m'
                set pending 'model'
            else if contains -- "$word" '--effort'
                set pending 'effort'
            else if test $args = 0; and test "$word" = 'run'
                set cstate 1
            else if test $args = 0; and test "$word" = 'config'
                set cstate 2
            else if test $args = 0; and test "$word" = 'doctor'
                set cstate 4
            else if not string match -q -- '-*' "$word"
                set args 1
            end
        else if test $cstate = 1
            if contains -- "$word" '--max-turns'
                set pending 'max-turns'
            else if not string match -q -- '-*' "$word"
                set args 1
            end
        else if test $cstate = 2
            if test $args = 0; and test "$word" = 'get'
                set cstate 3
            else if not string match -q -- '-*' "$word"
                set args 1
            end
        else if test $cstate = 3
            if not string match -q -- '-*' "$word"
                set args 1
            end
        else if test $cstate = 4
            if not string match -q -- '-*' "$word"
                set args 1
            end
        end
    end
    if test -n "$pending"
        if test "$cstate:$pending" = '0:effort'
            printf '%s\n' 'low' 'high'
            return
        end
        __fish_complete_path "$cur"
        return
    end
    if test $ended = 1
        __fish_complete_path "$cur"
        return
    end
    if string match -q -- '-*' "$cur"
        if test $cstate = 0
            printf '%s\t%s\n' '--verbose' 'Print more detail'
            printf '%s\t%s\n' '-v' 'Print more detail'
            printf '%s\t%s\n' '--json' 'Emit JSON'
            printf '%s\t%s\n' '--tag' 'Attach a tag'
            printf '%s\t%s\n' '--model' 'Model to use'
            printf '%s\t%s\n' '-m' 'Model to use'
            printf '%s\t%s\n' '--effort' 'Reasoning effort'
        end
        if test $cstate = 1
            printf '%s\t%s\n' '--max-turns' 'Turn limit'
            printf '%s\t%s\n' '--verbose' 'Print more detail'
            printf '%s\t%s\n' '-v' 'Print more detail'
        end
        if test $cstate = 2
            printf '%s\t%s\n' '--verbose' 'Print more detail'
            printf '%s\t%s\n' '-v' 'Print more detail'
        end
        if test $cstate = 3
            printf '%s\t%s\n' '--verbose' 'Print more detail'
            printf '%s\t%s\n' '-v' 'Print more detail'
        end
        if test $cstate = 4
            printf '%s\t%s\n' '--verbose' 'Print more detail'
            printf '%s\t%s\n' '-v' 'Print more detail'
        end
        return
    end
    if test $args = 0
        if test $cstate = 0
            printf '%s\t%s\n' 'run' 'Run one prompt'
            printf '%s\t%s\n' 'config' 'Read settings'
            printf '%s\t%s\n' 'doctor' 'Check the install\'s health'
            return
        end
        if test $cstate = 2
            printf '%s\t%s\n' 'get' 'Print one setting'
            return
        end
    end
    __fish_complete_path "$cur"
end

complete -c 'candy-code' -f -a '(__candy_code_complete)'
