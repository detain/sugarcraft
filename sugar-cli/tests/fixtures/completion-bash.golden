# bash completion for candy-code
# Generated by sugar-cli from the command spec; do not edit.

__candy_code_filter() {
    local cur="$1" word
    shift
    COMPREPLY=()
    for word in "$@"; do
        [[ $word == "$cur"* ]] && COMPREPLY+=("$word")
    done
    return 0
}

_candy_code() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local state=0 pending="" ended=0 args=0 word i
    for (( i = 1; i < COMP_CWORD; i++ )); do
        word="${COMP_WORDS[i]}"
        if [[ -n $pending ]]; then
            # bash splits --name=value at "="; the value is the word after it.
            [[ $word == "=" ]] || pending=""
            continue
        fi
        (( ended )) && continue
        if [[ $word == "--" ]]; then
            ended=1
            continue
        fi
        case "$state" in
            0)
                case "$word" in
                    '--tag') pending='tag' ;;
                    '--model'|'-m') pending='model' ;;
                    '--effort') pending='effort' ;;
                    'run') (( args )) || state=1 ;;
                    'config') (( args )) || state=2 ;;
                    'doctor') (( args )) || state=4 ;;
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            1)
                case "$word" in
                    '--max-turns') pending='max-turns' ;;
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            2)
                case "$word" in
                    'get') (( args )) || state=3 ;;
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            3)
                case "$word" in
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            4)
                case "$word" in
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
        esac
    done
    if [[ -n $pending ]]; then
        [[ $cur == "=" ]] && cur=""
        case "$state:$pending" in
            '0:effort') __candy_code_filter "$cur" 'low' 'high'; return ;;
        esac
        COMPREPLY=()
        return 0
    fi
    if (( ended )); then
        COMPREPLY=()
        return 0
    fi
    if [[ $cur == -* ]]; then
        COMPREPLY=()
        case "$state" in
            0) __candy_code_filter "$cur" '--verbose' '-v' '--json' '--tag' '--model' '-m' '--effort' ;;
            1) __candy_code_filter "$cur" '--max-turns' '--verbose' '-v' ;;
            2) __candy_code_filter "$cur" '--verbose' '-v' ;;
            3) __candy_code_filter "$cur" '--verbose' '-v' ;;
            4) __candy_code_filter "$cur" '--verbose' '-v' ;;
        esac
        return 0
    fi
    if (( args == 0 )); then
        case "$state" in
            0) __candy_code_filter "$cur" 'run' 'config' 'doctor'; return ;;
            2) __candy_code_filter "$cur" 'get'; return ;;
        esac
    fi
    COMPREPLY=()
    return 0
}

complete -o default -F _candy_code 'candy-code'
