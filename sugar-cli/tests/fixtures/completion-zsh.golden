#compdef candy-code
# zsh completion for candy-code
# Generated by sugar-cli from the command spec; do not edit.

_candy_code() {
    local cur="${words[CURRENT]}"
    local cstate=0 pending="" ended=0 args=0 word i
    local -a candidates
    for (( i = 2; i < CURRENT; i++ )); do
        word="${words[i]}"
        if [[ -n $pending ]]; then
            pending=""
            continue
        fi
        (( ended )) && continue
        if [[ $word == "--" ]]; then
            ended=1
            continue
        fi
        case "$cstate" in
            0)
                case "$word" in
                    '--tag') pending='tag' ;;
                    '--model'|'-m') pending='model' ;;
                    '--effort') pending='effort' ;;
                    'run') (( args )) || cstate=1 ;;
                    'config') (( args )) || cstate=2 ;;
                    'doctor') (( args )) || cstate=4 ;;
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            1)
                case "$word" in
                    '--max-turns') pending='max-turns' ;;
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            2)
                case "$word" in
                    'get') (( args )) || cstate=3 ;;
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            3)
                case "$word" in
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
            4)
                case "$word" in
                    -*) ;;
                    *) args=1 ;;
                esac
                ;;
        esac
    done
    if [[ -n $pending ]]; then
        case "$cstate:$pending" in
            '0:effort') compadd -- 'low' 'high'; return ;;
        esac
        _files
        return
    fi
    if (( ended )); then
        _files
        return
    fi
    if [[ $cur == -* ]]; then
        case "$cstate" in
            0) candidates=('--verbose:Print more detail' '-v:Print more detail' '--json:Emit JSON' '--tag:Attach a tag' '--model:Model to use' '-m:Model to use' '--effort:Reasoning effort') ;;
            1) candidates=('--max-turns:Turn limit' '--verbose:Print more detail' '-v:Print more detail') ;;
            2) candidates=('--verbose:Print more detail' '-v:Print more detail') ;;
            3) candidates=('--verbose:Print more detail' '-v:Print more detail') ;;
            4) candidates=('--verbose:Print more detail' '-v:Print more detail') ;;
        esac
        (( ${#candidates} )) && _describe -t options 'option' candidates
        return
    fi
    if (( args == 0 )); then
        case "$cstate" in
            0) candidates=('run:Run one prompt' 'config:Read settings' 'doctor:Check the install'\''s health'); _describe -t commands 'command' candidates; return ;;
            2) candidates=('get:Print one setting'); _describe -t commands 'command' candidates; return ;;
        esac
    fi
    _files
}

if [[ $funcstack[1] == _candy_code ]]; then
    _candy_code "$@"
else
    compdef _candy_code 'candy-code'
fi
