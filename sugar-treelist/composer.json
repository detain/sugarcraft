{
    "name": "sugarcraft/sugar-treelist",
    "description": "Tree-list view component for terminal UIs in PHP \u2014 customizable prefix/suffix rendering, whitespace-faithful line wrapping, cursor navigation, live filtering, and per-row delta repaint. Primary design source: charmbracelet/bubbles/list; naming and tree-gutter context: treilik/bubblelister.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "list",
        "tree",
        "bubble",
        "bubblelister",
        "charmbracelet",
        "bubbles",
        "treelist",
        "terminal",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-treelist",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-treelist/issues",
        "source": "https://github.com/sugarcraft/sugar-treelist",
        "docs": "https://sugarcraft.github.io/lib/sugar-treelist.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-fuzzy": "dev-master",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\TreeList\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\TreeList\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
