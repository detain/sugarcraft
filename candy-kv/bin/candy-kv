#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CandyKv CLI — charmbracelet/skate equivalent.
 *
 * Usage:
 *   candy-kv set <key> [value] [--ttl SECONDS]  Set a key (reads from stdin if no value)
 *   candy-kv get <key>                         Get a value (suggests typo on miss)
 *   candy-kv list [-k|-v] [-r] [-d DELIM] [pattern]  List entries
 *   candy-kv delete <key>                       Delete a key (supports glob)
 *   candy-kv list-dbs                          List all databases
 *   candy-kv import <format> <path>           Import from JSON/YAML file
 *   candy-kv export <format> [db] [pattern]    Export to JSON/YAML
 *
 * Database suffix: key@dbname
 *
 * Formats: json, yaml (or yml)
 * Path '-' or '/dev/stdin' reads from standard input for import.
 */
namespace SugarCraft\Kv;

(static function () {
    // Guard shape ported from candy-code/candy-top (DST-1, measured on PHP
    // 8.3.6): when `php candy-kv.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Two identities cover the two phar
    // shapes: the stub names itself in __FILE__, and a require-from-inside
    // names the archive in Phar::running(). Both are addressed the only way
    // that works, as a phar:// URI. When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-kv: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Kv\Cli\ArgParser;
use SugarCraft\Kv\Cli\ImportCommand;
use SugarCraft\Kv\Cli\ExportCommand;
use SugarCraft\Kv\Lang;
use SugarCraft\Kv\Store;
use SugarCraft\Kv\Support\Version;

$bin = basename($argv[0]);

if ($argc < 2) {
    help($bin);
    exit(0);
}

// Answered BEFORE the Store is constructed: opening the store mkdirs the
// data directory, and a diagnostic flag must not touch the filesystem.
if (($argv[1] ?? '') === '--version') {
    fwrite(STDOUT, Version::line());
    exit(0);
}

$store = new Store();
$cmd = $argv[1];

// ArgParser refuses malformed option values (e.g. --ttl=soon) with an
// InvalidArgumentException; usage errors exit 2, distinct from runtime
// failures (1) and missing keys (get/delete exit 1).
try {
    run($store, $cmd, $argv, $bin);
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, 'candy-kv: ' . $e->getMessage() . "\n");
    exit(2);
}

exit(0);

function run(Store $store, string $cmd, array $argv, string $bin): void
{
    switch ($cmd) {
    case 'set':
        $opts = ArgParser::set($argv, 2);
        if ($opts['key'] === null) {
            fwrite(STDERR, Lang::t('cli.usage_set', ['bin' => $bin]) . "\n");
            exit(1);
        }
        // Read value from stdin if not provided as argument
        $value = $opts['value'];
        if ($value === null) {
            $value = stream_get_contents(STDIN);
            if ($value === false) {
                $value = '';
            }
        }
        $store->set($opts['key'], $value, false, $opts['ttl']);
        break;

    case 'get':
        if (\count($argv) < 3) {
            fwrite(STDERR, Lang::t('cli.usage_get', ['bin' => $bin]) . "\n");
            exit(1);
        }
        // get() is exact-key by design; glob patterns belong to list.
        if (\strpbrk($argv[2], '*?') !== false) {
            fwrite(STDERR, Lang::t('cli.pattern_not_supported', ['bin' => $bin]) . "\n");
            exit(2);
        }
        // get() already emits any "did you mean" typo suggestion to stderr on a
        // miss; branch on entry existence so a truly-missing key exits 1 while an
        // existing key that holds an empty value still exits 0.
        $val = $store->get($argv[2]);
        if ($val === '' && $store->entry($argv[2]) === null) {
            exit(1);
        }
        echo $val;
        break;

    case 'list':
        $opts = ArgParser::list($argv, 2);
        $delim = Store::sanitizeForTty($opts['delimiter']);
        foreach ($store->list($opts['pattern'], null, $opts['reverse'], $opts['mode'], $opts['delimiter']) as $item) {
            if ($item instanceof Entry) {
                $key = Store::sanitizeForTty($item->key);
                $val = Store::sanitizeForTty($item->rawValue());
                echo "{$key}{$delim}{$val}\n";
            } else {
                // keys-only or values-only mode: sanitize the yielded string
                echo Store::sanitizeForTty((string) $item) . "\n";
            }
        }
        break;

    case 'delete':
        if (\count($argv) < 3) {
            fwrite(STDERR, Lang::t('cli.usage_delete', ['bin' => $bin]) . "\n");
            exit(1);
        }
        $n = $store->delete($argv[2]);
        if ($n === 0) {
            fwrite(STDERR, Lang::t('cli.deleted_none', ['key' => $argv[2]]) . "\n");
            exit(1);
        }
        echo Lang::t('cli.deleted_n', ['count' => $n]) . "\n";
        break;

    case 'list-dbs':
        foreach ($store->listDatabases() as $db) {
            echo "{$db}\n";
        }
        break;

    case 'import':
        $opts = ArgParser::import($argv, 2);
        if ($opts['format'] === null || $opts['path'] === null) {
            fwrite(STDERR, Lang::t('cli.usage_import', ['bin' => $bin]) . "\n");
            exit(1);
        }
        $exitCode = (new ImportCommand($store))->run(
            $opts['format'],
            $opts['path'],
            $opts['atomic'],
        );
        exit($exitCode);

    case 'export':
        $opts = ArgParser::export($argv, 2);
        if ($opts['format'] === null) {
            fwrite(STDERR, Lang::t('cli.usage_export', ['bin' => $bin]) . "\n");
            exit(1);
        }
        $exitCode = (new ExportCommand($store))->run(
            $opts['format'],
            $opts['db'],
            $opts['pattern'],
        );
        exit($exitCode);

    case '--help':
    case '-h':
    case 'help':
        help($bin);
        break;

    default:
        fwrite(STDERR, Lang::t('cli.unknown_command', ['cmd' => $cmd]) . "\n");
        help($bin);
        exit(1);
    }
}

function help(string $bin): void
{
    echo <<<HELP
CandyKv — personal key/value store

Usage:
  {$bin} set <key> [value] [--ttl SECONDS]
                                  Set a key (reads stdin if no value)
  {$bin} get <key>                Get a value (suggests typo on miss)
  {$bin} list [-k|-v] [-r] [-d DELIM] [pattern]
                                  List entries (default: keys+values)
  {$bin} delete <key>             Delete a key (glob patterns supported)
  {$bin} list-dbs                 List all databases
  {$bin} import <format> <path>   Import entries (json|yaml|yml, path=- for stdin)
  {$bin} export <format> [db] [pattern]
                                  Export entries (json|yaml|yml)
  {$bin} --help                   Show this help
  {$bin} --version                Print the version

Options:
  --ttl SECONDS                   Set a TTL (expiry in seconds) for the key.
  --ttl=SECONDS                   Same as above; both spellings accepted.
  -d DELIM, -dDELIM               Output delimiter for list (default: tab).
  --no-atomic                     Disable atomic transaction for import.

Patterns:
  *  matches any characters
  ?  matches a single character
  Patterns apply to list and delete; get is exact-key.

Database suffix:
  Use key@dbname to target a specific database.
  E.g. {$bin} get token@passwords

Import/Export:
  JSON and YAML formats supported.
  Use path '-' to read import data from STDIN.

HELP;
}
