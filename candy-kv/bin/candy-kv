#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CandyKv CLI — charmbracelet/skate equivalent.
 *
 * Usage:
 *   candy-kv set <key> [value] [--ttl SECONDS] [--binary|--text]
 *   candy-kv get <key> [--sanitize]
 *   candy-kv list [-k|-v] [-r] [-d DELIM] [pattern]
 *   candy-kv delete <key> [--dry-run]
 *   candy-kv list-dbs
 *   candy-kv prune [--db NAME] [--all]
 *   candy-kv import <format> <path> [--no-atomic] [--if-exists=MODE]
 *   candy-kv export <format> [db] [pattern]
 *   candy-kv --help | --version
 *
 * See the help() output below (or `candy-kv help`) for the full contract:
 * exit codes, output discipline, and option details live there.
 */
namespace SugarCraft\Kv;

(static function () {
    // Guard shape measured on PHP 8.3.6: when `php candy-kv.phar` runs, THIS
    // file is the archive's stub and the process is NOT inside the archive —
    // Phar::running() answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Three identities cover the three
    // phar shapes: the stub names itself in __FILE__, a require-from-inside
    // names the archive in Phar::running(), and a RENAMED download — the
    // README quick start's `wget … -O candy-kv` — hands PHP an ordinary
    // script whose bytes seal an archive, invisible to both doors above
    // because PHP's phar:// layer is extension-gated (is_file of a phar://
    // URI onto the bare name measures false even in stub context, measured
    // on 8.3). Phar::mapPhar() is the oracle for that third shape: it loads
    // the archive sealed inside the running script under the build's alias
    // (tools/build-phar.php pairs with the literal below), and throws
    // PharException on every UNSEALED script — a composer checkout's own bin
    // included — so no pre-gate is needed and the filesystem candidates
    // stand untouched there. When an archive identity exists, the archive's
    // own vendor is the ONLY root — a stray vendor beside (or above) a
    // downloaded phar must never boot the app with code from outside the
    // frozen archive, renamed or not.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $running = \Phar::running(false);
    $archive = $running !== ''
        ? 'phar://' . $running
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive === '') {
        try {
            \Phar::mapPhar('candy-kv.phar');
            $archive = 'phar://candy-kv.phar';
        } catch (\PharException) {
            // Not a sealed script — the filesystem candidates above stand.
        }
    }
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-kv: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\I18n\T;
use SugarCraft\Kv\Cli\ArgParser;
use SugarCraft\Kv\Cli\ImportCommand;
use SugarCraft\Kv\Cli\ExportCommand;
use SugarCraft\Kv\Lang;
use SugarCraft\Kv\Store;
use SugarCraft\Kv\Support\Version;

// Locale wiring: honour LC_ALL/LC_MESSAGES/LANG like every translated lib.
// Translated surface = diagnostics + success lines. By design, --help stays
// English (option grammar mirrors the flag spellings) and ArgParser /
// importer parse errors are English — see README.
T::setLocale(T::detect());

$bin = Store::sanitizeForTty(basename($argv[0]));

if ($argc < 2) {
    help($bin);
    exit(0);
}

// Answered BEFORE the Store is constructed: construction is lazy (no mkdir,
// no file opens until the first write), but a diagnostic flag must not need
// a store object at all. Its surplus tokens still face the parser: the
// exit-code contract refuses unknown options and extra positionals with 2,
// and --version is no exception. Caught locally so the refusal stays
// store-free like the success path.
if (($argv[1] ?? '') === '--version') {
    try {
        ArgParser::noArguments($argv, 2, '--version');
    } catch (\InvalidArgumentException $e) {
        fwrite(STDERR, 'candy-kv: ' . Store::sanitizeForTty($e->getMessage()) . "\n");
        exit(2);
    }
    fwrite(STDOUT, Version::line());
    exit(0);
}

// Same purity law for the help verbs, and for commands we will not run at
// all: an unknown command is a usage error, not a reason to create state.
switch ($argv[1]) {
    case '--help':
    case '-h':
    case 'help':
        help($bin);
        exit(0);
}
if (!in_array($argv[1], ['set', 'get', 'list', 'delete', 'list-dbs', 'prune', 'import', 'export'], true)) {
    fwrite(STDERR, Lang::t('cli.unknown_command', ['cmd' => Store::sanitizeForTty($argv[1])]) . "\n");
    help($bin);
    exit(2);
}

$store = new Store();
$cmd = $argv[1];

// Exit-code contract:
//   2  usage error — bad/missing flag or argument, unknown command
//      (ArgParser + the missing-key guards below throw/fold into this)
//   1  the key/pattern found no match, or a runtime failure
//   0  success
try {
    run($store, $cmd, $argv, $bin);
} catch (\InvalidArgumentException $e) {
    // kv-004 sanitize-on-egress: messages interpolate attacker-chosen argv
    // and store bytes (entry names, keys, paths) — nothing raw leaves here.
    fwrite(STDERR, 'candy-kv: ' . Store::sanitizeForTty($e->getMessage()) . "\n");
    exit(2);
} catch (\Throwable $e) {
    fwrite(STDERR, 'candy-kv: error: ' . Store::sanitizeForTty($e->getMessage()) . "\n");
    exit(1);
}

exit(0);

/**
 * Read the STDIN payload for `set`, refusing to launder a failed read as empty.
 *
 * kv-016: the old shape mapped every read failure to '' and wrote that empty
 * secret over whatever the key held — a success line with data loss. PHP
 * surfaces a failing read in two shapes: stream_get_contents() returning
 * false, or (on this CLI, e.g. an EISDIR fd from `< /tmp`) a stream-layer
 * diagnostic plus a truncated ''. The handler below promotes diagnostics to
 * exceptions so BOTH shapes land in the same refusal, mirroring
 * ImportCommand's "Failed to read from STDIN." exit-1 contract. A clean EOF
 * still yields '' — storing an empty value stays the caller's prerogative.
 */
function stdinOrFail(): string
{
    \set_error_handler(static function (int $severity, string $message): bool {
        throw new \ErrorException($message, 0, $severity);
    });

    try {
        $value = \stream_get_contents(STDIN);
    } catch (\ErrorException) {
        $value = false; // a stream-layer diagnostic IS a failed read
    } finally {
        \restore_error_handler();
    }

    if ($value === false) {
        throw new \RuntimeException('Failed to read from STDIN.');
    }

    return $value;
}

function run(Store $store, string $cmd, array $argv, string $bin): void
{
    switch ($cmd) {
    case 'set':
        $opts = ArgParser::set($argv, 2);
        if ($opts['key'] === null || $opts['key'] === '') {
            usage($bin, 'cli.usage_set');
        }
        // Read value from stdin if not provided as argument
        $value = $opts['value'];
        if ($value === null) {
            $value = stdinOrFail();
        }
        // Binary handling: the column is TEXT, so NUL bytes get truncated at
        // the C string end and invalid UTF-8 breaks the whole-store JSON
        // export. Unless the caller forced --binary/--text, auto-detect both
        // shapes and store base64 with the binary flag set.
        if ($opts['binary'] === false && \str_contains($value, "\0")) {
            // kv-008: --text FORCES the unreadable shape — SQLite stores the
            // cell, but every C-string reader truncates at the first NUL, so
            // `get` would silently print a prefix of what was set. Refuse at
            // admission; the auto-detect path already routes such values to
            // base64, and --binary is the explicit door for them.
            throw new \InvalidArgumentException(
                'A value containing NUL bytes cannot be stored as text (--text): readers truncate at the first NUL. Use --binary.'
            );
        }
        $binary = $opts['binary'] ?? (str_contains($value, "\0") || !mb_check_encoding($value, 'UTF-8'));
        $store->set($opts['key'], $value, $binary, $opts['ttl']);
        break;

    case 'get':
        $opts = ArgParser::get($argv, 2);
        if ($opts['key'] === null) {
            usage($bin, 'cli.usage_get');
        }
        // get() is exact-key by design; glob patterns belong to list.
        // kv-043: the gate judges the SPELLING, not any raw glob byte.
        // A `*`/`?` escaped as `\*`/`\?` is exact-key intent by definition
        // (the pattern engine's own unescape law), so such keys stayed
        // creatable and listable yet unfetchable. Raw unescaped glob bytes
        // remain the pattern refusal — wildcards never mean get.
        $key = $opts['key'];
        if (Store::hasRawGlob($key)) {
            fwrite(STDERR, Lang::t('cli.pattern_not_supported', ['bin' => $bin]) . "\n");
            exit(2);
        }
        // Single query; null = miss (an existing key holding '' is a hit).
        // The decoded spelling is tried first, then the literal argv bytes:
        // a key stored by the pre-kv-043 habit of typing `set 'ra\*wt'`
        // (backslash and all) keeps answering to its own name.
        $decoded = Store::unescapeGlobKey($key);
        $entry = $store->entry($decoded);
        if ($entry === null && $decoded !== $key) {
            $entry = $store->entry($key);
        }
        if ($entry === null) {
            // Suggestions are CLI policy. Everything echoed here may be
            // attacker-chosen (typo key, poisoned store keys) → sanitize.
            $suggestion = $store->suggestionFor($decoded);
            $line = $suggestion !== null
                ? Lang::t('store.did_you_mean', ['key' => Store::sanitizeForTty($suggestion)])
                : Lang::t('cli.key_not_found', ['key' => Store::sanitizeForTty($key)]);
            fwrite(STDERR, $line . "\n");
            exit(1);
        }
        // Byte-exact by contract: print stored bytes untouched (no trailing
        // newline added). --sanitize opts INTO the single-line scrub.
        $raw = $entry->rawValue();
        echo $opts['sanitize'] ? Store::sanitizeForTty($raw) : $raw;
        // G10 default leg (candy-kv-069): an interactive TTY gets told a
        // scrub exists, but only when a scrub WOULD change bytes — the
        // predicate is sanitizeForTty itself, so it cannot drift from what
        // the scrub actually strips. stdout stays byte-exact either way;
        // the hint rides stderr so pipes of stdout keep their pure payload.
        if (!$opts['sanitize'] && \stream_isatty(STDOUT) && Store::sanitizeForTty($raw) !== $raw) {
            fwrite(STDERR, "\n(value contains control bytes — use --sanitize)\n");
        }
        break;

    case 'list':
        $opts = ArgParser::list($argv, 2);
        // The delimiter is CONTROLLED by the operator (awk -F contract), so
        // it prints byte-untouched; only the STORED key/value columns get
        // the escape-smuggling scrub. The <binary N bytes> placeholder is
        // driven by the entry's binary FLAG, so 'values' must iterate Entry
        // mode as well: the mode-'values' string yield carries no flag, and
        // a UTF-8-decodable binary payload used to print in full there while
        // plain 'list' placeholdered it — one documented promise
        // ("Binary values print as <binary N bytes>") broken for one of the
        // two modes it covers. 'keys' keeps the cheap string yield; values
        // are never decoded for it, so a corrupt-base64 binary row cannot
        // throw on a key listing.
        $delim = $opts['delimiter'];
        $mode = $opts['mode'];
        foreach ($store->list($opts['pattern'], null, $opts['reverse'], $mode === 'keys' ? 'keys' : 'all', $opts['delimiter']) as $item) {
            if ($item instanceof Entry) {
                $key = Store::sanitizeForTty($item->key);
                $bytes = $item->rawValue();
                $val = $item->binary
                    ? '<binary ' . strlen($bytes) . ' bytes>'
                    : Store::sanitizeForTty($bytes);
                echo $mode === 'values' ? "{$val}\n" : "{$key}{$delim}{$val}\n";
            } else {
                // keys-only mode: sanitize the yielded key string
                echo Store::sanitizeForTty((string) $item) . "\n";
            }
        }
        break;

    case 'delete':
        $opts = ArgParser::delete($argv, 2);
        if ($opts['key'] === null) {
            usage($bin, 'cli.usage_delete');
        }
        if ($opts['dryRun']) {
            $n = countMatches($store, $opts['key']);
            if ($n === 0) {
                fwrite(STDERR, Lang::t('cli.deleted_none', ['key' => Store::sanitizeForTty($opts['key'])]) . "\n");
                exit(1);
            }
            echo Lang::t($n === 1 ? 'cli.would_delete_one' : 'cli.would_delete_n', ['count' => $n]) . "\n";
            break;
        }
        $n = $store->delete($opts['key']);
        if ($n === 0) {
            fwrite(STDERR, Lang::t('cli.deleted_none', ['key' => Store::sanitizeForTty($opts['key'])]) . "\n");
            exit(1);
        }
        echo Lang::t($n === 1 ? 'cli.deleted_one' : 'cli.deleted_n', ['count' => $n]) . "\n";
        break;

    case 'prune':
        $opts = ArgParser::prune($argv, 2);
        if ($opts['all']) {
            // kv-085: --all walks the same listDatabases() truth list-dbs
            // shows. Databases with nothing expired stay silent — a
            // survivor-counted line per healthy file is noise; the total
            // is what the operator came for.
            $total = 0;
            foreach ($store->listDatabases() as $dbName) {
                $n = $store->pruneDatabase($dbName);
                $total += $n;
                if ($n > 0) {
                    echo Lang::t($n === 1 ? 'cli.pruned_one' : 'cli.pruned_n', ['count' => $n]) . ' (' . Store::sanitizeForTty($dbName) . ")\n";
                }
            }
            if ($total === 0) {
                echo Lang::t('cli.pruned_none') . "\n";
            }
            break;
        }
        $db = $opts['db'];
        if ($db === null) {
            $n = $store->pruneExpired();
        } elseif (!\in_array($db, $store->listDatabases(), true) && !$store->isReservedDatabase($db)) {
            // The named db simply is not there. Answering 'Nothing to
            // prune' would launder a typo into success, so this refuses
            // (exit 1, the miss class) and names what IS present. A
            // reserved name skips this door: it exists behind the listing,
            // and pruneDatabase() gives the informative reserved refusal.
            $present = $store->listDatabases();
            fwrite(STDERR, 'Database ' . Store::sanitizeForTty($db) . ' does not exist.'
                . ($present === [] ? '' : ' Known: ' . Store::sanitizeForTty(implode(', ', $present))) . "\n");
            exit(1);
        } else {
            $n = $store->pruneDatabase($db);
        }
        if ($n > 0) {
            $suffix = $db !== null ? ' (' . Store::sanitizeForTty($db) . ')' : '';
            echo Lang::t($n === 1 ? 'cli.pruned_one' : 'cli.pruned_n', ['count' => $n]) . $suffix . "\n";
        } else {
            echo Lang::t('cli.pruned_none') . "\n";
        }
        break;

    case 'list-dbs':
        // Takes no arguments: junk tokens must fold into the exit-2 usage
        // contract, not print a happy list around them.
        ArgParser::noArguments($argv, 2, 'list-dbs');
        foreach ($store->listDatabases() as $db) {
            echo "{$db}\n";
        }
        break;

    case 'import':
        $opts = ArgParser::import($argv, 2);
        if ($opts['format'] === null || $opts['path'] === null) {
            usage($bin, 'cli.usage_import');
        }
        $exitCode = (new ImportCommand($store))->run(
            $opts['format'],
            $opts['path'],
            $opts['atomic'],
            $opts['ifExists'],
        );
        exit($exitCode);

    case 'export':
        $opts = ArgParser::export($argv, 2);
        if ($opts['format'] === null) {
            usage($bin, 'cli.usage_export');
        }
        $exitCode = (new ExportCommand($store))->run(
            $opts['format'],
            $opts['db'],
            $opts['pattern'],
        );
        exit($exitCode);
    }
}

/**
 * How many live entries a delete argument would touch (no writes).
 * Mirrors Store::delete's routing: glob → pattern list, else exact key.
 * The split goes through Store::splitKey so escaped and leading-@
 * spellings route identically in both modes; a raw strrpos picked the
 * wrong separator (or none) whenever '@' was escaped or led the key,
 * under-reporting exactly the shapes delete still honours.
 */
function countMatches(Store $store, string $key): int
{
    [$dbName, $entryKey] = Store::splitKey($key, $store->defaultDatabase());

    if (strpbrk($entryKey, '*?') !== false) {
        return iterator_count($store->list($entryKey, $dbName, false, 'keys'));
    }

    return $store->entry($key) === null ? 0 : 1;
}

/**
 * Emit a localized usage line and exit with the usage-error code.
 */
function usage(string $bin, string $messageKey): never
{
    fwrite(STDERR, Lang::t($messageKey, ['bin' => $bin]) . "\n");
    exit(2);
}

function help(string $bin): void
{
    echo <<<HELP
    CandyKv — personal key/value store

    Usage:
      {$bin} set <key> [value] [--ttl SECONDS] [--binary|--text]
                                      Set a key (reads stdin if no value)
      {$bin} get <key> [--sanitize]    Get a value (byte-exact by default)
      {$bin} list [-k|-v] [-r] [-d DELIM] [pattern]
                                      List entries (default: keys+values)
      {$bin} delete <key> [--dry-run]  Delete a key or glob pattern
      {$bin} list-dbs                  List all databases
      {$bin} prune [--db NAME|--all]
                                      Remove expired entries: the default db,
                                      one named db, or every db (--all).
      {$bin} import <format> <path> [--no-atomic] [--if-exists=MODE]
                                      Import entries (json|yaml|yml, path=- for stdin)
      {$bin} export <format> [db] [pattern]
                                      Export entries (json|yaml|yml)
      {$bin} --help                    Show this help
      {$bin} --version                 Print the version

    Options:
      --ttl SECONDS | --ttl=SECONDS   Expiry in seconds (1..999999999). Omit
                                      --ttl for a forever entry; --ttl 0 is a
                                      usage error, not "expire immediately".
      --binary | --text               Force how `set` stores the value.
                                      Default: auto-detect — values with NUL
                                      bytes or invalid UTF-8 are stored
                                      base64-encoded with the binary flag.
      --sanitize                      `get`: collapse the value to one
                                      C0-control-free line. Without it, get
                                      prints the exact stored bytes.
      -d DELIM | -dDELIM              `list` column delimiter (default: tab).
                                      Printed untouched — safe for awk -F.
      -k, -v, -r                      `list`: keys-only, values-only, reverse.
      --dry-run                       `delete`: report match count, write
                                      nothing.
      --no-atomic                     `import`: skip the wrapping transaction.
      --if-exists=MODE                `import`: what a key that is already
                                      stored does — replace it (default),
                                      skip it, or refuse the import.
      --db NAME | --db=NAME           `prune`: limit the sweep to one
                                      database instead of the default.
      --all                           `prune`: sweep every database in the
                                      store (the list `list-dbs` shows).
      --                              End option processing; later tokens are
                                      data (`set backup -- --ttl=60` stores
                                      the literal value --ttl=60).

    Exit codes:
      0  success        1  key/pattern missed, or a runtime error
      2  usage error (unknown command, bad or missing arguments)

    Patterns:
      *  matches any characters;  ?  matches one character.
      Patterns apply to list and delete; get is exact-key.
      Matching is case-sensitive and character-wise; a literal * or ? can be
      introduced with a backslash. get answers to that same spelling:
      {$bin} get 'ra\*wt'  reads the key  ra*wt.

    Database suffix:
      Use key@dbname to target a specific database.
      E.g. {$bin} get token@passwords
      A literal @ in a key is spelled \\@ (never "a@b@c").

    Output discipline:
      get    exact stored bytes, no added newline.
      list   one row per line; stored columns are control-scrubbed for the
             terminal, the -d delimiter is not. Binary values print as
             <binary N bytes>.

    Language:
      Diagnostics and success lines follow LC_ALL/LC_MESSAGES/LANG. Help and
      parse errors stay English by design.

    HELP;
}
