#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    foreach (['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
        $path = str_starts_with($candidate, '/') ? $candidate : __DIR__ . '/../' . $candidate;
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    // 2, not 1, for the same reason every other pre-flight failure below is a
    // 2: nothing was attempted and a retry cannot help — the install is
    // incomplete. This is the ONE exit that cannot honour the
    // `--output-format json` contract, and deliberately so: the document shape
    // is owned by NonInteractive::emitErrorDocument(), and the autoloader that
    // would load that class is exactly what is missing. Hand-rolling a second
    // JSON document here to cover it would create the drift that centralising
    // the shape exists to prevent, over a case a `| jq` consumer can only hit
    // by running the binary out of a broken checkout. Documented in README.md.
    fwrite(STDERR, "sugarcrush: cannot find composer autoload.php\n");
    exit(2);
})();

use SugarCraft\Core\Program;
use SugarCraft\Crush\Chat;
use SugarCraft\Crush\Cli\ArgvParser;
use SugarCraft\Crush\Cli\Bootstrap;
use SugarCraft\Crush\Cli\Help;
use SugarCraft\Crush\Cli\NonInteractive;
use SugarCraft\Crush\Cli\PermissionConfigException;
use SugarCraft\Crush\Cli\Subcommands;

// Parse argv first and dispatch before ever touching Program/Bootstrap::chat()
// — `--help` and `-p`/`run "<prompt>"` must never attach to the TTY or enter
// the alt-screen (crush_feat.md section 2, Recommendation 1).
$args = ArgvParser::parse($argv);

if ($args->help) {
    fwrite(STDOUT, Help::screen());
    exit(0);
}

// --version, dispatched exactly like --help above and for the same reason: it
// is the first thing a packaging script or a bug report runs, so it has to
// answer on a machine with no provider, no config and no TTY — never by
// entering the alt-screen (crush_code.md Phase 4 item 3). Deliberately NOT
// routed through NonInteractive: like --help this is plain text at exit 0, not
// a one-shot RESULT, so it has no --output-format json document to emit.
if ($args->version) {
    fwrite(STDOUT, Help::version());
    exit(0);
}

// A prompt option handed a flag (`sugarcrush -p --verbose`) used to run a
// one-shot turn whose prompt was the literal text "--verbose" — follow-up #48.
// Checked BEFORE the unknown-flag guard below because both fire on that same
// invocation (the unconsumed flag also lands in $unknownFlags) and this is the
// sharper of the two messages: it names the option that went wrong rather than
// blaming the token that was only ever the symptom.
//
// This branch also carries the unsupported-`--output-format` error (Phase 4
// item 6). Its hint comes from $args->usageHint rather than being written here:
// there are now two error causes with two different remedies, and the
// hard-coded "--prompt=<text>" line that used to sit here was printed under
// both. Note that $args->outputFormat is the REJECTED value in that case, so
// the failure below renders as text — which is the only honest answer when the
// requested rendering is one nothing implements, and means STDOUT IS EMPTY on
// that one path. That is the second of the two exceptions README.md's
// "exactly one JSON object on stdout" contract names (the other being a
// checkout with no vendor/autoload.php); the contract's own README sentence
// used to list `--output-format` among the causes it COVERS, which was false
// for exactly this reason. Scope: the invalid VALUE is the exception, not the
// flag — a valid `--output-format json` beside any other usage error still
// emits the document, because $args->outputFormat is then `json`.
if ($args->usageError !== null) {
    exit(NonInteractive::failUsage(
        $args->usageError,
        $args->outputFormat,
        $args->usageHint,
    ));
}

// An unrecognised flag used to be dropped by the parser and fall through to
// Program::run() below, so every typo (`--version` among them, before the
// block above made it a real flag) opened the blocking full-screen TUI and
// spewed raw ANSI instead of failing — the same bug class as the fixed
// "`--help` opens the TUI" (crush_code.md Phase 0 item 3). Checked after
// --help/--version so those still print rather than being second-guessed.
// Exit 2 = nothing was attempted and a retry cannot help, which is the same
// meaning NonInteractive gives it; 1 stays reserved for "ran and failed".
//
// Reported through NonInteractive::failUsage() rather than fwrite+exit here:
// this branch is one of the exit-2 causes the README's JSON contract covers
// (unrecognized flag, `-p` handed a flag, `--root` naming no directory, an
// unusable permission policy, an unusable explicitly-selected provider, and a
// missing vendor/autoload.php), and it used to leave stdout completely empty under
// `--output-format json`, which is the empty pipe that contract promises never
// happens.
if ($args->unknownFlags !== []) {
    exit(NonInteractive::failUsage(
        'sugarcrush: unrecognized option' . (count($args->unknownFlags) === 1 ? '' : 's') . ': '
        . implode(', ', $args->unknownFlags),
        $args->outputFormat,
        'Try `sugarcrush --help` for the list of supported options.',
    ));
}

// A --root that names no directory is a usage error too, and for a sharper
// reason than a typo: the root becomes App::$root, then every HookContext's
// projectRoot, then the proc_open() cwd of every ScriptHook. Checked before
// either dispatch below so one-shot and TUI runs fail identically. Exit 2 =
// usage error (crush_code.md Phase 0 item 6).
$rootError = ArgvParser::rootError($args);
if ($rootError !== null) {
    exit(NonInteractive::failUsage($rootError, $args->outputFormat));
}

// `--config <path>` naming no readable file is the same class of usage error,
// and for the same reason: that file carries the permission mode, the
// permission rules and the trustedProjectHooks list, so falling through to
// discovery would run the DEFAULT policy while the operator believed the named
// one was in force. Exit 2 (crush_code.md Phase 4 item 6).
$configError = ArgvParser::configError($args);
if ($configError !== null) {
    exit(NonInteractive::failUsage($configError, $args->outputFormat));
}

// Registered once, AFTER the check above proved the file readable and BEFORE
// either dispatch, so the one-shot path and the TUI path read the same config.
// A null (no --config given) leaves Bootstrap's own discovery in place.
Bootstrap::useConfigPath($args->configPath);

// Registered at the same seam and for the same reason: process-wide, before
// EITHER dispatch, so all three paths honour them. `-p`/`run` enters at
// NonInteractive::run() -> Bootstrap::backend()/backendFor() and never goes
// through Bootstrap::chat(), so a flag threaded into chat() alone would leave
// `sugarcrush --permission-mode plan -p "..."` running under the config's mode
// while appearing to have been told otherwise.
//
// --permission-mode is registered RAW. Bootstrap::permissionGate() validates it
// with the same permissionModeFrom() that judges the env var and the config
// key, which throws PermissionConfigException — caught by the try/catch below,
// which is why validation must happen inside the dispatch and not here.
Bootstrap::useModel($args->model);
Bootstrap::usePermissionMode($args->permissionMode);

// The real subcommands — `mcp list`, `session list|delete`, `models`, `doctor`
// and `completion bash|zsh|fish` (crush_code.md Phase 4 item 6). Dispatched
// HERE, in the same pre-flight place --help and --version are answered and
// BEFORE Program/NonInteractive, because every one of them is a question about
// the INSTALL rather than a turn of conversation: they have to answer on a
// machine with no provider, no API key and no TTY. A subcommand that fell
// through to Program::run() below would attach to the terminal and enter the
// alt-screen — the "`--help` opens the TUI" bug (crush_code.md Phase 0 item 3)
// reopened by a new verb. `doctor` is the sharpest case: it diagnoses an
// install that may be broken, so it must not require the thing it is
// diagnosing.
//
// AFTER the four pre-flight checks above rather than before them, and each
// placement is load-bearing: an unknown flag beside a subcommand is still a
// usage error, and `--config` must already be validated AND registered by
// Bootstrap::useConfigPath() above, or `sugarcrush --config x.json doctor`
// would report the policy from the DISCOVERED config while the operator
// believed it was reading the named one. The dispatch itself sits INSIDE the
// try/catch below — see the note there.
//
// A permission policy that is configured but unusable stops the launch rather
// than falling back to the permissive default — see
// Bootstrap::permissionGate(). Caught here, around BOTH dispatch paths, so a
// stray comma in ~/.sugar-crush/config.json reports like every other "nothing
// ran and a retry cannot help" condition (exit 2, and the JSON error document
// under --output-format json) instead of as a PHP fatal over the terminal.
//
// The body below is deliberately left at column 0 rather than indented into
// this block: the diff should show the two lines that were added, not every
// line of the dispatch it now wraps.
try {

// The subcommand dispatch (see the block above for why it happens here at all)
// sits INSIDE this try, and it took a measurement to get right. A
// ~/.sugar-crush/config.json that is not parseable JSON makes
// Bootstrap::permissionConfig() throw, and `mcp list` reaches it through
// projectMcpIsTrusted() — so with the dispatch outside this block that
// invocation died as an uncaught PHP fatal with a stack trace over the
// terminal, rc 255 (MEASURED, on a HOME whose config.json was `{ this is not
// json`). Inside, it is the same exit 2 plus JSON error document every other
// unusable-policy path produces.
//
// It does NOT cost `doctor` its answer, which was the reason the dispatch was
// outside to begin with: every probe in Subcommands::doctorProbes() catches its
// own throws, so `doctor` still prints its report and exits 1 on an install
// this catch would otherwise turn into a bare exit 2. Both are asserted in
// Tests\Integration\BinSugarcrushDispatchTest.
if ($args->subcommand !== null) {
    exit(Subcommands::dispatch($args));
}

// Dispatch on "the user asked for one-shot mode", NOT on "a prompt value was
// parsed": a bare `sugarcrush -p` / `--prompt` / `run` has a null prompt, and
// keying off the value sent it into the TUI. NonInteractive::run() already
// owns the "no prompt given" message, so route there rather than repeat it.
if ($args->promptRequested) {
    exit(NonInteractive::run($args, null, $args->outputFormat));
}

// All backend/tool/session-store/memory-store/instruction-loader wiring
// lives in Bootstrap (R19) so it can be exercised by a test without
// shelling out to this script and blocking on Program::run(). See
// Bootstrap's class docblock for the reasoning.
//
// The root Model is Bootstrap::app() — the App pane shell HOSTING the Chat
// that Bootstrap::chat() builds, not the bare Chat (crush_feat.md §5 E7,
// merge branch). This line is what makes the shell reachable at all: the
// menu bar, pane focus, KeyboardHandler's agent-view keys and the session
// tab strip had no production constructor before it. Chat itself is
// unchanged and still runnable standalone.
//
// Options come from Chat::programOptions() so mouse mode (and its
// SUGARCRUSH_DISABLE_MOUSE escape hatch) is decided next to the state that
// uses it — see crush_feat.md section 8 E1. They belong to the hosted
// content model, which is what reads the mouse events.
(new Program(Bootstrap::app($args->root), Chat::programOptions()))->run();

} catch (PermissionConfigException $e) {
    exit(NonInteractive::failUsage(
        'sugarcrush: ' . $e->getMessage(),
        $args->outputFormat,
        'Fix or remove the offending value, then run sugarcrush again.',
    ));
}
