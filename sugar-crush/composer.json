{
    "name": "sugarcraft/sugar-crush",
    "description": "Chat-shell TUI for AI coding assistants \u2014 port of charmbracelet/crush. Pluggable Backend interface (ship your own Anthropic / OpenAI / Ollama / shell-out adapter). Markdown rendering of replies via CandyShine, scrollback viewport via SugarBits, input area via SugarBits TextArea.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "sugarcraft",
        "sugarcrush",
        "crush",
        "ai",
        "llm",
        "chat",
        "tui",
        "anthropic",
        "openai",
        "ollama"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-crush",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-crush/issues",
        "source": "https://github.com/sugarcraft/sugar-crush",
        "docs": "https://sugarcraft.github.io/lib/sugar-crush.html"
    },
    "bin": [
        "bin/sugarcrush"
    ],
    "require": {
        "php": "^8.3",
        "ext-sqlite3": "*",
        "react/promise": "^3.3",
        "react/http": "^1.11",
        "react/socket": "^1.16",
        "ratchet/rfc6455": "^0.4",
        "openai-php/client": "^0.10",
        "guzzlehttp/guzzle": "^7.12.1",
        "aws/aws-sdk-php": "^3.300",
        "google/cloud-ai-platform": "^1.0",
        "symfony/yaml": "^7.4",
        "sugarcraft/candy-core": "dev-master",
        "sugarcraft/candy-forms": "dev-master",
        "sugarcraft/candy-sprinkles": "dev-master",
        "sugarcraft/candy-shine": "dev-master",
        "sugarcraft/candy-fuzzy": "dev-master",
        "sugarcraft/sugar-veil": "dev-master",
        "sugarcraft/sugar-mcp": "dev-master",
        "sugarcraft/sugar-diff": "dev-master",
        "sugarcraft/sugar-toast": "dev-master",
        "sugarcraft/candy-mosaic": "dev-master",
        "sugarcraft/candy-mouse": "dev-master",
        "sugarcraft/candy-layout": "dev-master",
        "sugarcraft/candy-focus": "@dev",
        "sugarcraft/candy-kit": "@dev",
        "sugarcraft/candy-pty": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "ratchet/pawl": "^0.4"
    },
    "suggest": {
        "ext-curl": "Used by the HTTP-based providers (OpenAI, Anthropic, SGLang, Custom).",
        "ext-pcntl": "Required by `sugarcrush serve`: every turn runs in a forked child, and the blocking fallback would stall every session on the server.",
        "ext-posix": "Required by `sugarcrush serve` (process identity and signals for the forked turn children).",
        "ext-ffi": "Required by `sugarcrush serve`: a forked turn child closes the server's inherited sockets through libc close(2).",
        "sugarcraft/sugar-crush-web": "The browser UI `sugarcrush serve` serves on its own port (Vite + Vue build shipped as a composer package)."
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Crush\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Crush\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
