#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // Guard shape ported from candy-code/candy-top (DST-1, measured on PHP
    // 8.3.6): when `php candy-flappy.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Three identities cover the three
    // phar shapes: the stub names itself in __FILE__, a require-from-inside
    // names the archive in Phar::running(), and a RENAMED suffix-less
    // archive maps itself under its build-time alias (below). All are
    // addressed the only way that works, as a phar:// URI. When an archive
    // identity exists, the archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    // M6 hardening: a bare 'vendor/autoload.php' leg leads the filesystem list,
    // exactly as candy-gifview/bin/candy-gifview spells it, so running the bin
    // by path from a directory whose vendor/ is the only installed one (a
    // monorepo root after a root composer install, before per-lib vendors are
    // refreshed) still boots. With no cwd match the two __DIR__-anchored legs
    // resolve the checkout and composer-installed shapes as before; the
    // archive branch below still drops ALL filesystem legs when a phar is
    // running, so the isolation property is untouched.
    $candidates = ['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    // Phar can be absent entirely (`php -n` drops the shared module, the
    // exact shape found in the field). Absence is exactly the '' non-archive
    // answer this guard already handles — ask before calling.
    $running = class_exists('Phar') ? \Phar::running(false) : '';
    $archive = $running !== ''
        ? 'phar://' . $running
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    // flappy-34 (finding -083): the renamed, suffix-less archive — the
    // composer-install / `wget -O candy-flappy` shape. PHP neither
    // auto-mounts it (the CLI runs it as a plain script, Phar::running()
    // answers '') nor resolves phar://__FILE__ (measured PHP 8.3.6: without
    // a .phar segment the wrapper cannot locate the archive), so every
    // identity above misses and the boot used to die at the refusal below.
    // Phar::mapPhar() DOES find the signature inside the running file and
    // mounts it under its build-time alias — the third identity of a phar.
    // The alias is owned by tools/build-phar.php's fixed-alias `new Phar(…)`
    // call; PharBuildScriptTest pins both sides agree and boots a faithful
    // renamed stub subprocess. A plain source run has no signature to map:
    // the probe fails and lands on the honest refusal below, as before.
    if ($archive === '' && class_exists('Phar')) {
        try {
            if (@\Phar::mapPhar('candy-flappy.phar') !== false
                && is_file('phar://candy-flappy.phar/vendor/autoload.php')) {
                require 'phar://candy-flappy.phar/vendor/autoload.php';
                return;
            }
        } catch (\Throwable) {
            // Not an archive (or the alias drifted): fall through.
        }
    }
    fwrite(STDERR, "candy-flappy: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\MouseMode;
use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Core\Util\ColorProfile;
use SugarCraft\Core\Util\LegacyPaths;
use SugarCraft\Flappy\Game;
use SugarCraft\Flappy\Support\Version;

// Diagnostic flags answer before anything else runs — notably before the
// one-time legacy migration below, which moves directories under $HOME and
// must never be a side effect of asking a version.
// flappy-10 (finding -060): the tagline never said what the game IS beyond a
// clone (positioning contradicted README/composer/MATCHUPS), and --help
// (GAP-08) never revealed how to play. Tagline + one how-to-play line.
$usage = "candy-flappy — a Flappy-Bird-style game for the terminal\n\n"
    . "Usage:\n"
    . "  candy-flappy            Play\n"
    . "  candy-flappy --version  Print the version\n"
    . "  candy-flappy -h, --help Show this help\n"
    . "\n"
    . "space/Enter/up/w flap · r restart · q/Esc quit — needs a 62x21 terminal\n";

$flags = array_slice($argv ?? [], 1);
if (in_array('--version', $flags, true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}
if (in_array('--help', $flags, true) || in_array('-h', $flags, true)) {
    fwrite(STDOUT, $usage);
    exit(0);
}
// M14: the game takes no arguments at all. Anything unrecognised used to be
// ignored while the TUI launched, so a typo'd flag "worked" silently (and a
// CI leg passing --something got an interactive hang instead of an error).
$unknown = array_values(array_diff($flags, ['--version', '--help', '-h']));
if ($unknown !== []) {
    // N3 (review round 2): the echoed argv is untrusted bytes — replace every
    // control character (C0/C1/DEL, incl. ESC sequences) and Unicode "other"
    // before printing it. Category-wise on valid UTF-8 (emoji survive),
    // byte-wise fallback for invalid sequences; both collapse runs to '?'.
    $safe = array_map(
        static function (string $arg): string {
            $clean = preg_replace('/\p{C}+/u', '?', $arg);

            return $clean ?? (string) preg_replace('/[\x00-\x1f\x7f]+/', '?', $arg);
        },
        $unknown
    );
    // flappy-72 (finding -062): one refusal line per bad argument, the
    // minesweeper shape. The old "(s)" shorthand is untranslatable arithmetic
    // (ar/ru/pl dual classes), and listing them on one line forced a reader
    // (or a CI grep) to re-count a joined blob. Each echo keeps the N3
    // sanitiser; the usage block prints once, after the lines.
    foreach ($safe as $line) {
        fwrite(STDERR, "candy-flappy: unknown argument: {$line}\n");
    }
    fwrite(STDERR, "\n" . $usage);
    exit(2);
}

// flappy-35 (finding -084): the frozen-vendor phar bypasses composer
// metadata entirely, and sugar-core's cell-width maths hard-requires intl +
// mbstring — missing extensions used to surface as an undefined-function
// Error mid-first-frame. Name them, exit 2 (invocation error), never 255.
$missing = array_values(array_filter(
    ['intl', 'mbstring'],
    static fn (string $ext): bool => !extension_loaded($ext),
));
if ($missing !== []) {
    fwrite(STDERR, 'candy-flappy: missing required PHP extension(s): ' . implode(', ', $missing) . "\n");
    exit(2);
}

// flappy-01 (finding -001): the framed world writes alt-screen and truecolor
// bytes; a piped or redirected launch used to paint escape-sequence garbage
// into files and pipes. The in-band NoTty refusal cannot help that shape —
// sugar-core's bootstrap may already have emitted alternate-screen enter
// bytes before the first frame (README, Terminal requirements). So the CLI
// answers once, before any Program object and before any side effect (the
// legacy migration below): stdout must be a terminal. The documented force
// rungs of ColorProfile::detect() carry the override — a truthy
// CLICOLOR_FORCE/FORCE_COLOR means "emit escapes anyway" and plays into the
// pipe on purpose. The diagnostic flags answer above, so --version/--help
// stay pipeable.
$forceRung = static function (string $name): bool {
    $value = getenv($name);

    return $value !== false && $value !== '' && $value !== '0' && strtolower($value) !== 'false';
};
if (!stream_isatty(STDOUT) && !$forceRung('CLICOLOR_FORCE') && !$forceRung('FORCE_COLOR')) {
    fwrite(STDERR, "candy-flappy: this game needs an interactive terminal on stdout.\n"
        . "Run it in a terminal window, or set FORCE_COLOR=1 to draw into a pipe on purpose.\n");
    exit(1);
}

// One-time migration of the pre-rename high-score directory (plan_rename.md R4.4).
// Mirrors Game::getDefaultConfigDir()'s base resolution (XDG_CONFIG_HOME, then
// HOME/.config); when neither resolves the migration is skipped silently — Game
// will raise its own fail-closed error when it next needs the path.
$legacyConfigBase = (static function (): string {
    $xdg = getenv('XDG_CONFIG_HOME');
    if ($xdg !== false && $xdg !== '') {
        return $xdg;
    }
    $home = getenv('HOME') ?: ($_SERVER['HOME'] ?? '');

    return $home === '' ? '' : $home . '/.config';
})();
if ($legacyConfigBase !== '') {
    $legacyNotice = LegacyPaths::migrate(
        $legacyConfigBase . '/.honey-flap', // @rename-keep
        $legacyConfigBase . '/.candy-flappy'
    );
    if ($legacyNotice !== null) {
        fwrite(STDERR, "candy-flappy: {$legacyNotice}\n");
    }
}

$profile = ColorProfile::detect(null, STDOUT);

// flappy-66 (finding -039): Game::start() fail-closes with a
// RuntimeException when no config base resolves at all ($HOME and
// $XDG_CONFIG_HOME both absent). That used to surface as a raw 255 trace —
// internals on display, contradicting this bin's own one-line exit-2 shape.
// Catch at the call site; library consumers keep the exception.
try {
    $game = Game::start();
} catch (\RuntimeException $e) {
    fwrite(STDERR, 'candy-flappy: ' . $e->getMessage() . "\n");
    exit(2);
}

$program = new Program(
    $game,
    // flappy-13 (finding -011): one capability profile, probed once, gates
    // both the alt-screen contract and the model's colour posture — the
    // candy-tetris bin shape. A TERM=dumb terminal is never switched to the
    // alternate screen and keeps its cursor; the in-band refusal frame then
    // quits through the Model (flappy-02).
    new ProgramOptions(
        useAltScreen: $profile !== ColorProfile::NoTty,
        hideCursor: $profile !== ColorProfile::NoTty,
        colorProfile: $profile,
        // flappy-09 (finding -008): click/tap flaps — a no-tap flappy-bird
        // is unplayable on touch terminals (Termux, ttyd). minesweeper
        // precedent: CellMotion press-only, gated off for a refusal frame.
        mouseMode: $profile !== ColorProfile::NoTty ? MouseMode::CellMotion : MouseMode::Off,
        // flappy-20 (finding -022): DECSET 1004 on — the terminal reports
        // focus, the model freezes the world while the window is away.
        reportFocus: true,
    ),
);
$final = $program->run();
// M18: run() hands back the final model on EVERY exit path. Pressing q
// settles a qualifying mid-flight score inside the Model; a signal death
// (Ctrl+C) never reaches update(), so settle once more here. The call is
// idempotent, so the q path's re-write is the same bytes.
if ($final instanceof Game) {
    try {
        $final->settleOnExit();
    } catch (\Throwable) {
        // A final save must never replace the game's exit status.
    }
}
// m5: surface a signal death to the shell as the conventional 128+signo.
$signal = $program->stopSignal();
if ($signal !== null) {
    exit(128 + $signal);
}
// flappy-02 (finding -002): the in-band NoTty refusal now quits through the
// Model; report it to the shell as an error the same way the pre-flight
// refuses a piped launch with exit 1 — rc 1, never a signal death.
if ($final instanceof Game && $final->colorProfile === ColorProfile::NoTty) {
    exit(1);
}
exit(0);
