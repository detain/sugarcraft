#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CandyMail CLI — send email from the terminal.
 *
 * Usage:
 *   candy-mail --from <addr> --to <addr> [--subject "Subject"] [--attach <file>]
 *   candy-mail < message.txt   (reads body from stdin; --from/--to required via flags or env)
 *
 * Flags accept both `--flag value` and `--flag=value`; repeatable flags are
 * --to/--cc/--bcc/--attach. A value that begins with a dash rides the inline
 * `--flag=VALUE` form only — the separated form refuses to steal a switch
 * (M-G). --render prints the SMTP MIME message without any network I/O;
 * --version prints the package version.
 *
 * Env: RESEND_API_KEY, CANDY_MAIL_FROM, CANDY_MAIL_SMTP_HOST/PORT/USERNAME/PASSWORD,
 *      CANDY_MAIL_SMTP_REQUIRE_TLS (default on), CANDY_MAIL_SMTP_IMPLICIT_TLS (default off),
 *      CANDY_MAIL_SMTP_HELO, CANDY_MAIL_SMTP_CA_FILE, CANDY_MAIL_SMTP_TIMEOUT,
 *      CANDY_MAIL_SIGNATURE
 *
 * Embedding (M-T): require this file and exit(\SugarCraft\Mail\main($argv));
 * auto-dispatch fires only when the file itself is the process entry script,
 * so a forgotten proxy never looks like a silent success.
 */
namespace SugarCraft\Mail;

// DST-1 (guard shape ported from candy-code/candy-top, measured on PHP 8.3.6):
// when `php candy-mail.phar` runs, THIS file is the archive's stub and the
// process is NOT inside the archive — Phar::running() answers '' in exactly
// this context, and a bare '/x.phar/entry' path fails is_file()/require for
// every caller. Two identities therefore cover the two phar shapes: the stub
// names itself in __FILE__, and a require-from-inside names the archive in
// Phar::running(). Both are addressed the only way that works, as a phar://
// URI. The archive's own vendor is then the ONLY root — a stray vendor beside
// (or above) a downloaded phar must never boot the app with code from outside
// the frozen archive — so the plain `../vendor` require below runs only when
// no archive identity exists. In every composer-mode checkout Phar::running()
// is '' and __FILE__ is not a .phar, so that require is byte-untouched.
$archive = hostArchiveFrom(\Phar::running(false), __FILE__);
if ($archive !== '') {
    $path = 'phar://' . $archive . '/vendor/autoload.php';
    if (!is_file($path)) {
        // A phar without its own vendor/ is a build defect, not a fallback
        // case: booting from an outside vendor would run code the frozen
        // archive does not contain — the exact lie this guard exists to
        // prevent. Fail loud.
        \fwrite(\STDERR, "candy-mail: the archive has no vendor/autoload.php — the phar was built without a packaged vendor.\n");
        exit(1);
    }
    require $path;
} else {
    // Composer consumers get this file via a symlink at
    // <project>/vendor/bin/candy-mail, so __DIR__ resolves through to
    // <project>/vendor/sugarcraft/candy-mail/bin — the package-local
    // `../vendor` only exists in a monorepo checkout, and the project's
    // autoloader sits three levels up from bin. First hit wins; neither
    // candidate existing is a broken install, so fail loud (exit 1)
    // rather than fatal on a bare require or, worse, exit 0 silently.
    $autoloadCandidates = [
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
    ];
    foreach ($autoloadCandidates as $path) {
        if (is_file($path)) {
            require $path;
            $autoloadFound = true;
            break;
        }
    }
    if (!isset($autoloadFound)) {
        fwrite(STDERR, "candy-mail: cannot find composer autoload.php — install the package with composer or run scripts/refresh-deps.php from a monorepo checkout.\n");
        exit(1);
    }
}

use SugarCraft\Core\Util\Sanitize;
use SugarCraft\Mail\{Email, Lang, Mailer, ResendTransport, SmtpTransport};

// Guard: only auto-dispatch when this file IS the entry script. Embedded or
// proxied launches (M-T) must call main($argv) and exit with its status —
// `php proxy.php --version` used to fall through silently with exit 0, the
// false-success anti-pattern this replaces. Tests require this file for its
// helper functions and stay untouched by the guard.
if (PHP_SAPI === 'cli' && isset($argv[0]) && realpath($argv[0]) === __FILE__) {
    exit(main($argv));
}

/**
 * The CLI entry point: parse, build, choose transport, send.
 *
 * Returns the process exit status (0 success, 1 any refusal) so a proxy
 * script can `exit(\SugarCraft\Mail\main($argv));`. Error messages follow
 * the detected locale; usage text stays English by house design.
 */
function main(array $argv): int
{
    // Error MESSAGES follow the user's locale (Lang catalog, 16 locales);
    // the CLI's own usage/help text stays English by design, like every
    // SugarCraft bin. T::detect() reads LC_ALL/LC_MESSAGES/LANG, falling
    // back to 'en'.
    \SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());

    // Pre-rename env compatibility (plan_rename.md R4.5): POP_* was this // @rename-keep
    // app's option env prefix before the 2026-10 rename to candy-mail (the // @rename-keep
    // old bin was named pop). These vars hold SMTP credentials — keep them // @rename-keep
    // working for one release, loud about it on stderr. The deprecation
    // notice is plain English by design (help() too): error MESSAGES are
    // translated via Lang; the CLI's own usage text is not locale-routed.
    // Import any old-prefix exports under the new CANDY_MAIL_* name (new
    // name always wins), then warn once per var. N1 (lib-reviews-1102):
    // only warn for vars whose renamed counterpart this program actually
    // reads — an off-roster POP_ANYTHING maps to a CANDY_MAIL_ANYTHING
    // that nothing consumes, and warning about it invented a migration
    // target that does not exist. The import itself stays whole-prefix
    // (LegacyEnv semantics): those extras are simply inert.
    $mailEnvRoster = [ // suffixes of CANDY_MAIL_* read by envString()/envFlag()
        'FROM', 'SIGNATURE', 'SMTP_HOST', 'SMTP_PORT', 'SMTP_USERNAME',
        'SMTP_PASSWORD', 'SMTP_REQUIRE_TLS', 'SMTP_IMPLICIT_TLS',
        'SMTP_HELO', 'SMTP_CA_FILE', 'SMTP_TIMEOUT',
    ];
    foreach (\SugarCraft\Core\Util\LegacyEnv::import([
        'POP_' => 'CANDY_MAIL_', // @rename-keep
    ]) as $legacyVar) {
        $suffix = \substr($legacyVar, \strlen('POP_')); // @rename-keep
        if (!\in_array($suffix, $mailEnvRoster, true)) {
            continue;
        }
        // C5 (lib-reviews-1102): env var NAMES are attacker-settable in any
        // process environment — an OSC/BEL-bearing name would ride this
        // warning raw to the terminal. Sweep at the egress choke.
        fwrite(STDERR, Sanitize::untrusted(sprintf("candy-mail: %s is deprecated; set CANDY_MAIL_%s instead.\n", $legacyVar, $suffix))); // @rename-keep
    }

    try {
        $args = parseArgs($argv);
    } catch (\Throwable $e) {
        // C5 (lib-reviews-1102): $e->getMessage() carries raw untrusted bytes
        // here — argv tokens on parse refusals, file paths, and (downstream)
        // pre-STARTTLS server lines; sugar-core's untrusted choke strips
        // SGR/OSC/BEL before they reach the terminal.
        fwrite(STDERR, Sanitize::untrusted(Lang::t('cli.error', ['message' => $e->getMessage()])) . "\n");
        return 1;
    }
    // C5 (lib-reviews-1102): argv[0] is attacker-settable by any caller
    // (execve), and the usage banner echoes it to the terminal — sweep the
    // untrusted name at the choke instead of trusting the exec line.
    $bin = Sanitize::untrusted(basename($argv[0]));

    if ($args['version']) {
        fwrite(STDOUT, cliVersion() . "\n");
        return 0;
    }

    if (cliWantsHelp($args)) {
        fwrite(STDOUT, help($bin));
        return 0;
    }

    // Read body from STDIN if available and no --body given
    $body = $args['opts']['body'] ?? '';
    if ($body === '' && !\feof(STDIN) && !\stream_isatty(STDIN)) {
        while (!\feof(STDIN)) {
            $body .= \fgets(STDIN);
        }
        $body = \trim($body);
    }

    // Build email
    try {
        $email = buildEmail($args['opts'], $body);
    } catch (\Throwable $e) {
        // C5 (lib-reviews-1102): $e->getMessage() carries raw untrusted bytes
        // here — argv tokens on parse refusals, file paths, and (downstream)
        // pre-STARTTLS server lines; sugar-core's untrusted choke strips
        // SGR/OSC/BEL before they reach the terminal.
        fwrite(STDERR, Sanitize::untrusted(Lang::t('cli.error', ['message' => $e->getMessage()])) . "\n");
        return 1;
    }

    // --render: print the RFC 822 envelope offline (M-V/M-Q rewrite). Only a
    // MISSING transport falls back to a non-connected localhost renderer; a
    // BROKEN transport config is a loud error — it used to be swallowed into
    // an exit-0 preview that certified a wire format which never ships. The
    // Message-ID identity is --helo when given, else the local hostname —
    // never the SMTP host itself. When the configured transport is Resend,
    // the divergence is stamped on stderr: Resend posts a JSON payload.
    if ($args['render']) {
        try {
            $configured = buildTransport($args['opts']);
        } catch (\RuntimeException $e) {
            if ($e->getMessage() !== Lang::t('cli.no_transport')) {
                fwrite(STDERR, Sanitize::untrusted(Lang::t('cli.transport_error', ['message' => $e->getMessage()])) . "\n");
                return 1;
            }
            $configured = null; // preview without credentials stays possible
        } catch (\Throwable $e) {
            fwrite(STDERR, Sanitize::untrusted(Lang::t('cli.transport_error', ['message' => $e->getMessage()])) . "\n");
            return 1;
        }
        if ($configured instanceof ResendTransport) {
            fwrite(STDERR, Lang::t('cli.render_resend_divergence') . "\n");
        }
        $renderer = $configured instanceof SmtpTransport
            ? $configured
            : new SmtpTransport(host: 'localhost');
        fwrite(STDOUT, $renderer->buildMimeMessage($email));
        return 0;
    }

    // Choose transport
    try {
        $transport = buildTransport($args['opts']);
    } catch (\Throwable $e) {
        // C5: transport errors embed the raw SMTP greeting/response bytes —
        // attacker-controlled before STARTTLS. Sweep at the egress choke.
        fwrite(STDERR, Sanitize::untrusted(Lang::t('cli.transport_error', ['message' => $e->getMessage()])) . "\n");
        return 1;
    }

    $mailer = new Mailer($transport);

    try {
        $mailer->send($email);
        echo Lang::t('cli.email_sent', ['transport' => $mailer->transportName()]) . "\n";
    } catch (\Throwable $e) {
        // C5: send failures carry server/Resend-response bytes verbatim.
        fwrite(STDERR, Sanitize::untrusted(Lang::t('cli.send_failed', ['message' => $e->getMessage()])) . "\n");
        return 1;
    }
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

/**
 * Parse CLI arguments.
 *
 * Long flags accept `--flag value` and `--flag=value`; repeatable flags
 * (--to/--cc/--bcc/--attach) always collect into a list so both forms feed
 * Email the same shape. Unknown long flags and unknown short flags throw
 * rather than being silently dropped. `--` ends option parsing so later
 * tokens are positional recipients even if they start with a dash.
 * A value-taking flag never consumes the next token when that token is
 * missing or itself looks like a switch (M-G): `--subject --render` used
 * to silently steal the switch and mail an empty subject. Pass values
 * that begin with a dash via the inline `--flag=VALUE` form.
 *
 * @return array{positional: list<string>, opts: array<string, mixed>, help: bool, version: bool, render: bool}
 */
function parseArgs(array $argv): array
{
    $positional = [];
    $opts       = [];
    $total      = \count($argv);

    // flag name => opts key, split by how many values they take
    $listFlags    = ['to' => 'to', 'cc' => 'cc', 'bcc' => 'bcc', 'attach' => 'attachments'];
    $boolFlags    = ['help' => 'help', 'version' => 'version', 'render' => 'render'];
    $scalarFlags  = ['from' => 'from', 'subject' => 'subject', 'body' => 'body', 'reply-to' => 'reply_to', 'html' => 'html', 'helo' => 'helo', 'ca-file' => 'ca_file', 'timeout' => 'timeout'];
    $shortAliases = ['f' => 'from', 't' => 'to', 's' => 'subject', 'a' => 'attach', 'h' => 'help'];

    $i = 1;
    while ($i < $total) {
        $arg           = (string) $argv[$i];
        $inlineValue   = null;
        $name          = null;

        if ($arg === '--') {
            while (++$i < $total) {
                $positional[] = (string) $argv[$i];
            }
            break;
        }

        if (\str_starts_with($arg, '--')) {
            $body = \substr($arg, 2);
            $eq   = \strpos($body, '=');
            if ($eq === false) {
                $name = $body;
            } else {
                $name        = \substr($body, 0, $eq);
                $inlineValue = \substr($body, $eq + 1);
            }
        } elseif (\str_starts_with($arg, '-') && $arg !== '-' && isset($shortAliases[\substr($arg, 1)])) {
            $name = $shortAliases[\substr($arg, 1)];
        }

        $known = isset($listFlags[$name]) || isset($boolFlags[$name]) || isset($scalarFlags[$name]);
        if ($name === '' || ($name !== null && !$known)) {
            $name = null;
        }

        if ($name === null) {
            if (\str_starts_with($arg, '-')) {
                // did-you-mean: nearest known long flag (B8 minor). Only for
                // plain-ASCII probes — levenshtein() is byte-based and would
                // score UTF-8 noise meaninglessly.
                $probe   = \preg_replace('/^-+/', '', $arg) ?? '';
                $hint    = '';
                $best    = null;
                $bestDx  = 4; // accept distance <= 3
                if ($probe !== '' && \preg_match('/^[A-Za-z][A-Za-z-]*$/', $probe) === 1) {
                    foreach (\array_merge(\array_keys($listFlags), \array_keys($boolFlags), \array_keys($scalarFlags)) as $cand) {
                        $dx = \levenshtein($probe, $cand);
                        if ($dx < $bestDx) {
                            $bestDx = $dx;
                            $best   = $cand;
                        }
                    }
                }
                if ($best !== null) {
                    $hint = ' ' . Lang::t('cli.did_you_mean', ['suggestion' => '--' . $best]);
                }
                throw new \InvalidArgumentException(Lang::t('cli.unknown_option', ['option' => $arg]) . $hint);
            }
            $positional[] = $arg;
            $i++;
            continue;
        }

        if (isset($boolFlags[$name])) {
            $opts[$boolFlags[$name]] = true;
        } elseif (isset($listFlags[$name])) {
            if ($inlineValue !== null) {
                $opts[$listFlags[$name]][] = $inlineValue;
            } else {
                $opts[$listFlags[$name]][] = nextValue($argv, $i, $arg);
                $i++;
            }
        } else {
            if ($inlineValue !== null) {
                $opts[$scalarFlags[$name]] = $inlineValue;
            } else {
                $opts[$scalarFlags[$name]] = nextValue($argv, $i, $arg);
                $i++;
            }
        }
        $i++;
    }

    // Fill 'to' from positional if not set
    if (!isset($opts['to']) && $positional !== []) {
        $opts['to'] = $positional;
    }

    return [
        'positional' => $positional,
        'opts'       => $opts,
        'help'       => ($opts['help'] ?? false) === true,
        'version'    => ($opts['version'] ?? false) === true,
        'render'     => ($opts['render'] ?? false) === true,
    ];
}

/**
 * The next token as a flag value (M-G). Refuses a missing value and refuses
 * to eat a switch: only a token that does not begin with '-' (or the lone
 * '-') is eligible. Dash-leading data belongs in the inline form
 * `--flag=VALUE`, which never routes through here.
 */
function nextValue(array $argv, int $i, string $flag): string
{
    $next = $argv[$i + 1] ?? null;
    if ($next === null || (\str_starts_with((string) $next, '-') && \strlen((string) $next) > 1)) {
        throw new \InvalidArgumentException(Lang::t('cli.missing_value', ['option' => $flag]));
    }

    return (string) $next;
}

/**
 * The help gate (docs-fix-1023 M-5): bare invocation shows help, but an
 * env-provided sender or any recipient means the user meant to send —
 * `CANDY_MAIL_FROM=… candy-mail --to you@example.com` must not print help.
 */
function cliWantsHelp(array $args): bool
{
    if ($args['help']) {
        return true;
    }

    // qa m1: a cc/bcc-only invocation meant to send too — showing help with
    // exit 0 made silence look like progress. The gate yields; buildEmail
    // then refuses the missing --to loudly.
    $hasRecipients = $args['positional'] !== [] || isset($args['opts']['to'])
        || isset($args['opts']['cc']) || isset($args['opts']['bcc']);
    $hasSender     = isset($args['opts']['from']) || senderFromEnvironment() !== '';

    return !$hasRecipients && !$hasSender;
}

/**
 * Default sender from the environment, or '' when unset. Reads both the
 * $_ENV copy and getenv() because CLI launchers populate only one depending
 * on how the process was started.
 */
function senderFromEnvironment(): string
{
    $from = $_ENV['CANDY_MAIL_FROM'] ?? \getenv('CANDY_MAIL_FROM', true);

    return \is_string($from) ? $from : '';
}

/**
 * Boolean env switch: unset/empty keeps the default; '1'/'true'/'yes'/'on'
 * turn it on and '0'/'false'/'no'/'off' turn it off. Anything else throws
 * (M-B): a typo like 'ture' once silently disabled REQUIRE_TLS — the safe
 * reading of an unrecognised switch is a loud refusal, never a guess.
 */
function envFlag(string $name, bool $default): bool
{
    $raw = $_ENV[$name] ?? \getenv($name, true);
    if (!\is_string($raw) || $raw === '') {
        return $default;
    }

    $word = \strtolower($raw);
    if (\in_array($word, ['1', 'true', 'yes', 'on'], true)) {
        return true;
    }
    if (\in_array($word, ['0', 'false', 'no', 'off'], true)) {
        return false;
    }

    throw new \InvalidArgumentException(Lang::t('cli.invalid_env_flag', ['name' => $name, 'value' => $raw]));
}

/**
 * SMTP port from CANDY_MAIL_SMTP_PORT (default 587 — the STARTTLS submission
 * port). Refuses garbage loudly instead of sending to port 0.
 */
function portFromEnvironment(): int
{
    $raw = $_ENV['CANDY_MAIL_SMTP_PORT'] ?? \getenv('CANDY_MAIL_SMTP_PORT', true);
    if (!\is_string($raw) || $raw === '') {
        return 587;
    }

    if (!\ctype_digit($raw) || (int) $raw < 1 || (int) $raw > 65535) {
        throw new \InvalidArgumentException(Lang::t('cli.invalid_port', ['port' => $raw]));
    }

    return (int) $raw;
}

function buildEmail(array $opts, string $stdinBody): Email
{
    $envFrom = senderFromEnvironment();
    // M-C: no flag and no CANDY_MAIL_FROM is a refusal, not a fabrication —
    // 'unknown@localhost' once forged a real sender into every message.
    $from = $opts['from'] ?? ($envFrom !== '' ? $envFrom : null);
    if ($from === null) {
        throw new \InvalidArgumentException(Lang::t('cli.no_sender'));
    }
    $to = $opts['to'] ?? [];

    if ($to === []) {
        throw new \InvalidArgumentException(Lang::t('cli.no_to_recipient'));
    }

    $body      = $stdinBody !== '' ? $stdinBody : ($opts['body'] ?? null);
    $signature = $_ENV['CANDY_MAIL_SIGNATURE'] ?? \getenv('CANDY_MAIL_SIGNATURE', true);

    $email = new Email(
        from:     [$from],
        to:       $to,
        // m6: no --subject means NO Subject header (buildHeaders skips null),
        // not a fabricated '(no subject)'. The Resend transport keeps its own
        // payload default — that is an API contract, not a header forgery.
        subject:  $opts['subject'] ?? null,
        body:     $body,
        cc:       $opts['cc'] ?? [],
        bcc:      $opts['bcc'] ?? [],
        htmlBody: $opts['html'] ?? null,
        replyTo:  $opts['reply_to'] ?? null,
    );

    // getenv() yields false (not '') when the var is absent — only a real
    // string signature may reach withSignature(): string.
    if (\is_string($signature) && $signature !== '') {
        $email = $email->withSignature($signature);
    }

    foreach ($opts['attachments'] ?? [] as $file) {
        if (!\file_exists($file)) {
            throw new \InvalidArgumentException(Lang::t('cli.attachment_not_found', ['file' => $file]));
        }
        $email = $email->withAttachment(\basename($file), $file);
    }

    return $email;
}

/**
 * Choose the transport from environment and (optionally) parsed CLI flags.
 *
 * M-AA/M-Q: --helo/CANDY_MAIL_SMTP_HELO, --ca-file/CANDY_MAIL_SMTP_CA_FILE
 * and --timeout/CANDY_MAIL_SMTP_TIMEOUT close the gap where the README
 * advertised withCaFile() and the Message-ID identity while the CLI offered
 * no way to reach either. Flags win over env; envString() normalises the
 * getenv() false-vs-'' asymmetry.
 *
 * @param array<string, mixed> $flags parsed --option values (buildEmail shape)
 */
function buildTransport(array $flags = []): Transport
{
    // M-P: trim the raw value first — a whitespace-only RESEND_API_KEY used
    // to hijack transport selection (resolving truthy while ignoring the
    // full SMTP config). An absent or blank key means "not configured".
    $apiKey = \trim(envString('RESEND_API_KEY'));
    if ($apiKey !== '') {
        return new ResendTransport($apiKey);
    }

    $host = envString('CANDY_MAIL_SMTP_HOST');
    if ($host !== '') {
        $helo    = (string) ($flags['helo'] ?? envString('CANDY_MAIL_SMTP_HELO'));
        $timeout = timeoutSeconds($flags['timeout'] ?? envString('CANDY_MAIL_SMTP_TIMEOUT'));

        $transport = (new SmtpTransport(
            host:      $host,
            port:      portFromEnvironment(),
            username:  envString('CANDY_MAIL_SMTP_USERNAME'),
            password:  envString('CANDY_MAIL_SMTP_PASSWORD'),
            timeout:   $timeout,
            heloHost:  $helo,
        ))
            ->withRequireTls(envFlag('CANDY_MAIL_SMTP_REQUIRE_TLS', true))
            ->withImplicitTls(envFlag('CANDY_MAIL_SMTP_IMPLICIT_TLS', false));

        $caFile = (string) ($flags['ca_file'] ?? envString('CANDY_MAIL_SMTP_CA_FILE'));
        if ($caFile !== '') {
            // Fail at configuration time, not mid-handshake: the docs sell
            // withCaFile as THE private-CA remedy, so an unusable path must
            // be a refusal the operator sees before any connect attempt.
            if (!\is_file($caFile) || !\is_readable($caFile)) {
                throw new \InvalidArgumentException(Lang::t('cli.ca_file_unreadable', ['file' => $caFile]));
            }
            $transport = $transport->withCaFile($caFile);
        }

        return $transport;
    }

    throw new \RuntimeException(Lang::t('cli.no_transport'));
}

/** A string env value; absent-or-false reads as '' (the getenv() trap). */
function envString(string $name): string
{
    $value = $_ENV[$name] ?? \getenv($name, true);

    return \is_string($value) ? $value : '';
}

/**
 * Wire timeout in seconds: unset/'' is the transport default 30; anything
 * outside 1..3600 is refused loudly (same discipline as portFromEnvironment).
 */
function timeoutSeconds(mixed $raw): int
{
    $value = \is_string($raw) ? \trim($raw) : (string) ($raw ?? '');
    if ($value === '') {
        return 30;
    }

    if (!\ctype_digit($value) || (int) $value < 1 || (int) $value > 3600) {
        throw new \InvalidArgumentException(Lang::t('cli.invalid_timeout', ['timeout' => $value]));
    }

    return (int) $value;
}

/**
 * The three archive identities, first answer wins (measured on PHP 8.3.6
 * while porting the candy-code DST-1 guard): {@see \Phar::running()} names
 * the archive for any script executing from inside it; in the stub region of
 * a directly executed archive it answers '' and the archive is named by
 * `__FILE__` ending in `.phar`; a `phar://`-prefixed `__FILE__` covers the
 * shape where this file was required from inside the archive. Pure function
 * of its inputs so the law is testable without minting an archive.
 */
function hostArchiveFrom(string $running, string $file): string
{
    if ($running !== '') {
        return $running;
    }

    if (str_starts_with($file, 'phar://')) {
        return preg_match('#^phar://(.+\.phar)(?:/|$)#', $file, $m) === 1 ? $m[1] : '';
    }

    return str_ends_with($file, '.phar') ? $file : '';
}

/** The real-filesystem path of the phar hosting this install, or ''. */
function hostArchive(): string
{
    return hostArchiveFrom(\Phar::running(false), __FILE__);
}

/**
 * Package version for --version, phar-aware (DST-1 program, phf lane).
 *
 * Inside an archive the build manifest written by tools/build-phar.php is the
 * AUTHORITY and wins outright: the packaged vendor/composer/installed.php is
 * FROZEN at build time, so InstalledVersions would keep answering the build
 * root's pretty_version (`dev-master`) for the entire life of the artifact —
 * the exact frozen-dev-master lie candy-code's DST-1 pinned. A bare
 * `dev-build` stamp is working-tree noise (no release tag was reachable at
 * build time) and falls through, fail-closed, like candy-code's
 * Version::fromPharMetadata(). Outside an archive nothing is consulted and
 * the Composer-metadata resolution below answers, byte-unchanged composer
 * behaviour: from the library's own install when present, else the host
 * app's root package, else 'dev'.
 */
function cliVersion(): string
{
    $archive = hostArchive();
    if ($archive !== '') {
        try {
            $metadata = (new \Phar($archive))->getMetadata();
        } catch (\Throwable) {
            $metadata = null;
        }
        if (is_array($metadata)) {
            $stamp = $metadata['version'] ?? null;
            if (is_string($stamp) && trim($stamp) !== '' && trim($stamp) !== 'dev-build') {
                return trim($stamp);
            }
        }
    }

    if (!\class_exists(\Composer\InstalledVersions::class)) {
        return 'dev';
    }

    try {
        if (\Composer\InstalledVersions::isInstalled('sugarcraft/candy-mail')) {
            return (string) \Composer\InstalledVersions::getPrettyVersion('sugarcraft/candy-mail');
        }

        return (string) (\Composer\InstalledVersions::getRootPackage()['pretty_version'] ?? 'dev');
    } catch (\Throwable) {
        return 'dev';
    }
}

function help(string $bin): string
{
    return <<<HELP
CandyMail CLI — send email from your terminal.

Usage:
  {$bin} --from <addr> --to <addr> [--subject "s"] [--body "text"]
  {$bin} --from <addr> --to <addr> --attach file.pdf < message.txt
  cat message.txt | {$bin} --from <addr> --to <addr>
  {$bin} --from <addr> --to <addr> --render        (print MIME, send nothing)

  Flags accept --name value and --name=value. Body is read from STDIN if no
  --body flag is given. Unknown options are rejected, not ignored. Error
  messages follow the LC_ALL/LC_MESSAGES/LANG locale (16 locales); this
  help is English.

Options:
  --from <addr>        Sender email address
  --to <addr>          Recipient email address (may be repeated)
  --cc <addr>          CC recipient (may be repeated)
  --bcc <addr>         BCC recipient (may be repeated)
  --subject <s>        Email subject
  --body <text>        Email body (else reads STDIN)
  --html <html>        HTML body alternative
  --attach <file>      Attach a file (may be repeated)
  --reply-to <addr>    Reply-to address
  --helo <host>        HELO/EHLO identity (letters, digits, dots, hyphens);
                       also sets the Message-ID host
  --ca-file <path>     PEM bundle for TLS verification (private CAs)
  --timeout <secs>     Wire timeout, 1-3600 (default 30)
  --render             Print the SMTP MIME message and exit (no network;
                       broken transport config is still an error, and a
                       Resend-configured send is stamped as a divergence)
  --version            Print the package version and exit
  --help, -h           Show this help
  Short aliases: -f/--from, -t/--to, -s/--subject, -a/--attach (space form
  only — a value glued with "=" needs the long option, e.g. --from=value).

Environment variables:
  RESEND_API_KEY                   Resend API key (preferred transport)
  CANDY_MAIL_SMTP_HOST             SMTP server host (when no API key is set)
  CANDY_MAIL_SMTP_PORT             SMTP port (default 587, STARTTLS submission)
  CANDY_MAIL_SMTP_USERNAME         SMTP AUTH user (needs a TLS channel)
  CANDY_MAIL_SMTP_PASSWORD         SMTP AUTH password (needs a TLS channel)
  CANDY_MAIL_SMTP_REQUIRE_TLS      TLS floor (default: on). Words 1/true/yes/on
                                   turn it on, 0/false/no/off turn it off;
                                   anything else is refused, never guessed.
  CANDY_MAIL_SMTP_IMPLICIT_TLS     Port-465 implicit TLS (default: off; same words)
  CANDY_MAIL_SMTP_HELO             HELO/EHLO identity (same grammar as --helo)
  CANDY_MAIL_SMTP_CA_FILE          PEM bundle path (same checks as --ca-file)
  CANDY_MAIL_SMTP_TIMEOUT          Wire timeout seconds (same bounds as --timeout)
  CANDY_MAIL_FROM                  Default sender address
  CANDY_MAIL_SIGNATURE             Appended to email body

Examples:
  {$bin} --from me@example.com --to you@example.com --subject "Hello"
  export CANDY_MAIL_FROM=me@example.com
  cat message.txt | {$bin} --to you@example.com --subject "Hello"
  {$bin} --from me@example.com --to a@b.com --attach invoice.pdf --subject "Invoice"

HELP;
}
