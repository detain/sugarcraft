#!/usr/bin/env php
<?php

declare(strict_types=1);

// ---------------------------------------------------------------------------
// Autoloader (archive-aware). A phar build stamps THIS file as the archive
// stub, so under `php candy-gifview.phar` __FILE__ names the archive and its
// bundled vendor/ is the only correct source. Measured PHP 8.3 law: in the
// stub context \Phar::running(false) answers '' and a bare '/x.phar/entry'
// path fails is_file — resolve from BOTH identities ('phar://' . __FILE__
// under the stub, 'phar://' . running() when required from inside), and once
// an archive is found DROP the filesystem candidates so a working-tree vendor
// beside a published .phar can never outrank the archive. The three original
// candidates are preserved verbatim for every non-archive run.
// ---------------------------------------------------------------------------
(static function (): void {
    $archive = str_ends_with(__FILE__, '.phar')
        ? 'phar://' . __FILE__
        : (\Phar::running(false) !== '' ? 'phar://' . \Phar::running(false) : '');
    $candidates = $archive !== ''
        ? [$archive . '/vendor/autoload.php']
        : ['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    foreach ($candidates as $candidate) {
        // phar:// URIs are absolute too — the old '/'-only prefix test would
        // re-anchor them onto __DIR__ and miss the archive.
        $path = (str_starts_with($candidate, '/') || str_starts_with($candidate, 'phar://'))
            ? $candidate
            : __DIR__ . '/../' . $candidate;
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    // A renamed, suffix-less archive (the composer-install shape: download
    // X.phar, mv it to a bare name): PHP neither auto-mounts it (the CLI
    // runs it as a plain script, Phar::running() answers '') nor resolves
    // phar://__FILE__ (measured PHP 8.3.6: without a .phar segment the
    // wrapper cannot locate the archive). Phar::mapPhar() does find the
    // signature inside the running file and mounts it under its build-time
    // alias — the composer-style identity of a renamed binary. The alias
    // is owned by tools/build-phar.php; PharBuildScriptTest pins both sides
    // agree. A plain source run with no archive fails the probe and lands
    // on the honest refusal below.
    if ($archive === '' && class_exists('Phar')) {
        try {
            if (@Phar::mapPhar('candy-gifview.phar') !== false
                && is_file('phar://candy-gifview.phar/vendor/autoload.php')) {
                require 'phar://candy-gifview.phar/vendor/autoload.php';
                return;
            }
        } catch (\Throwable) {
            // Not an archive (or the alias drifted): fall through.
        }
    }
    fwrite(STDERR, "candy-gifview: cannot find composer autoload.php\n");
    exit(1);
})();

// Locale before the first message is formatted — app AND engine Lang::t calls land
// in the user's language (sugar-core documents T::setLocale(T::detect()) at startup).
\SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());

// Thin shim by design: every branch lives in Cli::main() so the argv
// handling, decode failures, and viewport sizing are testable in-process.
exit(\SugarCraft\GifView\Cli::main($argv ?? [], STDOUT, STDERR));
