{
    "name": "sugarcraft/candy-msteams",
    "description": "Microsoft Teams channel bundle for candy-code serve: chat with a served session from Teams personal chats, group chats and channel posts. Webhook inbound with in-bundle Bot Framework JWT validation, activity-referenced REST outbound, pairing gates, group allowlists, queue modes, chunked redacted replies, and adaptive-card approvals with a same-chat text fallback. Policy rides the user-tier channels.msteams settings; credentials live only in the 0600 channels store.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sugarcraft",
        "candy-code",
        "bundle",
        "channel",
        "microsoft-teams",
        "teams"
    ],
    "homepage": "https://github.com/sugarcraft/candy-msteams",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-msteams/issues",
        "source": "https://github.com/sugarcraft/candy-msteams",
        "docs": "https://github.com/sugarcraft/candy-msteams#readme"
    },
    "require": {
        "php": "^8.3",
        "psr/http-message": "^1.1 || ^2.0",
        "ratchet/pawl": "^0.4",
        "ratchet/rfc6455": "^0.4",
        "react/event-loop": "^1.6",
        "react/http": "^1.11",
        "react/promise": "^3.3",
        "react/socket": "^1.16",
        "react/stream": "^1.4",
        "sugarcraft/sugar-mcp-client": "dev-master",
        "sugarcraft/sugar-plugins": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CandyCode\\Bundles\\MsTeams\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CandyCode\\Bundles\\MsTeams\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
