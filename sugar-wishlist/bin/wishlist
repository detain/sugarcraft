#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * `wishlist` — SSH endpoint picker.
 *
 *   wishlist [--config <path>] [--ssh <ssh-binary>] [--help]
 *
 * Without `--config` the search order is: `wishlist.yml`,
 * `wishlist.yaml`, `wishlist.json` in the CURRENT DIRECTORY first,
 * then `~/.config/wishlist.{yml,yaml,json}`. `--ssh` must be an
 * absolute path to the ssh binary (`pcntl_exec` does not search
 * `$PATH`). On Enter, replaces the current process with `ssh`
 * connecting to the chosen entry; Esc exits 130.
 */

use SugarCraft\Wishlist\Config;
use SugarCraft\Wishlist\Lang;
use SugarCraft\Wishlist\Launcher;
use SugarCraft\Wishlist\Picker;

// ---------------------------------------------------------------------------
// Autoloader
// ---------------------------------------------------------------------------
(static function (): void {
    foreach ([
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../vendor/autoload.php',
        __DIR__ . '/../../../vendor/autoload.php',
    ] as $candidate) {
        if (is_file($candidate)) {
            require $candidate;
            return;
        }
    }
    fwrite(STDERR, "wishlist: could not find composer autoloader\n");
    exit(1);
})();

// ---------------------------------------------------------------------------
// CLI argument parsing
// ---------------------------------------------------------------------------
// PHP's getopt() silently stops at the first unrecognised option, so a
// typo like `--confg` would be ignored and the run would proceed with
// defaults. Scan the raw argv first: every `-`-prefixed token must be
// one of the three known flags (value may be glued with `=`), and
// `--help` short-circuits with the usage line on stdout.
$allowed = ['--config', '--ssh'];
foreach (array_slice($argv, 1) as $arg) {
    if (!str_starts_with($arg, '-')) {
        continue;
    }
    $name = $arg;
    $eq = strpos($arg, '=');
    if ($eq !== false) {
        $name = substr($arg, 0, $eq);
    }
    if ($name === '--help') {
        // Handled here rather than via getopt(): getopt's treatment of a
        // valueless long flag given as `--help=1` is version-flaky, and
        // help must win before anything else can fail.
        fwrite(STDOUT, Lang::t('cli.usage') . "\n");
        exit(0);
    }
    if (!in_array($name, $allowed, true)) {
        fwrite(STDERR, Lang::t('cli.unknown_arg', ['arg' => $arg]) . "\n");
        exit(2);
    }
}

$opts = getopt('', ['config:', 'ssh:']);
$cfgPath = $opts['config'] ?? '';
$sshBin = $opts['ssh'] ?? Launcher::DEFAULT_SSH;

// ---------------------------------------------------------------------------
// Config file search (with HOME guard)
// ---------------------------------------------------------------------------
if ($cfgPath === '') {
    $home = getenv('HOME');
    $candidates = [];
    // Always check CWD first
    foreach (['wishlist.yml', 'wishlist.yaml', 'wishlist.json'] as $name) {
        if (is_file($name)) {
            $candidates[] = $name;
        }
    }
    // Only add ~/.config/... candidates when HOME is set and non-empty
    // to prevent probing '/.config/wishlist.yml' when HOME is unset.
    if ($home !== false && $home !== '') {
        foreach (['.config/wishlist.yml', '.config/wishlist.yaml', '.config/wishlist.json'] as $name) {
            $candidates[] = $home . '/' . $name;
        }
    }
    if ($candidates === []) {
        fwrite(STDERR, Lang::t('cli.no_config') . "\n");
        exit(1);
    }
    $cfgPath = $candidates[0];
}

// ---------------------------------------------------------------------------
// SSH binary validation
// ---------------------------------------------------------------------------
if (!is_file($sshBin) || !is_executable($sshBin)) {
    fwrite(STDERR, Lang::t('cli.ssh_not_executable', ['bin' => $sshBin]) . "\n");
    exit(1);
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
try {
    $endpoints = Config::load($cfgPath);
} catch (\Throwable $e) {
    fwrite(STDERR, Lang::t('cli.error', ['message' => $e->getMessage()]) . "\n");
    exit(1);
}

$pick = (new Picker())->pick($endpoints);
if ($pick === null) {
    fwrite(STDERR, Lang::t('cli.cancelled') . "\n");
    exit(130);
}

(new Launcher())->dispatch($pick, $sshBin);
