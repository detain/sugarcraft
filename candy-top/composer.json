{
    "name": "sugarcraft/candy-top",
    "description": "Terminal system monitor (btop-style) built on the SugarCraft stack — PHP TUI port inspired by aristocratos/btop.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "monitor",
        "top",
        "btop",
        "system-monitor",
        "dashboard",
        "charts",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/candy-top",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-top/issues",
        "source": "https://github.com/sugarcraft/candy-top",
        "docs": "https://sugarcraft.github.io/lib/candy-top.html"
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.12.1",
        "react/event-loop": "^1.6",
        "react/promise": "^3.3",
        "sugarcraft/sugar-core": "@dev",
        "sugarcraft/sugar-animation": "@dev",
        "sugarcraft/sugar-style": "@dev",
        "sugarcraft/sugar-widgets": "@dev",
        "sugarcraft/sugar-dashboard": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "@dev"
    },
    "suggest": {
        "ext-posix": "User names in the process list (instead of numeric uids), signal sending (posix_kill) and real-console detection (posix_ttyname).",
        "ext-pcntl": "Renicing processes (pcntl_setpriority) and saving the config on SIGTERM/SIGHUP.",
        "ext-sodium": "Required by `candy-top self-update`: Ed25519 verification of release signatures; without it a phar whose signature cannot be verified refuses to install."
    },
    "bin": [
        "bin/candy-top"
    ],
    "autoload": {
        "psr-4": {
            "SugarCraft\\Top\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Top\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
