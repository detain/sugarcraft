#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace SugarCraft\Top\bin;

(static function () {
    // This lib's own vendor/ (monorepo / split-repo checkout), then the
    // consumer's vendor/ when installed as vendor/sugarcraft/candy-top.
    //
    // DST-1 (guard shape ported from candy-code/bin, measured on PHP 8.3.6
    // there): when `php candy-top.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' in exactly this context, and a bare '/x.phar/entry' path
    // fails is_file()/require for every caller. Two identities therefore
    // cover the two phar shapes: the stub names itself in __FILE__, and a
    // require-from-inside names the archive in Phar::running(). Both are
    // addressed the only way that works, as a phar:// URI. The archive's own
    // vendor is then the ONLY root — a stray vendor beside (or above) a
    // downloaded phar must never boot the app with code from outside the
    // frozen archive, so when the archive identity exists the filesystem
    // candidates are dropped, not merely outranked. In every composer-mode
    // checkout Phar::running() is '' and __FILE__ is not a .phar, so the two
    // filesystem candidates below are byte-untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        // phar:// URIs are absolute by construction; a '/'-only test would
        // re-prefix them onto __DIR__ and miss the archive.
        if (!str_starts_with($path, '/') && !str_starts_with($path, 'phar://')) {
            $path = __DIR__ . '/' . $path;
        }
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-top: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\Program;
use SugarCraft\Core\Util\Sanitize;
use SugarCraft\Top\App;
use SugarCraft\Top\Cli\Help;
use SugarCraft\Top\Cli\SelfUpdate;
use SugarCraft\Top\Collect\Platform;
use SugarCraft\Top\Config\ConfigFile;
use SugarCraft\Top\Input\KeyTable;
use SugarCraft\Top\Lang;
use SugarCraft\Top\Source\Fake\FakeGpu;
use SugarCraft\Top\Msg\ConfigSavedMsg;
use SugarCraft\Top\Panel\GpuPanel;
use SugarCraft\Top\Panel\Panels;
use SugarCraft\Top\Panel\ProcPanel;
use SugarCraft\Top\State\TreeStateFile;
use SugarCraft\Top\State\TreeStateSavedMsg;
use SugarCraft\Top\Theme\ThemeRegistry;

// Every pre-TUI write goes through here. Until the cell-buffered Program
// exists there is no Surface to strip control characters, and several of
// these messages interpolate text this binary does not own: a config warning
// embeds the offending VALUE (ConfigReader → Option → Lang::t), whose token
// splitter refuses only `"`/CR/LF — ESC and BEL ride straight through, so a
// planted `graph_symbol = \x1b]0;pwned\x07evil` writes a live OSC (window
// title, OSC 52 clipboard) that outlives the process. A copied-over btop.conf
// is an advertised input, so those bytes are untrusted by definition; a path
// from $HOME/$XDG_* is the same class (audit M6).
$report = static function (string $message): void {
    @fwrite(STDERR, 'candy-top: ' . Sanitize::untrustedForDisplay($message) . "\n");
};

$args = array_slice($argv ?? [], 1);
$fake = false;
$configPath = null;
// btop's launch overrides (-p/-t/-u): session-only config edits that feed
// the existing keys without persisting (S-O06). null = flag not given.
$presetIndex = null;
$themeArg = null;
$updateMs = null;
// Pulls the value of a space-or-equals option arm: space form takes the
// next argument (and CONSUMES it — the --config law), the `short=`/`long=`
// form the remainder after the '='. Returns null when absent or empty.
$takeValue = static function (string $arg, array $args, int &$i, string $short, string $long): ?string {
    if ($arg === $short) {
        $value = $args[++$i] ?? null;
    } elseif ($arg === $long) {
        $value = $args[++$i] ?? null;
    } elseif (str_starts_with($arg, $short . '=')) {
        $value = substr($arg, strlen($short) + 1);
    } else {
        $value = substr($arg, strlen($long) + 1);
    }
    return $value === '' ? null : $value;
};
for ($i = 0; $i < count($args); $i++) {
    $arg = $args[$i];
    if ($arg === 'self-update') {
        // The one verb candy-top knows, and it must answer before the tty
        // gate: --check/--rollback run over ssh and in cron, where no
        // interactive terminal exists (mirrors candy-code's Subcommands
        // dispatch; SelfUpdate::run parses the flags itself and exits 2 on
        // misuse).
        exit(SelfUpdate::run(array_slice($args, $i + 1)));
    }
    if ($arg === '--version') {
        // Plain text on STDOUT before any config, theme, or host probe —
        // the flag a packaging script or a bug report runs first.
        fwrite(STDOUT, Help::version());
        exit(0);
    }
    if ($arg === '-h' || $arg === '--help') {
        // The KEYS section is the help overlay's own table (one roster, no hand list).
        $keys = [];
        foreach (KeyTable::keyRows() as $row) {
            $keys[$row->keyLabel()] = $row->description();
        }
        $rows = static fn (array $pairs, int $pad): string => implode('', array_map(
            static fn (string $left, string $right): string => '  ' . str_pad($left, $pad) . $right . "\n",
            array_keys($pairs),
            $pairs,
        ));
        fwrite(STDOUT, Lang::t('cli.help.title') . "\n\n"
            . Lang::t('cli.help.usage') . "\n  candy-top [--fake] [--config <path>] [-p N] [-t theme] [-u ms] [--version]\n  candy-top self-update [--check] [--rollback] [--allow-unsigned] [--channel=stable|latest]\n\n"
            . Lang::t('cli.help.options') . "\n" . $rows([
                '--fake' => Lang::t('cli.help.opt.fake'),
                '--config <path>' => Lang::t('cli.help.opt.config'),
                '-p, --preset <N>' => Lang::t('cli.help.opt.preset'),
                '-t, --theme <name>' => Lang::t('cli.help.opt.theme'),
                '-u, --update <ms>' => Lang::t('cli.help.opt.update'),
                '--version' => Lang::t('cli.help.opt.version'),
                '-h, --help' => Lang::t('cli.help.opt.help'),
                '--check' => Lang::t('cli.help.opt.check'),
                '--rollback' => Lang::t('cli.help.opt.rollback'),
                '--allow-unsigned' => Lang::t('cli.help.opt.allow_unsigned'),
                '--channel=stable|latest' => Lang::t('cli.help.opt.channel'),
            ], 24) . "\n"
            . Lang::t('cli.help.keys') . "\n" . $rows($keys, max(array_map(static fn (int|string $k): int => strlen((string) $k), array_keys($keys))) + 2));
        exit(0);
    }
    if ($arg === '--fake') {
        $fake = true;
    } elseif ($arg === '--config' || str_starts_with($arg, '--config=')) {
        $value = $arg === '--config' ? ($args[++$i] ?? null) : substr($arg, 9);
        // A following flag is not a path: `--config --fake` is a missing value.
        if ($value === null || $value === '' || ($arg === '--config' && str_starts_with($value, '-'))) {
            $report(Lang::t('cli.missing_value', ['option' => '--config']));
            exit(2);
        }
        $configPath = $value;
    } elseif ($arg === '-p' || $arg === '--preset' || str_starts_with($arg, '-p=') || str_starts_with($arg, '--preset=')) {
        $space = $arg === '-p' || $arg === '--preset';
        $value = $takeValue($arg, $args, $i, '-p', '--preset');
        $name = explode('=', $arg, 2)[0];
        // btop takes the preset index as a single digit; a flag-eaten or
        // non-numeric value is a usage error, refused before the tty gate
        // like --config's. The file may define fewer presets than 9 — that
        // miss is the startup refusal after load, where the roster lives.
        if ($value === null || ($space && str_starts_with($value, '-'))) {
            $report(Lang::t('cli.missing_value', ['option' => $name]));
            exit(2);
        }
        if (preg_match('/^\d$/', $value) !== 1) {
            $report(Lang::t('cli.bad_value', ['option' => $name, 'value' => $value]));
            exit(2);
        }
        $presetIndex = (int) $value;
    } elseif ($arg === '-u' || $arg === '--update' || str_starts_with($arg, '-u=') || str_starts_with($arg, '--update=')) {
        $space = $arg === '-u' || $arg === '--update';
        $value = $takeValue($arg, $args, $i, '-u', '--update');
        $name = explode('=', $arg, 2)[0];
        if ($value === null || ($space && str_starts_with($value, '-'))) {
            $report(Lang::t('cli.missing_value', ['option' => $name]));
            exit(2);
        }
        if (preg_match('/^\d+$/', $value) !== 1) {
            $report(Lang::t('cli.bad_value', ['option' => $name, 'value' => $value]));
            exit(2);
        }
        // The Schema floor/ceiling clamp rides withUpdateMs (btop clamps too).
        $updateMs = (int) $value;
    } elseif ($arg === '-t' || $arg === '--theme' || str_starts_with($arg, '-t=') || str_starts_with($arg, '--theme=')) {
        $space = $arg === '-t' || $arg === '--theme';
        $value = $takeValue($arg, $args, $i, '-t', '--theme');
        if ($value === null || ($space && str_starts_with($value, '-'))) {
            $report(Lang::t('cli.missing_value', ['option' => explode('=', $arg, 2)[0]]));
            exit(2);
        }
        // Resolved against the theme catalogue after load; an unknown name
        // is a startup refusal there, not here. A path typed in the equals
        // form is data, not a flag.
        $themeArg = $value;
    } else {
        $report(Lang::t('cli.unknown_argument', ['argument' => $arg]));
        exit(2);
    }
}

// btop Term::init refuses to start without an interactive terminal on both
// ends (btop.cpp "No tty detected!"); a TUI writing frames into a pipe or
// reading keys from /dev/null only produces garbage or spins.
if (!stream_isatty(STDIN) || !stream_isatty(STDOUT)) {
    fwrite(STDERR, Lang::t('cli.no_tty') . "\n");
    exit(1);
}

// ConfigFile::new throws when no config path can be derived at all — neither
// XDG_CONFIG_HOME/HOME nor the Windows-native APPDATA/USERPROFILE tail is
// usable (audit m27, candy-top-128). Unguarded that is a PHP fatal — stack
// trace, exit 255 — on the one stream the user is reading, breaking the
// `candy-top: …` refusal discipline every other startup path keeps.
// It exits 2, like a bad argument.
try {
    $file = ConfigFile::new($configPath);
} catch (\RuntimeException $e) {
    $report($e->getMessage());
    exit(2);
}
$loaded = $file->load();
foreach ($loaded->warnings as $warning) {
    // A warning quotes the offending value; see the $report law.
    $report($warning);
}
// btop auto-enables tty mode on a console: Term::current_tty.starts_with("/dev/tty")
// (btop.cpp) — /dev/tty1 and serial consoles like /dev/ttyS0 alike.
$tty = function_exists('posix_ttyname') ? (posix_ttyname(STDIN) ?: '') : '';
$config = $loaded->config->withTtyModeResolved(null, str_starts_with($tty, '/dev/tty'));
// btop Theme::updateThemes: the list the options menu cycles (rescanned on ctrl+r).
$catalog = ThemeRegistry::new();
// btop launch flags -p/-t/-u (S-O06): session-only overrides — they steer this
// run but never reach the config file (Config::persistedValue keeps the file's
// bytes). Applied before the accelerator probe so a preset's gpu boxes settle
// exactly like the file's shown_boxes would; a ctrl+r reload takes the file
// wholesale and ends them.
if ($updateMs !== null) {
    // The parser guarantees digits; the clamp is Schema's floor/ceiling (btop clamps too).
    $config = $config->withSessionUpdateMs($updateMs);
}
if ($themeArg !== null) {
    // Refused here, not at load: the palette loader silently falls back to the
    // default theme on a miss, which would paint over the user's typo.
    $entry = $catalog->find($themeArg);
    if ($entry === null) {
        $report(Lang::t('cli.theme_unknown', ['theme' => $themeArg]));
        exit(2);
    }
    $config = $config->withSessionOverrides(['color_theme' => $catalog->configValue($entry)]);
}
if ($presetIndex !== null) {
    try {
        $preset = $config->presets()->at($presetIndex);
    } catch (\OutOfRangeException) {
        $report(Lang::t('cli.preset_unknown', ['index' => $presetIndex]));
        exit(2);
    }
    $config = $config->withSessionPreset($preset);
}

// btop picks its collector per OS at compile time; candy-top per PHP_OS here.
$platform = Platform::detect();
$host = $platform->hostInfo();
// --fake shows a fake BMC (FakeIpmi), so it offers the ipmi box's title button too.
$host = $fake ? $host->withBmcHost(true) : $host;
// btop Shared::init → Gpu::init: the accelerators are known before shown_boxes
// is settled (a gpuN beyond them resets the list) and before the first frame,
// so the gpu slot keys 5-0 work at once. One bounded sample, outside the loop.
$gpuProbe = $fake ? null : GpuPanel::probe($config, $platform);
$detected = $fake ? FakeGpu::new()->count() : count($gpuProbe?->accelerators() ?? []);
// A layout this machine cannot show resets to the defaults (m28): say so, on
// the same sanitized channel every other startup notice uses, before the reset
// is what the next save persists.
if (($boxReset = $config->shownBoxesSettlement($detected)) !== null) {
    $report($boxReset);
}
$config = $config->withShownBoxesSettled($detected);
$palette = $catalog->load($config->colorTheme(), $config->bool('theme_background'), $config->ttyMode());
$panels = Panels::standard($host, $config, $fake, $platform, $gpuProbe);
// btop PR #1791c, proc_tree_persist_state: remembered tree collapse choices live in
// $XDG_STATE_HOME/candy-top/tree-state.json (never config.conf). Loaded even
// with the option off, so turning it on mid-session restores them and a later
// save cannot drop them; an unusable file loads empty.
$statePath = TreeStateFile::defaultPath();
if ($statePath !== null && ($panels['proc'] ?? null) instanceof ProcPanel) {
    $stateFile = TreeStateFile::new($statePath);
    $panels['proc'] = $panels['proc']->withTreeStore($stateFile, $stateFile->load(time()));
}
// btop `lowcolor`: the 256-colour cube whenever truecolor is off.
$config = $config->with('lowcolor', !$config->bool('truecolor'));

$program = new Program(
    App::start(
        $config,
        $palette,
        $host,
        $panels,
        file: $file,
        writeNew: $loaded->needsRewrite,
        catalog: $catalog,
        // btop compiles a macOS/OpenBSD collector; candy-top ships none —
        // say so up front instead of painting a silent all-n/a monitor.
        unsupportedOs: $platform->isSupported() ? null : $platform->os,
    ),
    App::programOptions($config),
);
// btop's SIGTERM / SIGHUP handlers run clean_quit (config save included);
// sugar-core's Program traps only SIGINT, so stop its loop here and let
// the post-run save below do the write after the terminal is restored.
$trapped = function_exists('pcntl_signal') ? [SIGTERM, SIGHUP] : [];
if ($trapped !== [] && function_exists('pcntl_async_signals')) {
    pcntl_async_signals(true);
}
foreach ($trapped as $signal) {
    pcntl_signal($signal, static function () use ($program): void {
        $program->kill();
    });
}
try {
    $final = $program->run();
} catch (\Throwable $e) {
    // A crash out of update()/view()/a Cmd escapes run() without its
    // terminal teardown: put the terminal back (best effort — on a hung-up
    // tty the writes just fail), still save what the user changed, then
    // rethrow so PHP prints the error and trace on a usable screen.
    // releaseTerminal() also leaves raw mode, so the trace isn't staircased;
    // the raw reset bytes are the fallback when that teardown throws.
    try {
        $program->releaseTerminal();
    } catch (\Throwable) {
        @fwrite(STDOUT, App::terminalReset());
        @fflush(STDOUT);
    }
    $crashed = $program->model();
    if ($crashed instanceof App) {
        $saved = ($crashed->exitSave())?->__invoke();
        if ($saved instanceof ConfigSavedMsg && !$saved->ok) {
            $report($saved->error);
        }
        $state = ($crashed->stateSave())?->__invoke();
        if ($state instanceof TreeStateSavedMsg && !$state->ok) {
            $report($state->error);
        }
    }

    throw $e;
} finally {
    // From here a signal must act normally again, not be swallowed by a
    // handler whose program has stopped.
    foreach ($trapped as $signal) {
        pcntl_signal($signal, SIG_DFL);
    }
}
// Every App quit path saves through its own Cmd; a signal-driven exit
// bypasses update(), and a quit-time save that failed leaves the flag set,
// so btop's clean_quit save runs (again) here — after the alt screen is
// gone, so a failure can be reported where the user sees it.
if ($final instanceof App) {
    // Same order as the crash path and App::quitCmd(): config, then tree state.
    $saved = ($final->exitSave())?->__invoke();
    if ($saved instanceof ConfigSavedMsg && !$saved->ok) {
        $report($saved->error);
    }
    // The tree state is a convenience: a failed write is reported, never fatal.
    $state = ($final->stateSave())?->__invoke();
    if ($state instanceof TreeStateSavedMsg && !$state->ok) {
        $report($state->error);
    }
    if ($saved instanceof ConfigSavedMsg && !$saved->ok) {
        exit(1);
    }
}
