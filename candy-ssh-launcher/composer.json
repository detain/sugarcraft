{
    "name": "sugarcraft/candy-ssh-launcher",
    "description": "SSH endpoint launcher \u2014 a TUI directory of `ssh user@host` shortcuts. Port of charmbracelet/wishlist. Loads endpoints from YAML/JSON, renders an interactive picker, then `exec`s into the chosen ssh client (with full host-key prompt / agent forwarding fidelity).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sugarcraft",
        "wishlist",
        "ssh",
        "launcher",
        "directory",
        "tui",
        "charm",
        "picker"
    ],
    "homepage": "https://github.com/sugarcraft/candy-ssh-launcher",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-ssh-launcher/issues",
        "source": "https://github.com/sugarcraft/candy-ssh-launcher",
        "docs": "https://sugarcraft.github.io/lib/candy-ssh-launcher.html"
    },
    "bin": [
        "bin/candy-ssh-launcher"
    ],
    "require": {
        "php": ">=8.3",
        "ext-pcntl": "*",
        "sugarcraft/candy-core": "dev-master",
        "sugarcraft/candy-fuzzy": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\SshLauncher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\SshLauncher\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
