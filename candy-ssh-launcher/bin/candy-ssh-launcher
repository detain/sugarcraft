#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * `candy-ssh-launcher` — SSH endpoint picker.
 *
 *   candy-ssh-launcher [--config <path>] [--ssh <ssh-binary>] [--list]
 *                      [-h|--help] [-v|--version] [--] [endpoint]
 *
 * Without `--config` the search order is: `wishlist.yml`,
 * `wishlist.yaml`, `wishlist.json` in the CURRENT DIRECTORY first,
 * then `$XDG_CONFIG_HOME/wishlist.{yml,yaml,json}` (`~/.config` when XDG
 * is unset) — first candidate that EXISTS wins at each tier.
 * Auto-discovered files face a trust gate: a config owned by another user
 * or writable by group/world is refused by name (OpenSSH StrictModes
 * precedent), a one-line notice marks every run where the CWD tier wins,
 * and `--config` skips the gate on purpose — naming a path is consent.
 * `--ssh` must be an existing executable PATH; without the flag the binary
 * resolves through `SSH_LAUNCHER_SSH`, then the candidate list
 * (`/usr/bin/ssh`, `/run/current-system/sw/bin/ssh`, `/opt/homebrew/bin/ssh`),
 * then the default
 * (`pcntl_exec` performs no `$PATH` search — a bare name like `ssh` fails
 * loudly at the gate below; relative paths resolve against the CWD).
 * `--list` prints the resolved endpoints and exits 0 without touching the
 * terminal or ssh — it stays safe to drive from pipes. An optional
 * positional names an endpoint: exactly one match dispatches it directly
 * (all exit-3 guards honored, no terminal needed); an ambiguous or unknown
 * name falls back to the picker (prefilled with the matches when the name
 * is ambiguous). A config row may carry `command:` to replace the ssh
 * binary for itself — the transport passes the same exists-and-executable
 * gate, and any ssh-only leg it cannot carry is announced on stderr. The
 * interactive
 * picker demands a real terminal on BOTH stdin and stdout (a piped run is
 * refused with exit 2, because on a pipe its frames are painted into the
 * wire and any pre-typed line dispatches ssh unattended). On Enter, the
 * picker replaces the current process with `ssh` (or the endpoint's
 * `command`) connecting to the chosen entry; Esc/Ctrl+C exits 130, a broken or empty config exits 1 — except
 * that `--list` on a zero-endpoint config prints nothing and exits 0 — a
 * bad argument or a non-terminal interactive run exits 2, and a field
 * refused at dispatch time (or a failed exec) exits 3 with a sanitized
 * stderr line.
 */

use SugarCraft\Core\I18n\T;
use SugarCraft\Core\Util\Sanitize;
use SugarCraft\SshLauncher\Config;
use SugarCraft\SshLauncher\Endpoint;
use SugarCraft\SshLauncher\Lang;
use SugarCraft\SshLauncher\Launcher;
use SugarCraft\SshLauncher\Picker;

// ---------------------------------------------------------------------------
// Autoloader (archive-aware). A phar build stamps THIS file as the archive
// stub, so under `php candy-ssh-launcher.phar` __FILE__ names the archive and
// the bundled vendor/ inside it is the only correct source. Measured PHP 8.3
// law: in the stub context \Phar::running(false) answers '' (so a bare
// '/x.phar/entry' path — and any 'phar://'.running() — fails to locate it),
// while a required-from-inside file reports the archive via running(false).
// Handle BOTH identities, and once an archive is found DROP the filesystem
// candidates — a working-tree vendor beside a published .phar must never win.
// The three existing fallback candidates (package root, sibling checkout,
// monorepo parent) are preserved for every non-archive invocation.
// ---------------------------------------------------------------------------
(static function (): void {
    $archive = str_ends_with(__FILE__, '.phar')
        ? 'phar://' . __FILE__
        : (\Phar::running(false) !== '' ? 'phar://' . \Phar::running(false) : '');
    $candidates = $archive !== ''
        ? [$archive . '/vendor/autoload.php']
        : [
            __DIR__ . '/../vendor/autoload.php',
            __DIR__ . '/../../vendor/autoload.php',
            __DIR__ . '/../../../vendor/autoload.php',
        ];
    foreach ($candidates as $candidate) {
        if (is_file($candidate)) {
            require $candidate;
            return;
        }
    }
    fwrite(STDERR, "candy-ssh-launcher: could not find composer autoloader\n");
    exit(1);
})();

// ---------------------------------------------------------------------------
// Locale activation
// ---------------------------------------------------------------------------
// T::setLocale(T::detect()) reads LC_ALL → LC_MESSAGES → LANG. Without it
// every Lang::t() below would print the English default regardless of the
// user's locale (house pattern, matches every other candy-* bin; the
// lang/ files have shipped translations since the rename era).
T::setLocale(T::detect());

// ---------------------------------------------------------------------------
// CLI argument parsing
// ---------------------------------------------------------------------------
// Hand-rolled instead of getopt() on purpose: PHP's getopt silently stops
// at the first unrecognised option (a `--confg` typo would sail through on
// defaults), mis-handles valueless long flags given as `--help=1` in a
// version-flaky way, and gives no diagnostics for `--config` with no
// value. Every token is judged here; the first bare token is the -027
// endpoint name, a second one is refused as an unknown argument, and
// anything after a bare `--` is ignored (the terminator stays a
// terminator — it ends option parsing, it does not introduce positionals).
$fail = static function (string $message, int $code): never {
    fwrite(STDERR, $message . "\n");
    exit($code);
};

$cfgPath = '';
$sshBin = ''; // resolved after parsing: --ssh > SSH_LAUNCHER_SSH > candidates > DEFAULT_SSH
$wantList = false;
$wantName = ''; // -027: first bare positional — exact-unique match dispatches directly

$tokens = array_slice($argv, 1);
$count = count($tokens);
for ($i = 0; $i < $count; $i++) {
    $token = (string) $tokens[$i];

    if ($token === '--') {
        // End of options: the remainder is not read.
        break;
    }

    if (!str_starts_with($token, '-')) {
        if ($wantName === '') {
            $wantName = $token;
            continue;
        }
        $fail(Lang::t('cli.unknown_arg', ['arg' => Sanitize::untrusted($token)]), 2);
    }

    // Split `--name=value` from `--name value` uniformly; the glued form
    // supplies its own value (possibly empty → refused below).
    $eq = strpos($token, '=');
    $name = $eq === false ? $token : substr($token, 0, $eq);

    if ($name === '-h' || $name === '--help') {
        // Help wins before anything else can fail, in every form.
        fwrite(STDOUT, Lang::t('cli.usage') . "\n");
        exit(0);
    }

    if ($name === '-v' || $name === '--version') {
        // Version prints before anything else can fail — no config read, no
        // HOME guard, no terminal touch. Under a running archive the build
        // stamp wins (InstalledVersions lies under the frozen vendor/ copy);
        // outside one the compiled-in Support\Version::CURRENT fallback answers.
        $archive = str_ends_with(__FILE__, '.phar')
            ? __FILE__
            : (\Phar::running(false) ?: '');
        fwrite(STDOUT, 'candy-ssh-launcher '
            . \SugarCraft\SshLauncher\Support\Version::resolve($archive) . "\n");
        exit(0);
    }

    if ($name === '--list') {
        $wantList = true;
        continue;
    }

    if ($name !== '--config' && $name !== '--ssh') {
        // Unknown flags name the FULL token (glued value included) so the
        // user sees exactly what the program choked on.
        $fail(Lang::t('cli.unknown_arg', ['arg' => Sanitize::untrusted($token)]), 2);
    }

    if ($eq !== false) {
        $value = substr($token, $eq + 1);
        if ($value === '') {
            $fail(Lang::t('cli.missing_value', ['arg' => Sanitize::untrusted($token)]), 2);
        }
    } else {
        $next = $tokens[$i + 1] ?? null;
        if ($next === null || str_starts_with((string) $next, '-')) {
            $fail(Lang::t('cli.missing_value', ['arg' => Sanitize::untrusted($token)]), 2);
        }
        $i++;
        $value = (string) $next;
    }

    if ($name === '--config') {
        $cfgPath = $value;
    } else {
        $sshBin = $value;
    }
}

// ---------------------------------------------------------------------------
// Config file search (with HOME guard)
// ---------------------------------------------------------------------------
if ($cfgPath === '') {
    $home = getenv('HOME');
    $candidates = [];
    // Always check CWD first
    foreach (['wishlist.yml', 'wishlist.yaml', 'wishlist.json'] as $name) {
        if (is_file($name)) {
            $candidates[] = $name;
        }
    }
    // Only add the base-directory candidates when HOME is set and
    // non-empty to prevent probing '/.config/wishlist.yml' when HOME is
    // unset. $XDG_CONFIG_HOME relocates the base (sibling bins do the
    // same; upstream wishlist rides viper, which is XDG-first).
    // Both tiers are existence-gated (2026-10-23): the HOME candidates used
    // to be appended WITHOUT is_file, so a missing ~/.config/wishlist.yml
    // shadowed a valid wishlist.yaml sibling and the run died on
    // 'not found' for a path nobody had asked for.
    if ($home !== false && $home !== '') {
        $xdg = getenv('XDG_CONFIG_HOME');
        $base = (is_string($xdg) && $xdg !== '') ? $xdg : $home . '/.config';
        foreach (['wishlist.yml', 'wishlist.yaml', 'wishlist.json'] as $name) {
            $path = $base . '/' . $name;
            if (is_file($path)) {
                $candidates[] = $path;
            }
        }
    }
    if ($candidates === []) {
        $fail(Lang::t('cli.no_config'), 1);
    }
    $cfgPath = $candidates[0];

    // Trust gate on auto-discovered configs (OpenSSH StrictModes precedent):
    // the CWD tier is the file an attacker can plant most easily — a repo
    // tarball row with `options: [ProxyCommand=...]` would otherwise win the
    // ladder silently. A config owned by another user, or writable by the
    // group or the world, is refused by name. A config passed via --config
    // skips this gate ON PURPOSE: naming a path is consent.
    $stat = @stat($cfgPath);
    if (is_array($stat)) {
        $fileUid   = (int) $stat['uid'];
        $myUid     = function_exists('posix_geteuid') ? posix_geteuid() : (int) getmyuid();
        $ownPerms  = (int) $stat['mode'] & 0o022;
        if ($fileUid !== $myUid && $fileUid !== 0) {
            $fail(Lang::t('cli.config_unowned', ['path' => Sanitize::untrusted($cfgPath)]), 1);
        }
        if ($ownPerms !== 0) {
            $fail(Lang::t('cli.config_writable', ['path' => Sanitize::untrusted($cfgPath)]), 1);
        }
    }
    if ($cfgPath === 'wishlist.yml' || $cfgPath === 'wishlist.yaml' || $cfgPath === 'wishlist.json') {
        // The CWD tier won — say so, one line on stderr, then proceed.
        $cwd = getcwd();
        fwrite(STDERR, Lang::t('cli.project_local', [
            'path' => Sanitize::untrusted((is_string($cwd) ? $cwd : '') . '/' . $cfgPath),
        ]) . "\n");
    }
}

// ---------------------------------------------------------------------------
// SSH binary resolution: --ssh wins; else SSH_LAUNCHER_SSH; else the
// candidate list; else DEFAULT_SSH — the gate below judges the result and
// refuses honestly when no candidate is an executable file. A PATH search is
// deliberately NOT performed: pcntl_exec receives exactly what the gate
// vetted, so a hostile PATH cannot swap the binary mid-lane.
// ---------------------------------------------------------------------------
if ($sshBin === '') {
    $envSsh = getenv('SSH_LAUNCHER_SSH');
    if (is_string($envSsh) && $envSsh !== '') {
        $sshBin = $envSsh;
    } else {
        $sshBin = Launcher::firstExecutableSsh() ?? Launcher::DEFAULT_SSH;
    }
}

// ---------------------------------------------------------------------------
// SSH binary validation (--list never launches anything, so it never
// requires ssh to exist)
// ---------------------------------------------------------------------------
if (!$wantList && (!is_file($sshBin) || !is_executable($sshBin))) {
    $fail(Lang::t('cli.ssh_not_executable', ['bin' => Sanitize::untrusted($sshBin)]), 1);
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
try {
    $endpoints = Config::load($cfgPath);
} catch (\Throwable $e) {
    // Config errors echo bytes taken from the file itself (paths, YAML
    // fragments) — the stderr channel wraps them as untrusted so a hostile
    // config cannot forge terminal control sequences through the error
    // report (docs/TRUST-BOUNDARY.md).
    $fail(Lang::t('cli.error', ['message' => Sanitize::untrusted($e->getMessage())]), 1);
}

if ($wantList) {
    // -003: the documented TSV contract says one physical row per endpoint
    // and exactly two field tabs. Sanitize::untrusted() KEEPS CR/LF/TAB for
    // paste fidelity, so a config name carrying a newline forged a phantom
    // second row and a tab shifted every column. The columns go through the
    // display policy and fold the line bytes to spaces — the same discipline
    // the picker applies in stripControls() (docs/TRUST-BOUNDARY.md).
    $display = static fn (string $value): string => str_replace(
        ["\t", "\r", "\n"],
        ' ',
        Sanitize::untrustedForDisplay($value)
    );

    // -078's pairing with the duplicate-name warning (config.duplicate_name):
    // both rows still print, suffixed with their 1-based config index so an
    // `awk -F'\t'` consumer can address either one by name.
    $nameCounts = [];
    foreach ($endpoints as $endpoint) {
        $folded = $display($endpoint->name);
        $nameCounts[$folded] = ($nameCounts[$folded] ?? 0) + 1;
    }

    foreach ($endpoints as $index => $endpoint) {
        $name = $display($endpoint->name);
        if ($nameCounts[$name] > 1) {
            $name .= '#' . ($index + 1);
        }
        // -078: a set-but-empty user prints exactly like an unset one.
        $user = $endpoint->user;
        fwrite(STDOUT, $name . "\t"
            . $display($endpoint->host) . ':' . $endpoint->port . "\t"
            . ($user !== null && $user !== '' ? $display($user) : '-') . "\n");
    }
    exit(0);
}

// An empty (or wholly-commented) config is a config problem, not a user
// abort: saying 'cancelled.' with 130 made the two indistinguishable
// (2026-10-23).
if ($endpoints === []) {
    $fail(Lang::t('cli.no_endpoints', ['path' => Sanitize::untrusted($cfgPath)]), 1);
}

// -027: a positional name addresses an endpoint directly. Exact-unique
// wins without touching the terminal (all exit-3 guards still run — the
// dispatch below is the same path the picker feeds). An ambiguous name
// (possible: -12 only warns on duplicates) opens the picker pre-filtered
// to the matches; an unknown name falls back to the full picker rather
// than dying on a typo — the user sees the list they meant to browse.
$pick = null;
$pool = $endpoints;
if ($wantName !== '') {
    $matches = array_values(array_filter(
        $endpoints,
        static fn (Endpoint $endpoint): bool => $endpoint->name === $wantName
    ));
    if (count($matches) === 1) {
        $pick = $matches[0];
    } elseif (count($matches) > 1) {
        $pool = $matches;
    }
}

if ($pick === null) {
    // The picker draws frames and steers on keystrokes: with stdin a pipe,
    // any buffered line completes a selection and DISPATCHES ssh unattended
    // (measured: `printf 'prod\r' | bin --ssh /bin/echo` exited 0 and exec'd),
    // and a stdout redirect paints raw cursor escape bytes into the wire. The
    // interactive path therefore requires both ends to be TTYs; the --list,
    // --help and --version legs above (and -027's exact-name dispatch)
    // deliberately stay pipe-safe.
    if (!stream_isatty(STDIN) || !stream_isatty(STDOUT)) {
        $fail(Lang::t('cli.not_a_terminal'), 2);
    }
    $pick = (new Picker())->pick($pool);
    if ($pick === null) {
        fwrite(STDERR, Lang::t('cli.cancelled') . "\n");
        exit(130);
    }
}

// -029: name the host-key-trust-destruction family on the way out. The
// config is trusted input, but a MITM payload inside a trusted file still
// looks like a normal login — so every degrading `-o` request gets one
// stderr line BEFORE the exec, naming the option and what it costs. The
// {option} column passes the display policy (an escaped CR/LF inside a
// double-quoted scalar must not forge a second stderr line); the effect
// clauses are trusted lang.
$unsafeEffects = [
    'StrictHostKeyChecking'  => 'cli.unsafe_option_effect_strict_host_key_checking',
    'UserKnownHostsFile'     => 'cli.unsafe_option_effect_user_known_hosts_file',
    'GlobalKnownHostsFile'   => 'cli.unsafe_option_effect_global_known_hosts_file',
    'LogLevel'               => 'cli.unsafe_option_effect_log_level',
    'IdentityAgent'          => 'cli.unsafe_option_effect_identity_agent',
    'CertificateFile'        => 'cli.unsafe_option_effect_certificate_file',
];
foreach ($pick->unsafeOptions() as $opt) {
    $eq   = strpos($opt, '=');
    $key  = $eq === false ? $opt : substr($opt, 0, $eq);
    $effectKey = $unsafeEffects[$key] ?? null;
    if ($effectKey === null) {
        continue; // unreachable: unsafeOptions() only yields the six keys above
    }
    fwrite(STDERR, Lang::t('cli.unsafe_option_notice', [
        'option' => Sanitize::untrustedForDisplay($opt),
        'effect' => Lang::t($effectKey),
    ]) . "\n");
}

// A refused endpoint (leading-dash or empty field) and a failed exec both
// surface here as a named, sanitized line — they must not escape as a raw
// stack trace (F-6); exit 3 distinguishes them from config errors (1) and
// bad arguments (2).
try {
    (new Launcher())->dispatch($pick, $sshBin);
} catch (\Throwable $e) {
    $fail(Lang::t('cli.error', ['message' => Sanitize::untrusted($e->getMessage())]), 3);
}
