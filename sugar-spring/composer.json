{
    "name": "sugarcraft/sugar-spring",
    "description": "PHP port of charmbracelet/harmonica \u2014 damped spring physics + Newtonian projectile simulation for terminal animation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "physics",
        "spring",
        "animation",
        "projectile",
        "tui",
        "terminal",
        "harmonica",
        "ryan-juckett",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-spring",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-spring/issues",
        "source": "https://github.com/sugarcraft/sugar-spring",
        "docs": "https://sugarcraft.github.io/lib/sugar-spring.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/candy-core": "dev-master",
        "sugarcraft/candy-palette": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/candy-testing": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Spring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Spring\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
