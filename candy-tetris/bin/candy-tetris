#!/usr/bin/env php
<?php

declare(strict_types=1);

use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Core\Util\ColorProfile;
use SugarCraft\Tetris\Game;
use SugarCraft\Tetris\LaunchMode;
use SugarCraft\Tetris\Support\Version;
use SugarCraft\Tetris\VsGame;

(static function () {
    // Guard shape ported from candy-code/candy-top (DST-1, measured on PHP
    // 8.3.6): when `php candy-tetris.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Two identities cover the two phar
    // shapes: the stub names itself in __FILE__, and a require-from-inside
    // names the archive in Phar::running(). Both are addressed the only way
    // that works, as a phar:// URI. When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-tetris: cannot find composer autoload.php\n");
    exit(1);
})();

// UI language from $LANG / $LC_ALL (matters only once non-en catalogues
// exist; 'en' values are byte-identical to the literals they replaced).
\SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());

// The version line answers before the argv contract: `--version` is not a
// game flag and must not reach the unknown-mode refusal in LaunchMode.
if (in_array('--version', array_slice($argv ?? [], 1), true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}

try {
    $mode = LaunchMode::resolve($argv);
} catch (InvalidArgumentException $problem) {
    fwrite(STDERR, $problem->getMessage() . "\n\n" . LaunchMode::helpText());
    exit(1);
}

if ($mode === LaunchMode::HELP) {
    fwrite(STDOUT, LaunchMode::helpText());
    exit(0);
}

$game = match ($mode) {
    LaunchMode::VS => VsGame::start(),
    // Single-player enables lock delay so a grounded piece can still be
    // nudged/rotated for a short window before it locks (W15 / SRS QoL).
    default => Game::startWithLockDelay(),
};

// MA-12: one capability profile, probed once at launch, drives BOTH the
// alt-screen contract and the model's colour posture. A NoTty terminal
// (pipe, TERM=dumb) never gets raw alt-screen/SGR bytes it cannot parse —
// the renderer answers with a plain refusal instead — and ColorProfile::detect()
// already folds NO_COLOR/CLICOLOR into Ascii, which Program delivers to the
// model as ColorProfileMsg so the view drops every escape as well.
$profile = ColorProfile::detect();
$options = new ProgramOptions(
    useAltScreen: $profile !== ColorProfile::NoTty,
    colorProfile: $profile,
);
(new Program($game, $options))->run();
