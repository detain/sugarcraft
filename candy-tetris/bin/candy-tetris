#!/usr/bin/env php
<?php

declare(strict_types=1);

use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Core\Util\ColorProfile;
use SugarCraft\Tetris\Game;
use SugarCraft\Tetris\LaunchMode;
use SugarCraft\Tetris\Support\Version;
use SugarCraft\Tetris\Support\Bindings;
use SugarCraft\Tetris\Support\KeyMap;
use SugarCraft\Tetris\Support\Paths;
use SugarCraft\Tetris\Support\Scores;
use SugarCraft\Tetris\VsGame;

(static function () {
    // Extension floor (candy-tetris-057): a downloaded phar runs through
    // no composer gate, and the width/segmentation math in sugar-core
    // (INTL + ICU) fatals obscurely mid-boot on a bare host. Name the
    // missing extensions in one plain line before anything loads. The
    // manifest now self-describes the same floor (require ext-mbstring
    // + ext-intl), so composer installs refuse at the door instead.
    $missing = array_values(array_filter(
        ['mbstring', 'intl'],
        static fn (string $ext): bool => !extension_loaded($ext),
    ));
    if ($missing !== []) {
        fwrite(STDERR, 'candy-tetris needs the PHP extension(s): ' . implode(', ', $missing) . ".\n");
        exit(1);
    }

    // Guard shape ported from candy-code/candy-top (measured on PHP
    // 8.3.6): when `php candy-tetris.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Three identities cover the phar
    // shapes: the require-from-inside answer in Phar::running(), the stub
    // self-naming a genuine .phar in __FILE__, and — for a RENAMED phar
    // (`mv candy-tetris.phar tetris`, the shape many users pick) — the
    // magic bytes, which Phar::loadPhar() reads without trusting any
    // suffix (candy-tetris-056). When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout all
    // three probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $running = \Phar::running(false);
    $archive = $running !== ''
        ? 'phar://' . $running
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive === '') {
        try {
            // Magic-bytes probe: loadPhar answers true only for real
            // archives; on a plain checkout file it THROWS PharException
            // ("__HALT_COMPILER(); not found") — that refusal is the
            // expected composer-mode answer, swallowed here.
            if (@\Phar::loadPhar(__FILE__, 'candy-tetris') === true) {
                $archive = 'phar://' . __FILE__;
            }
        } catch (\Throwable) {
            $archive = '';
        }
    }
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-tetris: cannot find composer autoload.php\n");
    exit(1);
})();

/**
 * One-line clamp for startup notices (mirrors the candy-minesweeper
 * stats-notice shape): control bytes are replaced so a filename from
 * the environment can never smuggle escapes into the terminal.
 */
function cliVisible(string $raw): string
{
    $clean = preg_replace('/[\x00-\x1f\x7f]/', '?', $raw);
    return strlen($clean) > 40 ? substr($clean, 0, 39) . '…' : $clean;
}

// UI language from $LANG / $LC_ALL. Fifteen non-en catalogues ship, so
// this is load-bearing today; the 'en' values stay byte-identical to the
// literals the first i18n pass replaced.
\SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());

// The version line answers before the argv contract: `--version` is not a
// game flag and must not reach the unknown-mode refusal in LaunchMode.
if (in_array('--version', array_slice($argv ?? [], 1), true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}

try {
    $mode = LaunchMode::resolve($argv);
} catch (InvalidArgumentException $problem) {
    // Exempt by context: a refusal that does not name the flag the user
    // typed is not diagnosable, so the message interpolates raw argv (see the
    // throws in LaunchMode::resolve()). The bytes are the caller's own
    // argv printed straight back to their terminal, once, at startup — this
    // path writes no log and paints no frame, so nothing can replay them.
    fwrite(STDERR, $problem->getMessage() . "\n\n" . LaunchMode::helpText());
    exit(1);
}

if ($mode === LaunchMode::HELP) {
    fwrite(STDOUT, LaunchMode::helpText());
    exit(0);
}

// The live key map. A missing file leaves the shipped table
// byte-identical; an unreadable one is ignored LOUDLY on stderr and the
// game still launches on defaults — never silently on half a map.
try {
    $bindings = KeyMap::load(Paths::keys(), Bindings::table());
} catch (Throwable $problem) {
    fwrite(STDERR, 'candy-tetris: ignoring unreadable keys file (' . cliVisible($problem->getMessage()) . ")\n");
    $bindings = Bindings::table();
}

// The cross-session record. A missing file is no record yet
// (behavior byte-identical to a launch with no record wired); a corrupt one is
// announced LOUDLY and the game starts fresh without ever zeroing the
// old file — a save failure refuses, it does not overwrite.
$scoresPath = Paths::scores();
$scores = null;
if ($scoresPath !== null) {
    try {
        $scores = Scores::load($scoresPath) ?? new Scores();
    } catch (Throwable $problem) {
        fwrite(STDERR, 'candy-tetris: ignoring unreadable scores file (' . cliVisible($problem->getMessage()) . ")\n");
        $scores = new Scores();
    }
}

$game = match ($mode) {
    LaunchMode::VS => VsGame::start($bindings, $scores, $scoresPath),
    // Single-player enables lock delay so a grounded piece can still be
    // nudged/rotated for a short window before it locks (SRS lock delay).
    // A solo launch whose record has never seen the on-ramp opens
    // on the card. Without a resolvable HOME the mark cannot be written,
    // so the card honestly re-shows every launch rather than lying once.
    default => Game::startWithLockDelay(
        bindings: $bindings,
        scores: $scores,
        scoresPath: $scoresPath,
        introPending: $scores === null || $scores->onboarded === false,
    ),
};

// One capability profile, probed once at launch, drives BOTH the
// alt-screen contract and the model's colour posture. STDOUT is passed so
// detect() can see a pipe or redirect: without the handle its isatty rung
// never runs and a redirected launch was classified by TERM alone, painting
// the alt-screen and full frames into the file. ColorProfile::detect() also
// folds NO_COLOR/CLICOLOR into Ascii, which Program delivers to the model as
// ColorProfileMsg so the view drops every escape as well.
$profile = ColorProfile::detect(null, STDOUT);

// A game nobody can see or steer is refused before the Program starts,
// with plain text on stderr and exit 1. The loop's gravity timer never lets
// it end on its own, so a keyless launch (stdin a pipe or /dev/null) or a
// NoTty screen (stdout redirected, TERM=dumb) used to run until killed.
// A truthy CLICOLOR_FORCE/FORCE_COLOR still lets stdout be a pipe (detect()
// answers a real profile then); stdin must be a terminal regardless.
if (!stream_isatty(STDIN) || $profile === ColorProfile::NoTty) {
    fwrite(STDERR, \SugarCraft\Tetris\Lang::t('cli.no_tty') . "\n");
    exit(1);
}

$options = new ProgramOptions(
    useAltScreen: $profile !== ColorProfile::NoTty,
    colorProfile: $profile,
);
(new Program($game, $options))->run();
