#!/usr/bin/env php
<?php

declare(strict_types=1);

use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Tetris\Game;
use SugarCraft\Tetris\LaunchMode;
use SugarCraft\Tetris\VsGame;

(static function () {
    foreach (['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
        $path = str_starts_with($candidate, '/') ? $candidate : __DIR__ . '/../' . $candidate;
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-tetris: cannot find composer autoload.php\n");
    exit(1);
})();

try {
    $mode = LaunchMode::resolve($argv);
} catch (InvalidArgumentException $problem) {
    fwrite(STDERR, $problem->getMessage() . "\n\n" . LaunchMode::helpText());
    exit(1);
}

if ($mode === LaunchMode::HELP) {
    fwrite(STDOUT, LaunchMode::helpText());
    exit(0);
}

$game = match ($mode) {
    LaunchMode::VS => VsGame::start(),
    // Single-player enables lock delay so a grounded piece can still be
    // nudged/rotated for a short window before it locks (W15 / SRS QoL).
    default => Game::startWithLockDelay(),
};

$options = new ProgramOptions(useAltScreen: true);
(new Program($game, $options))->run();
