# Test fixtures are byte-exact snapshot data. Never apply EOL conversion:
# on Windows checkouts (core.autocrlf=true on GitHub's windows runners) LF
# would be rewritten to CRLF, corrupting the bytes so golden comparisons
# fail against the renderer's LF output. See candy-shine / sugar-table
# GoldenRenderTest + RendererTest.
**/tests/fixtures/** -text

# Belt-and-suspenders for snapshot files wherever they live.
*.golden -text
*.ansi   -text
*.tape   -text

# The prompt goldens pin sample `git diff` output, whose context line for a
# blank source line is a single space. Those bytes are the fixture, so
# `git diff --check` must not report them as trailing whitespace. Added by
# the Phase 2 close (3d7c7e420), which OVERWROTE this file instead of
# appending and so deleted every rule above it; restored 2026-08-29.
sugar-crush/tests/fixtures/prompt/** whitespace=-trailing-space
