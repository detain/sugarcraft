#!/usr/bin/env php
<?php

declare(strict_types=1);

use SugarCraft\ScriptUi\Application;

// Walk up to find the right vendor/autoload.php whether the lib is the
// top-level project or a Composer dependency.
$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',     // dev: candy-scriptui standalone
    __DIR__ . '/../../../autoload.php',      // installed under vendor/bin
    __DIR__ . '/../../vendor/autoload.php',  // monorepo dev
];

// Phar-launch guard (shape ported from candy-code/candy-top, measured on PHP 8.3.6):
// when `php candy-scriptui.phar` runs, THIS file is the archive's stub and
// Phar::running() answers '' in exactly that context, while a bare
// '/x.phar/entry' path fails is_file()/require for every caller. Two identities
// cover the two phar shapes — the stub names itself in __FILE__, a
// require-from-inside names the archive in Phar::running() — and both are
// addressed the only way that works: a phar:// URI. Inside an archive the
// packaged vendor is the EXCLUSIVE root (a stray vendor beside the phar must
// never boot code the frozen archive does not contain), so the candidate walk
// below is skipped entirely; in every composer-mode checkout both identities
// are '' and the walk is byte-untouched.
$archive = \Phar::running(false) !== ''
    ? 'phar://' . \Phar::running(false)
    : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
if ($archive !== '') {
    $pharAutoload = $archive . '/vendor/autoload.php';
    if (!is_file($pharAutoload)) {
        \fwrite(\STDERR, "candy-scriptui: the archive has no vendor/autoload.php — the phar was built without a packaged vendor.\n");
        exit(1);
    }
    require $pharAutoload;
} else {
    foreach ($autoloadCandidates as $autoload) {
        if (file_exists($autoload)) {
            require $autoload;
            $bootedFrom = $autoload;
            break;
        }
    }
    if (!isset($bootedFrom)) {
        // A silent fall-through here produced the baffling
        // "Class 'SugarCraft\Core\Util\LegacyEnv' not found" fatal; the phar
        // branch above already answers loudly, so this branch must too.
        \fwrite(\STDERR, "candy-scriptui: no vendor/autoload.php found — run 'composer install' (or install via composer require).\n");
        exit(1);
    }
}

// Locale wiring: seventeen catalogs ship with this app (en source-of-truth
// plus sixteen translations); without this
// call they are dead weight (the process default is 'en'). T::detect()
// reads LC_ALL → LC_MESSAGES → LANG, strips encoding suffixes and
// lowercases; T::translate() then falls back territory → base language →
// English, so de_DE.UTF-8 lands on lang/de.php and pt_BR on lang/pt-br.php.
// scriptui-79 (finding 112): native Windows cmd/PowerShell export NONE of
// those variables, so every Windows user got English on a claimed platform.
// When no language env exists at all, seed LANG from intl's default locale
// (which reflects the Win32 user locale; on POSIX hosts it answers en-US
// unless the admin set intl.default_locale, so non-Windows behaviour is
// unchanged in practice). No env set, no intl, or a default nobody recognises
// → English, exactly as before.
if (!isset($_SERVER['LC_ALL']) && getenv('LC_ALL') === false
    && !isset($_SERVER['LC_MESSAGES']) && getenv('LC_MESSAGES') === false
    && !isset($_SERVER['LANG']) && getenv('LANG') === false
    && extension_loaded('intl')) {
    $winDefault = \Locale::getDefault();
    if (is_string($winDefault) && trim($winDefault) !== '' && !in_array($winDefault, ['C', 'POSIX', 'root'], true)) {
        putenv('LANG=' . $winDefault);
    }
}
\SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());
// Pre-rename env compatibility: CANDYSHELL_* was this app's option-fallback
// prefix before the 2026-10 rename to candy-scriptui. Import any old-prefix
// exports under the new CANDY_SCRIPTUI_* name (new name always wins), then
// warn once per var.
// @rename-keep
// scriptui-58 (finding 134): this warning fires after the locale wiring
// above, so it answers in the user's language like every runtime refusal;
// the autoload-failure writes at the top of this file correctly stay
// English (the machinery is not loaded there).
foreach (\SugarCraft\Core\Util\LegacyEnv::import([
    'CANDYSHELL_' => 'CANDY_SCRIPTUI_', // @rename-keep
]) as $legacyVar) {
    fwrite(STDERR, 'candy-scriptui: ' . \SugarCraft\ScriptUi\Lang::t('runtime.legacy_env', [ // @rename-keep
        'var'         => $legacyVar,
        'replacement' => 'CANDY_SCRIPTUI_' . substr($legacyVar, strlen('CANDYSHELL_')), // @rename-keep
    ]) . "\n");
}

// Application::run() returns the process exit code; forwarding it is the
// package's raison d'être — shell scripts gate on `candy-scriptui confirm`.
exit((new Application())->run());
