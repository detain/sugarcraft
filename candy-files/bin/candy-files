#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // Guard shape ported from candy-code/candy-top (DST-1, measured on PHP
    // 8.3.6): when `php candy-files.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Two identities cover the two phar
    // shapes: the stub names itself in __FILE__, and a require-from-inside
    // names the archive in Phar::running(). Both are addressed the only way
    // that works, as a phar:// URI. When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-files: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Files\Manager;
use SugarCraft\Files\Support\Version;

// Answered before the positional directory scan: a packaging script or a
// bug report runs these first, possibly from a directory that is not meant
// to be opened at all.
$flags = array_slice($argv ?? [], 1);
if (in_array('--version', $flags, true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}
if (in_array('--help', $flags, true) || in_array('-h', $flags, true)) {
    fwrite(STDOUT, "candy-files — dual-pane file manager\n\n"
        . "Usage:\n"
        . "  candy-files [left] [right]   Open panes on the given directories\n"
        . "                               (default: cwd on the left, HOME on the right)\n"
        . "  candy-files --version        Print the version\n"
        . "  candy-files --help           Show this help\n");
    exit(0);
}

$cwd = getcwd() ?: '/';
$home = getenv('HOME') ?: '/';
$leftCwd  = $argv[1] ?? $cwd;
$rightCwd = $argv[2] ?? $home;

// Fail fast with a clear message instead of launching a TUI over an empty
// pane list (FsLister returns [] for a missing directory, which reads as a
// mysterious "no entries" rather than "you passed a bogus path").
foreach (['left' => $leftCwd, 'right' => $rightCwd] as $side => $dir) {
    if (!is_dir($dir)) {
        fwrite(STDERR, "candy-files: {$side} directory does not exist: {$dir}\n");
        exit(1);
    }
}

(new Program(Manager::start($leftCwd, $rightCwd), new ProgramOptions(useAltScreen: true)))->run();
