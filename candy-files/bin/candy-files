#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // Guard shape ported from candy-code/candy-top (DST-1, measured on PHP
    // 8.3.6): when `php candy-files.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Two identities cover the two phar
    // shapes: the stub names itself in __FILE__, and a require-from-inside
    // names the archive in Phar::running(). Both are addressed the only way
    // that works, as a phar:// URI. When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-files: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\I18n\T;
use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Files\Lang;
use SugarCraft\Files\Manager;
use SugarCraft\Files\Support\Home;
use SugarCraft\Files\Support\Version;

// UI language from $LANG / $LC_ALL (M-6, detection hoisted by CF-16/closes
// 060): the 16 catalogues under lang/ must be live BEFORE the first bytes
// this process can ever print — the old leg sat below the usage block and
// the directory refusal, so a German user was refused in English (observed
// live). English is the fallback (house idiom), candy-codetime's
// right-after-autoload shape.
T::setLocale(T::detect());

// Answered before the positional directory scan: a packaging script or a
// bug report runs these first, possibly from a directory that is not meant
// to be opened at all.
$flags = array_slice($argv ?? [], 1);
if (in_array('--version', $flags, true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}
if (in_array('--help', $flags, true) || in_array('-h', $flags, true)) {
    fwrite(STDOUT, Lang::t('cli.usage') . "\n");
    exit(0);
}

// Refuse at the door (CF-19, closes audit 027): the UI is a full-screen
// alt-buffer program, so a piped stdout emits unlabelled escape-sequence
// soup and then blocks forever on a stdin it cannot read — an un-killable
// launch (rc=137 was observed by two independent lanes; same
// non-terminating shape as CF-13's live-loop class). The candy-git
// launcher gate is the house mirror; --version/--help stay piped-safe
// above because packaging scripts and bug reports need them headless.
if (!stream_isatty(STDOUT)) {
    fwrite(STDERR, "candy-files: this program needs an interactive terminal (stdout is not a TTY); --version and --help work when piped\n");
    exit(1);
}

$cwd = getcwd() ?: '/';
// CF-18 (closes 092): bare getenv('HOME') is POSIX-only and parked the right
// pane at the drive root on Windows shells without MSYS — the cascade lives in
// Support\Home where the unit can pin it.
$home = Home::resolve();
$leftCwd  = $argv[1] ?? $cwd;
$rightCwd = $argv[2] ?? $home;

// Fail fast with a clear message instead of launching a TUI over an empty
// pane list (the CF-22 lister contract answers null here, which would
// otherwise read as a mysterious "no entries" rather than "you passed a
// bogus or unreadable path"). is_readable joins is_dir (CF-22, audit 031):
// the bin's own comment already refused this exact class at argv — the
// in-app navigation re-admitted it. CF-16 (closes 060): both halves —
// side and reason — ride the catalogue now that detection sits above.
foreach (['left' => $leftCwd, 'right' => $rightCwd] as $side => $dir) {
    $refusal = \SugarCraft\Files\Support\LaunchDir::refusal($dir);
    if ($refusal !== null) {
        $sideLabel = $side === 'left' ? Lang::t('side.left') : Lang::t('side.right');
        fwrite(STDERR, 'candy-files: ' . Lang::t('cli.dir_missing', ['side' => $sideLabel, 'reason' => $refusal, 'dir' => $dir]) . "\n");
        exit(1);
    }
}

(new Program(Manager::start($leftCwd, $rightCwd), new ProgramOptions(useAltScreen: true)))->run();
