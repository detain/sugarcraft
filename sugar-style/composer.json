{
    "name": "sugarcraft/sugar-style",
    "description": "Declarative styling and layout for terminal UIs, inspired by charmbracelet/lipgloss.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "cli",
        "lipgloss",
        "ansi",
        "styling",
        "layout",
        "borders",
        "tables",
        "tree",
        "list",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-style",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-style/issues",
        "source": "https://github.com/sugarcraft/sugar-style",
        "docs": "https://sugarcraft.github.io/lib/sugar-style.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-colorprofile": "dev-master",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-constraints": "dev-master",
        "sugarcraft/sugar-cellbuffer": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Style\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Style\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "sugarcraft": {
            "deferred-wiring": {
                "sugarcraft/sugar-colorprofile": "P1-10a: ColorProfile::detect() delegates to sugarcraft/sugar-colorprofile's DetectionChain when that package is installed, behind a class_exists guard, so src/ never names its namespace. The require is what makes the chain answer colour; without it the call falls back to Ascii (no colour, text kept)."
            }
        }
    }
}
