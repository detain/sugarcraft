{
    "name": "sugarcraft/candy-codeshot",
    "description": "Render code or ANSI-decorated terminal output to SVG (or PNG with ext-gd) screenshots with macOS-style window controls, drop shadow, line numbers, and inline SGR colour parsing \u2014 inspired by charmbracelet/freeze.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "screenshot",
        "svg",
        "code",
        "terminal",
        "freeze",
        "ansi",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/candy-codeshot",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-codeshot/issues",
        "source": "https://github.com/sugarcraft/candy-codeshot",
        "docs": "https://sugarcraft.github.io/lib/candy-codeshot.html"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "sugarcraft/sugar-ansi-parser": "dev-master",
        "sugarcraft/sugar-core": "dev-master"
    },
    "suggest": {
        "ext-gd": "Required for PNG output in PngRenderer"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\CodeShot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\CodeShot\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/candy-codeshot"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
