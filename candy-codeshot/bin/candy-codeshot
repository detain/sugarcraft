#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * `candy-codeshot` — render code or terminal output to an SVG (or PNG)
 * screenshot.
 *
 * Usage:
 *   echo "hello" | candy-codeshot --theme dracula > out.svg
 *   candy-codeshot input.txt --theme tokyo-night --no-window --line-numbers
 *
 * Reads from stdin when no path is supplied; writes the image to
 * stdout (or `--output <path>`). Options take their value as a separate
 * argument (`--theme dracula`, not `--theme=dracula`).
 *
 * Exit codes: 0 success, 1 I/O failure (read/write/autoload), 2 refused
 * input (unknown flag/theme/format/style, bad option value, path outside
 * the CWD, missing ext-gd).
 */

// The three house autoload shapes, in the order candy-mdview probes them:
// a standalone dev checkout, a composer-installed dependency copied to its
// real dist path under <project>/vendor/sugarcraft/candy-codeshot/bin, and a
// composer-generated <project>/vendor/bin symlink inside the monorepo or any
// consuming project. The middle candidate is what makes a plain
// `composer require sugarcraft/candy-codeshot` consumer work — without it the
// bin silently loaded nothing and every class reference fatalled.
$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../../vendor/autoload.php',
];

// A phar build stamps THIS file as the archive stub: under `php
// candy-codeshot.phar` __FILE__ names the archive while \Phar::running(false)
// answers '' (measured PHP 8.3 — a bare '/x.phar/entry' path fails is_file,
// so the probe must be the 'phar://' stream over the real archive path);
// when required from inside the archive, running() answers the path instead.
// Either identity resolves the archive, and once found its bundled vendor/
// becomes the ONLY candidate — a working-tree vendor beside a published
// .phar must never outrank it. Outside an archive nothing changes.
$archive = str_ends_with(__FILE__, '.phar')
    ? 'phar://' . __FILE__
    : (\Phar::running(false) !== '' ? 'phar://' . \Phar::running(false) : '');
if ($archive !== '') {
    $autoloadCandidates = [$archive . '/vendor/autoload.php'];
}

$autoloadFound = false;
foreach ($autoloadCandidates as $auto) {
    if (is_file($auto)) {
        require $auto;
        $autoloadFound = true;
        break;
    }
}
if (!$autoloadFound) {
    // Fail loud: a missing autoloader used to degrade into a bare
    // "Class not found" fatal naming an internal class — unactionable.
    fwrite(STDERR, "candy-codeshot: cannot find composer autoload.php - run 'composer install' in this checkout, or invoke the bin through a composer-installed project's vendor/bin\n");
    exit(1);
}

use SugarCraft\CodeShot\CodeHighlighter;
use SugarCraft\CodeShot\Lang;
use SugarCraft\CodeShot\LanguageDetector;
use SugarCraft\CodeShot\PngRenderer;
use SugarCraft\CodeShot\SvgRenderer;
use SugarCraft\CodeShot\Support\Version;
use SugarCraft\CodeShot\Theme;

/**
 * Real filesystem path of the running phar archive, or '' outside one. The
 * bin file IS the archive stub, so both identities must be consulted: under
 * `php candy-codeshot.phar` \Phar::running(false) answers '' while __FILE__
 * names the archive (measured PHP 8.3); when required from inside, running()
 * answers the path.
 */
function runningArchivePath(): string
{
    if (str_ends_with(__FILE__, '.phar')) {
        return __FILE__;
    }
    $running = \Phar::running(false);

    return $running !== '' ? $running : '';
}

/**
 * Version the CLI prints: the archive's build stamp when running inside a
 * phar (the DST-1 law — InstalledVersions lies under a frozen vendor/), else
 * the compiled-in Version::CURRENT constant.
 */
function displayVersion(): string
{
    return Version::resolve(runningArchivePath(), Version::CURRENT);
}

/**
 * Resolve a filesystem path and require it to live inside the current working
 * directory, defeating `../` traversal and absolute-path escapes before we
 * read or write attacker-influenced locations. Returns the resolved absolute
 * path, or null when it escapes the CWD (the caller rejects with exit 2).
 *
 * `$unsafe` (the `--unsafe-paths` opt-out) bypasses confinement entirely.
 *
 * Paths that do not yet exist (e.g. an `--output` target, or a new file in the
 * CWD) are confined by their nearest existing ancestor directory, so creating
 * a file inside the CWD stays allowed while writing outside it does not.
 */
function candy_codeshot_confine_path(string $path, bool $unsafe): ?string
{
    if ($unsafe) {
        return $path;
    }
    $cwd = realpath(getcwd() ?: '.');
    if ($cwd === false) {
        return null;
    }
    $cwd = rtrim($cwd, DIRECTORY_SEPARATOR);

    $absolute = preg_match('#^([/\\\\]|[A-Za-z]:)#', $path) === 1
        ? $path
        : $cwd . DIRECTORY_SEPARATOR . $path;

    // Walk up to the nearest existing ancestor so a not-yet-created target is
    // still confined by the directory it would be written into.
    $ancestor = $absolute;
    while (($real = realpath($ancestor)) === false) {
        $parent = dirname($ancestor);
        if ($parent === $ancestor) {
            return null; // ran off the filesystem root without resolving
        }
        $ancestor = $parent;
    }
    $resolved = $real . substr($absolute, strlen($ancestor));

    $prefix = $cwd . DIRECTORY_SEPARATOR;
    if ($resolved !== $cwd && !str_starts_with($resolved, $prefix)) {
        return null;
    }
    return $resolved;
}

/**
 * Every flag that takes a value must actually receive one. A trailing flag
 * (`--theme` at the end of argv) used to stringify null into '' and surface
 * as a confusing "unknown theme ''" (or, for -o, as a write against the CWD
 * directory); refuse the shape by name instead.
 */
function candy_codeshot_flag_value(string $option, ?string $value): string
{
    if ($value === null || $value === '') {
        fwrite(STDERR, Lang::t('cli.missing_value', ['option' => $option]) . "\n");
        exit(2);
    }
    return $value;
}

/**
 * Numeric flags are digit-only and non-negative by contract. The old
 * `(int) array_shift(...)` silently turned `--padding wide` into 0 — an
 * unrequested layout change with no diagnostic.
 */
function candy_codeshot_int_flag(string $option, ?string $value): int
{
    $raw = candy_codeshot_flag_value($option, $value);
    if (preg_match('/^\d+$/', $raw) !== 1) {
        fwrite(STDERR, Lang::t('cli.bad_number', ['option' => $option, 'value' => $raw]) . "\n");
        exit(2);
    }
    return (int) $raw;
}

$argv = $_SERVER['argv'] ?? $argv ?? [];
array_shift($argv);

$themeName      = 'dark';
$padding        = 24;
$window         = true;
$shadow         = true;
$border         = true;
$lineNumbers    = false;
$borderRadius   = 8;
$windowStyle    = null;
$ligatures      = false;
$fontPath       = null;
$highlight      = null;
$output         = null;
$inputPath      = null;
$format         = 'svg';
$language       = null;
$unsafePaths    = false;
// Which SVG-only options the operator actually asked for — the PNG backend
// cannot honour these, so we announce the drop loudly (stderr) instead of
// silently rendering a PNG that ignored them.
$sawLigatures = false;
$sawFont      = false;
$sawHighlight = false;

while (($arg = array_shift($argv)) !== null) {
    switch ($arg) {
        case '--theme':         $themeName    = candy_codeshot_flag_value('--theme', array_shift($argv)); break;
        case '--padding':       $padding      = candy_codeshot_int_flag('--padding', array_shift($argv)); break;
        case '--no-window':     $window       = false; break;
        case '--no-shadow':     $shadow       = false; break;
        case '--no-border':     $border       = false; break;
        case '--line-numbers':  $lineNumbers  = true;  break;
        case '--border-radius': $borderRadius = candy_codeshot_int_flag('--border-radius', array_shift($argv)); break;
        case '--window-style':
            $styleRaw = candy_codeshot_flag_value('--window-style', array_shift($argv));
            $valid = ['macos', 'windows-terminal', 'iterm', 'hyper', 'none'];
            if (!in_array($styleRaw, $valid, true)) {
                fwrite(STDERR, Lang::t('cli.unknown_window_style', ['style' => $styleRaw]) . "\n");
                exit(2);
            }
            $windowStyle = $styleRaw;
            break;
        case '--ligatures':     $ligatures    = true; $sawLigatures = true; break;
        case '--unsafe-paths':  $unsafePaths  = true; break;
        case '--font':
            // Existence, confinement and font-signature checks are deferred
            // until after parsing so --unsafe-paths (order-independent) applies.
            $fontPath = candy_codeshot_flag_value('--font', array_shift($argv));
            $sawFont = true;
            break;
        case '--highlight':
            $hlFormat = candy_codeshot_flag_value('--highlight', array_shift($argv));
            if (!preg_match('/^(\d+):(\d+)(?::([^:]+))?$/', $hlFormat, $m)) {
                fwrite(STDERR, Lang::t('cli.bad_highlight', ['format' => $hlFormat]) . "\n");
                exit(2);
            }
            $start = (int) $m[1];
            $end   = (int) $m[2];
            $color = $m[3] ?? '#fffbe6';
            $highlight = [$start, $end, $color];
            $sawHighlight = true;
            break;
        case '-o':
        case '--output':        $output       = candy_codeshot_flag_value($arg, array_shift($argv)); break;
        case '--format':
            $format = candy_codeshot_flag_value('--format', array_shift($argv));
            if (!in_array($format, ['svg', 'png'], true)) {
                fwrite(STDERR, Lang::t('cli.unknown_format', ['format' => $format]) . "\n");
                exit(2);
            }
            break;
        case '-t':
        case '--type':
            $language = candy_codeshot_flag_value($arg, array_shift($argv));
            break;
        case '-v':
        case '--version':
            fwrite(STDOUT, 'candy-codeshot ' . displayVersion() . "\n");
            exit(0);
        case '-h':
        case '--help':
            fwrite(STDOUT, Lang::t('cli.usage') . "\n");
            exit(0);
        default:
            if ($inputPath === null && !str_starts_with($arg, '-')) {
                $inputPath = $arg;
            } else {
                fwrite(STDERR, Lang::t('cli.unknown_flag', ['flag' => $arg]) . "\n");
                exit(2);
            }
    }
}

$theme = match (strtolower(str_replace('_', '-', $themeName))) {
    'dark'        => Theme::dark(),
    'light'       => Theme::light(),
    'dracula'     => Theme::dracula(),
    'tokyo-night' => Theme::tokyoNight(),
    'nord'        => Theme::nord(),
    default       => null,
};
if ($theme === null) {
    fwrite(STDERR, Lang::t('cli.unknown_theme', ['name' => $themeName]) . "\n");
    exit(2);
}

// Confine every attacker-influenced filesystem path to the CWD (defeats `../`
// traversal, absolute-path escapes and symlink hops) unless the operator
// explicitly opts out with --unsafe-paths.
if ($inputPath !== null) {
    $confined = candy_codeshot_confine_path($inputPath, $unsafePaths);
    if ($confined === null) {
        fwrite(STDERR, Lang::t('cli.path_outside_cwd', ['path' => $inputPath]) . "\n");
        exit(2);
    }
    $inputPath = $confined;
}
if ($output !== null) {
    $confined = candy_codeshot_confine_path($output, $unsafePaths);
    if ($confined === null) {
        fwrite(STDERR, Lang::t('cli.path_outside_cwd', ['path' => $output]) . "\n");
        exit(2);
    }
    $output = $confined;
}
if ($fontPath !== null) {
    $confined = candy_codeshot_confine_path($fontPath, $unsafePaths);
    if ($confined === null) {
        fwrite(STDERR, Lang::t('cli.path_outside_cwd', ['path' => $fontPath]) . "\n");
        exit(2);
    }
    $fontPath = $confined;
    if (!is_file($fontPath)) {
        fwrite(STDERR, Lang::t('cli.font_not_found', ['path' => $fontPath]) . "\n");
        exit(2);
    }
    // Reject any blob without a real font signature before base64-embedding it
    // into the SVG — a hostile file could otherwise smuggle in markup/script.
    $fontHead = @file_get_contents($fontPath, false, null, 0, 4);
    if ($fontHead === false || SvgRenderer::sniffFontMime($fontHead) === null) {
        fwrite(STDERR, Lang::t('cli.font_invalid', ['path' => $fontPath]) . "\n");
        exit(2);
    }
}

$text = $inputPath !== null
    ? @file_get_contents($inputPath)
    : stream_get_contents(STDIN);
if ($text === false || $text === null) {
    fwrite(STDERR, Lang::t('cli.read_failed') . "\n");
    exit(1);
}

// Detect the language, then apply plaintext syntax highlighting — but only for
// raw source. If the input already carries its own ANSI SGR (e.g. captured
// terminal output) we pass it through untouched so pre-styled colours win and
// the render stays byte-identical. Unrecognised / plain-text languages tokenise
// to a single Plain span, so CodeHighlighter::highlight() returns the input
// unchanged; the `!== 'text'` guard just skips the needless tokenise pass.
//
// When a file path is supplied, its extension names the language FIRST (the
// README has always documented filename as a detection source, and content
// signatures are a deliberately small list — a plain `.py` loop body scores
// zero and used to render unhighlighted); unknown extensions and stdin fall
// through to shebang + content heuristics.
$detectedLang = $inputPath !== null
    ? LanguageDetector::detectFromFilename($inputPath)
    : 'text';
if ($detectedLang === 'text') {
    $detectedLang = LanguageDetector::detect($text);
}
if ($language === null) {
    $language = $detectedLang;
}
if (strpos($text, "\x1b") === false && $language !== 'text' && $language !== '') {
    $text = CodeHighlighter::forTheme($theme)->highlight($text, $language);
}

if ($format === 'png') {
    // The PNG backend draws with GD bitmap fonts: three options have no PNG
    // equivalent. Announce every dropped one instead of silently ignoring it.
    $dropped = [];
    if ($sawLigatures) { $dropped[] = '--ligatures'; }
    if ($sawFont)      { $dropped[] = '--font'; }
    if ($sawHighlight) { $dropped[] = '--highlight'; }
    if ($dropped !== []) {
        fwrite(STDERR, Lang::t('cli.png_ignores', ['options' => implode(', ', $dropped)]) . "\n");
    }
    if (!extension_loaded('gd')) {
        fwrite(STDERR, Lang::t('cli.gd_required') . "\n");
        exit(2);
    }
    $renderer = new PngRenderer(
        theme:        $theme,
        padding:      $padding,
        window:       $window,
        shadow:       $shadow,
        border:       $border,
        lineNumbers:  $lineNumbers,
        borderRadius: $borderRadius,
    );
} else {
    $renderer = new SvgRenderer(
        theme:        $theme,
        padding:      $padding,
        window:       $window,
        shadow:       $shadow,
        border:       $border,
        lineNumbers:  $lineNumbers,
        borderRadius: $borderRadius,
    );
    if ($ligatures) {
        $renderer = $renderer->withLigatures(true);
    }
    if ($fontPath !== null) {
        // The path was existence/sniffed above, so withFont's own not-found
        // throw is unreachable from this CLI today; the catch stays as the
        // fail-closed net for a file deleted between the check and the embed.
        try {
            $renderer = $renderer->withFont($fontPath);
        } catch (\InvalidArgumentException $e) {
            fwrite(STDERR, Lang::t('cli.font_not_found', ['path' => $fontPath]) . "\n");
            exit(2);
        }
    }
    if ($highlight !== null) {
        [$start, $end, $color] = $highlight;
        try {
            $renderer = $renderer->withHighlight($start, $end, $color);
        } catch (\InvalidArgumentException $e) {
            // `--highlight 0:5` / `5:3` pass the shape regex but violate the
            // renderer's range contract — refuse with exit 2, not a fatal.
            fwrite(STDERR, Lang::t('cli.highlight_rejected', ['spec' => $start . ':' . $end, 'reason' => $e->getMessage()]) . "\n");
            exit(2);
        }
    }
}
if ($windowStyle !== null) {
    $renderer = $renderer->withWindowStyle($windowStyle);
}

$result = $renderer->render($text);

if ($output !== null) {
    // `-o shot.png` without `--format png` used to write SVG bytes into a
    // .png-named file (and vice versa) in silence. Warn on stderr; the bytes
    // themselves keep their documented meaning — the flag, not the filename,
    // chooses the format.
    $lowerOutput = strtolower($output);
    if (($format === 'svg' && str_ends_with($lowerOutput, '.png'))
        || ($format === 'png' && str_ends_with($lowerOutput, '.svg'))
    ) {
        fwrite(STDERR, Lang::t('cli.format_mismatch', ['format' => $format, 'path' => $output]) . "\n");
    }
    if (@file_put_contents($output, $result) === false) {
        fwrite(STDERR, Lang::t('cli.write_failed', ['path' => $output]) . "\n");
        exit(1);
    }
} else {
    echo $result;
}
