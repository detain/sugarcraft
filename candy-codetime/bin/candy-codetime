#!/usr/bin/env php
<?php

declare(strict_types=1);

// ---------------------------------------------------------------------------
// Autoloader (archive-aware). A phar build stamps THIS file as the archive
// stub, so under `php candy-codetime.phar` __FILE__ names the archive and its
// bundled vendor/ is the only correct source. Measured PHP 8.3 law: in the
// stub context \Phar::running(false) answers '' and a bare '/x.phar/entry'
// path fails is_file — resolve from BOTH identities ('phar://' . __FILE__
// under the stub, 'phar://' . running() when required from inside), and once
// an archive is found DROP the filesystem candidates so a working-tree vendor
// beside a published .phar can never outrank the archive. The three original
// candidates are preserved verbatim for every non-archive run.
// ---------------------------------------------------------------------------
(static function (): void {
    $archive = str_ends_with(__FILE__, '.phar')
        ? 'phar://' . __FILE__
        : (\Phar::running(false) !== '' ? 'phar://' . \Phar::running(false) : '');
    $candidates = $archive !== ''
        ? [$archive . '/vendor/autoload.php']
        : ['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    foreach ($candidates as $candidate) {
        // phar:// URIs are absolute too — the old '/'-only prefix test would
        // re-anchor them onto __DIR__ and miss the archive.
        $path = (str_starts_with($candidate, '/') || str_starts_with($candidate, 'phar://'))
            ? $candidate
            : __DIR__ . '/../' . $candidate;
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-codetime: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\I18n\T;
use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Core\Util\Sanitize;
use SugarCraft\Core\Util\TtyDetect;
use SugarCraft\Core\Util\LegacyEnv;
use SugarCraft\Core\Util\LegacyPaths;
use SugarCraft\CodeTime\Backup\AutoBackup;
use SugarCraft\CodeTime\Dashboard;
use SugarCraft\CodeTime\Export\CsvExporter;
use SugarCraft\CodeTime\Export\IcalExporter;
use SugarCraft\CodeTime\Export\JsonExporter;
use SugarCraft\CodeTime\Heartbeat;
use SugarCraft\CodeTime\Ignore\SugarTrackIgnore;
use SugarCraft\CodeTime\Lang;
use SugarCraft\CodeTime\Report\GapsReport;
use SugarCraft\CodeTime\Storage\SqliteBackend;
use SugarCraft\CodeTime\Store;
use SugarCraft\CodeTime\Support\Version;

/**
 * Real filesystem path of the running phar archive, or '' outside one. The
 * bin file IS the archive stub, so the two identities must both be consulted:
 * under `php candy-codetime.phar` \Phar::running(false) answers '' while
 * __FILE__ names the archive (measured PHP 8.3); when this code is instead
 * required from inside, running() answers the path.
 */
function runningArchivePath(): string
{
    if (str_ends_with(__FILE__, '.phar')) {
        return __FILE__;
    }
    $running = \Phar::running(false);

    return $running !== '' ? $running : '';
}

/**
 * Version the CLI prints: the archive's build stamp when running inside a
 * phar (the DST-1 law — InstalledVersions lies under a frozen vendor/), else
 * the compiled-in Version::CURRENT constant.
 */
function displayVersion(): string
{
    return Version::resolve(runningArchivePath(), Version::CURRENT);
}

// Arm the translation registry from the environment BEFORE the first
// translated line is produced: the lang/ catalogues shipped but nothing ever
// selected a locale, so every CLI message was English-only (dormant i18n).
// detect() reads LC_ALL -> LC_MESSAGES -> LANG and falls back to 'en'.
T::setLocale(T::detect());

// Pre-rename compatibility (plan_rename.md R4.4/R4.5, sugar-tick -> // @rename-keep
// candy-codetime): import any old-prefix env exports under the new name first
// (new name always wins), then move a pre-existing default data directory.
// The migration is skipped when CANDY_CODETIME_DIR is set — an explicit
// directory is the user's choice, and neither we nor the test suite should
// relocate the ambient default dir under it.
foreach (LegacyEnv::import([
    'SUGARTICK_' => 'CANDY_CODETIME_', // @rename-keep
]) as $legacyVar) {
    fwrite(STDERR, Lang::t('cli.legacy_env_deprecated', ['variable' => $legacyVar]) . "\n");
}
if (getenv('CANDY_CODETIME_DIR') === false) {
    $dataBase = (static function (): string {
        $xdg = getenv('XDG_DATA_HOME');
        if ($xdg !== false && $xdg !== '') {
            return rtrim($xdg, '/');
        }

        return rtrim(getenv('HOME') ?: '.', '/') . '/.local/share';
    })();
    $moved = LegacyPaths::migrate($dataBase . '/sugar-tick', $dataBase . '/candy-codetime'); // @rename-keep
    if ($moved !== null) {
        // The moved path is filesystem data (a planted directory name could
        // carry control bytes) — sweep it before it paints the terminal.
        fwrite(STDERR, Lang::t('cli.migration_notice', ['notice' => Sanitize::untrusted($moved)]) . "\n");
    }
}

$argv = $argv ?? [];

// Pull the global `--backend <file|sqlite>` option (equals or space form) out
// of argv so it can appear anywhere on the command line; everything else stays
// positional. The space form shipped documented nowhere but expected by habit:
// `--backend sqlite` used to silently send 'sqlite' to the positional bag and
// run the file backend.
$backend = 'file';
$backendNext = false;
// CANDY_CODETIME_BACKEND carries the preference across invocations: an
// sqlite user no longer repeats --backend=sqlite on every command line for
// it to stick. An explicit flag still outranks it (parsed later), and junk
// in either is refused the same way.
$backendChosen = false;
$envBackend = getenv('CANDY_CODETIME_BACKEND');
if (is_string($envBackend) && $envBackend !== '') {
    $backend = $envBackend;
    $backendChosen = true;
}
// `--time=<unix>` (equals or space form) rides the same global scanner as
// --backend; CT-S02's backfill seam. Only the push arm consumes it — a real
// timestamp supplied once instead of the wall clock inventing one at read time.
$timeOpt = null;
$timeNext = false;
$positional = [];
foreach (array_slice($argv, 1) as $arg) {
    if ($backendNext) {
        $backend = $arg;
        $backendNext = false;
        $backendChosen = true;
        continue;
    }
    if ($timeNext) {
        $timeOpt = $arg;
        $timeNext = false;
        continue;
    }
    if ($arg === '--backend') {
        $backendNext = true;
        continue;
    }
    if ($arg === '--time') {
        $timeNext = true;
        continue;
    }
    if (str_starts_with($arg, '--backend=')) {
        $backend = substr($arg, strlen('--backend='));
        $backendChosen = true;
        continue;
    }
    if (str_starts_with($arg, '--time=')) {
        $timeOpt = substr($arg, strlen('--time='));
        continue;
    }
    $positional[] = $arg;
}
if ($backendNext) {
    // `--backend` as the final argument: the value never arrived.
    fwrite(STDERR, Lang::t('cli.backend_invalid') . "\n");
    exit(1);
}
if ($timeNext) {
    fwrite(STDERR, Lang::t('cli.push_invalid_time', ['value' => '']) . "\n");
    exit(1);
}
if (!in_array($backend, ['file', 'sqlite'], true)) {
    fwrite(STDERR, Lang::t('cli.backend_invalid') . "\n");
    exit(1);
}
// CT-S31: CANDY_CODETIME_GOAL carries the daily goal for the dashboard —
// plain whole seconds, or a whole number of hours like 6h. Junk is refused
// like every other preference: a typo'd goal silently read as "no goal"
// would turn the absence of a header cell into a liar.
$goalSeconds = null;
$goalRaw = getenv('CANDY_CODETIME_GOAL');
if (is_string($goalRaw) && trim($goalRaw) !== '') {
    $goalValue = trim($goalRaw);
    if (preg_match('/^\d+$/', $goalValue) === 1) {
        $goalSeconds = (int) $goalValue;
    } elseif (preg_match('/^\d+[hH]$/', $goalValue) === 1) {
        $goalSeconds = (int) $goalValue * 3600;
    }
    if ($goalSeconds === null || $goalSeconds < 1) {
        fwrite(STDERR, Lang::t('cli.invalid_goal', ['value' => Sanitize::untrusted($goalValue)]) . "\n");
        exit(1);
    }
}

$cmd = $positional[0] ?? 'dashboard';

// --version prints the phar stamp when running inside an archive, else the
// single-source constant (no config, no autoload of storage).
if ($cmd === '--version' || $cmd === '-v') {
    fwrite(STDOUT, 'candy-codetime ' . displayVersion() . "\n");
    exit(0);
}

// One convention for storage failure at EVERY read/write site. SQLite3's own
// exceptions do not extend RuntimeException, so the old narrower catches let
// a locked or corrupt database surface as an uncaught fatal with exit 255;
// \Throwable is the honest net here.
$storageError = static function (\Throwable $e): never {
    fwrite(STDERR, Lang::t('cli.storage_error', ['message' => Sanitize::untrusted($e->getMessage())]) . "\n");
    exit(1);
};

/**
 * Write the whole payload to STDOUT. Unlike a bare fwrite, a short or failed
 * write (broken pipe, full disk) cannot pass off a truncated export as an
 * exit-0 success — it routes through the same one-line-error-and-exit-1 law
 * as every other failure.
 */
$writeStdout = static function (string $payload) use ($storageError): void {
    while ($payload !== '') {
        $written = @fwrite(STDOUT, $payload);
        if ($written === false || $written === 0) {
            $storageError(new RuntimeException('candy-codetime: output could not be written in full'));
        }
        $payload = substr($payload, $written);
    }
};

$store = new Store(getenv('CANDY_CODETIME_DIR') ?: Store::defaultDir());
$dbPath = $store->dir . '/candy-codetime.db';

/**
 * Cheap "does this store hold anything" probes, used for the auto-select
 * and the cross-store pointer below. Both are best-effort by design: a
 * locked database, a missing extension or an unreadable sidecar just mean
 * "cannot tell", which is never a reason to steer anyone.
 */
$fileStoreHasData = static function () use ($store): bool {
    foreach ((glob($store->dir . '/*.jsonl') ?: []) as $file) {
        if (is_file($file) && (filesize($file) ?: 0) > 0) {
            return true;
        }
    }
    return false;
};
$dbHasData = static function () use ($dbPath): bool {
    if (!extension_loaded('sqlite3') || !is_file($dbPath)) {
        return false;
    }
    try {
        $db = new SQLite3($dbPath);
        $found = (bool) $db->querySingle('SELECT EXISTS(SELECT 1 FROM heartbeats LIMIT 1)');
        $db->close();
        return $found;
    } catch (Throwable) {
        return false;
    }
};

if (!$backendChosen && $dbHasData() && !$fileStoreHasData()) {
    // Follow the data: a user who has been recording into the database
    // is still a sqlite user even with the flag and env var unnamed —
    // 'file' as the default would open an empty TUI and hide their week.
    $backend = 'sqlite';
}

// One line on the other door: a split store is the quietly-wrong answer,
// not a loud one, so both halves of the answer get pointed at explicitly.
$otherBackend = $backend === 'sqlite' ? 'file' : 'sqlite';
$otherHasData = $backend === 'sqlite' ? $fileStoreHasData() : $dbHasData();
if ($otherHasData) {
    fwrite(STDERR, Lang::t('cli.backend_other_hint', ['other' => $otherBackend]) . "\n");
}

// The privacy contract is a launch invariant, not a write-path favor:
// plugin-direct appends and the pre-rename migration move never run the
// mode doors, so every launch — reads and help included — sweeps the tree
// back to owner-private before it touches or prints anything.
try {
    $store->enforcePrivateModes();
} catch (\Throwable $e) {
    $storageError($e);
}

// Lazily open the SQLite backend, ensuring the data dir exists first and failing
// loudly (rather than fataling) when the sqlite3 extension is absent.
$sqlite = static function () use ($store, $dbPath): SqliteBackend {
    if (!extension_loaded('sqlite3')) {
        fwrite(STDERR, Lang::t('cli.backend_unavailable') . "\n");
        exit(1);
    }
    Store::ensurePrivateDir($store->dir);
    return new SqliteBackend($dbPath);
};


// Show usage for help flags or unknown commands
if ($cmd === 'help' || $cmd === '--help' || $cmd === '-h') {
    fwrite(STDOUT, Lang::t('cli.usage') . "\n");
    exit(0);
}

if ($cmd === 'push') {
    // candy-codetime push <project> <language> <file> [duration] [--time=<unix>]
    // candy-codetime push --            batch: one heartbeat JSON per stdin line
    $stdinBatch = ($positional[1] ?? null) === '--';

    // CT-S02: the backfill seam. A plugin (or a re-run after an outage) says
    // WHEN the work happened instead of letting the wall clock invent it at
    // ingest time. Same door law as the duration counter: refuse at the
    // boundary, clamp inside the honest range, never coerce.
    $hbTime = time();
    if ($timeOpt !== null) {
        if (!ctype_digit($timeOpt)) {
            fwrite(STDERR, Lang::t('cli.push_invalid_time', ['value' => Sanitize::untrusted($timeOpt)]) . "\n");
            exit(1);
        }
        if ($stdinBatch) {
            // stdin rows carry their own time; a batch-wide --time would
            // silently rewrite exactly the lines that omitted one.
            fwrite(STDERR, Lang::t('cli.push_time_stdin_conflict') . "\n");
            exit(1);
        }
        $hbTime = max(0, min((int) $timeOpt, Heartbeat::MAX_TIME_SECONDS));
    }

    // Honour a `.sugartrackignore` (from the current dir or the tracked file's
    // dir) so opted-out paths never make it into the activity log. load()
    // refuses an oversized file with a RuntimeException; an untrusted plant
    // must cost a one-line error and exit 1, never a 255 fatal mid-push.
    $ignoreFor = static function (string $file, string|false|null $cwd): array {
        $candidates = [];
        if ($cwd !== false && $cwd !== null) {
            $candidates[] = $cwd . '/.sugartrackignore';
        }
        $candidates[] = dirname($file) . '/.sugartrackignore';
        foreach ($candidates as $candidate) {
            if (is_file($candidate)) {
                return [SugarTrackIgnore::load($candidate), $candidate];
            }
        }
        return [new SugarTrackIgnore([]), ''];
    };
    $cwd = getcwd();

    if (!$stdinBatch) {
        $project  = $positional[1] ?? null;
        $language = $positional[2] ?? null;
        $file     = $positional[3] ?? null;
        if ($project === null || $language === null || $file === null) {
            fwrite(STDERR, Lang::t('cli.push_missing_args') . "\n");
            fwrite(STDERR, Lang::t('cli.push_usage') . "\n");
            exit(1);
        }
        foreach (['project' => $project, 'language' => $language, 'file' => $file] as $field => $value) {
            if ($value === '') {
                // CT-S15: the empty string is a typed argument, not a missing
                // one — it gets its own refusal so no door stores a ghost beat.
                fwrite(STDERR, Lang::t('cli.push_empty_field', ['field' => $field]) . "\n");
                fwrite(STDERR, Lang::t('cli.push_usage') . "\n");
                exit(1);
            }
        }
        try {
            [$ignore, $ignorePath] = $ignoreFor($file, $cwd);
        } catch (\Throwable $e) {
            $storageError($e);
        }
        if ($ignore->isIgnored($file)) {
            // A repo can ship its own ".sugartrackignore", so its patterns are
            // untrusted input to the tracking tool. When the loaded file carries
            // a wildcard-only pattern it zeroes the project's ENTIRE recorded
            // time, and a skip that erases a whole repo must not hide in the
            // success stream — shout it on STDERR with the path, pattern count
            // and project. The opt-out itself still works (exit 0, nothing
            // stored): this is disclosure, not refusal.
            if ($ignore->hasWholesalePattern()) {
                fwrite(STDERR, Lang::t('cli.push_ignored_wholesale', [
                    'file'        => Sanitize::untrusted($file),
                    'ignore_file' => Sanitize::untrusted($ignorePath),
                    'patterns'    => $ignore->patternCount(),
                    'project'     => Sanitize::untrusted($project),
                ]) . "\n");
            } else {
                fwrite(STDOUT, Lang::t('cli.push_ignored', ['file' => Sanitize::untrusted($file)]) . "\n");
            }
            exit(0);
        }

        // A non-numeric duration used to silently cast to 0 — a heartbeat that
        // records nothing but claims success. Refuse it at the boundary instead.
        $durationRaw = $positional[4] ?? null;
        if ($durationRaw !== null && !ctype_digit($durationRaw)) {
            fwrite(STDERR, Lang::t('cli.push_invalid_duration', ['value' => Sanitize::untrusted($durationRaw)]) . "\n");
            exit(1);
        }
        $duration = (int)($durationRaw ?? 60);
        $duration = max(0, min($duration, Heartbeat::MAX_DURATION_SECONDS));  // clamp to [0, 1 year]
        // CT-S29: the last rung of the positional ladder. Tags already lived
        // everywhere at rest — the column, the JSONL row, all three exporters —
        // and only the typed door lost them. A comma-list labels the beat the
        // same way a plugin-written row does; blank members are noise, not
        // tags, so they fall out.
        $tagsRaw = $positional[5] ?? null;
        $tags = [];
        if ($tagsRaw !== null) {
            foreach (explode(',', $tagsRaw) as $tag) {
                $tag = trim($tag);
                if ($tag !== '') {
                    $tags[] = $tag;
                }
            }
        }
        $hb = new Heartbeat($hbTime, $project, $language, $file, $duration, $tags);
        try {
            if ($backend === 'sqlite') {
                $sqlite()->insert($hb);
            } else {
                $store->append($hb);
            }
        } catch (\Throwable $e) {
            // Storage threw rather than losing the row silently (Store::append /
            // SqliteBackend::insert fail loud) — surface it and exit non-zero.
            $storageError($e);
        }
        fwrite(STDOUT, Lang::t('cli.entry_pushed', [
            'project'  => Sanitize::untrusted($project),
            'language' => Sanitize::untrusted($language),
            'duration' => $duration,
        ]) . "\n");
        exit(0);
    }

    // --- stdin batch mode (CT-S02) --------------------------------------------
    // One heartbeat per line. A malformed line never costs the batch: it is
    // named (with its line number) on STDERR and the run ends non-zero, while
    // the well-formed rows still land.
    $raw = stream_get_contents(STDIN);
    if ($raw === false) {
        $storageError(new RuntimeException('candy-codetime: cannot read stdin'));
    }
    $count = 0;
    $malformed = 0;
    foreach (explode("\n", $raw) as $index => $line) {
        $line = trim($line);
        if ($line === '') {
            continue;
        }
        $row = json_decode($line, true);
        if (!is_array($row) || !isset($row['project'], $row['language'], $row['file'])
            || !is_string($row['project']) || !is_string($row['language']) || !is_string($row['file'])
            || $row['project'] === '' || $row['language'] === '') {
            fwrite(STDERR, Lang::t('cli.push_stdin_malformed', ['line' => $index + 1]) . "\n");
            $malformed++;
            continue;
        }
        // Capture door (CT-S15): a batch row without a time is stamped at the
        // moment it is read in — the documented contract. The wall-clock lives
        // here at capture, never inside the storage readers.
        $row['time'] ??= time();
        try {
            [$ignore, $ignorePath] = $ignoreFor($row['file'], $cwd);
        } catch (\Throwable $e) {
            $storageError($e);
        }
        if ($ignore->isIgnored($row['file'])) {
            if ($ignore->hasWholesalePattern()) {
                fwrite(STDERR, Lang::t('cli.push_ignored_wholesale', [
                    'file'        => Sanitize::untrusted($row['file']),
                    'ignore_file' => Sanitize::untrusted($ignorePath),
                    'patterns'    => $ignore->patternCount(),
                    'project'     => Sanitize::untrusted($row['project']),
                ]) . "\n");
            }
            continue;
        }
        try {
            $hb = Heartbeat::fromArray($row);
            if ($backend === 'sqlite') {
                $sqlite()->insert($hb);
            } else {
                $store->append($hb);
            }
        } catch (\Throwable $e) {
            $storageError($e);
        }
        $count++;
    }
    if ($count > 0) {
        fwrite(STDOUT, Lang::t($count === 1 ? 'cli.push_stdin_done_one' : 'cli.push_stdin_done', ['count' => $count]) . "\n");
    }
    exit($malformed > 0 ? 1 : 0);
}

if ($cmd === 'milestone') {
    // candy-codetime milestone add [name] [description] | list
    // Milestones live only in the SQLite backend.
    $sub = $positional[1] ?? null;

    if ($sub === 'add') {
        $name = $positional[2] ?? null;
        if ($name === null) {
            fwrite(STDERR, Lang::t('cli.milestone_missing_args') . "\n");
            fwrite(STDERR, Lang::t('cli.milestone_usage') . "\n");
            exit(1);
        }
        $description = (string)($positional[3] ?? '');
        // CT-S08: milestones have no file store, so this add force-creates
        // candy-codetime.db (+WAL sidecars) even in a file-backend dir. Say
        // so BEFORE the first write - the user's next bare `export` would
        // otherwise hit the new sqlite auto-select and read an empty store.
        if ($backend !== 'sqlite' && !is_file($dbPath) && $fileStoreHasData()) {
            fwrite(STDERR, Lang::t('cli.milestone_sqlite_notice', ['name' => Sanitize::untrusted($name)]) . "\n");
        }
        try {
            $sqlite()->insertMilestone($name, time(), $description);
        } catch (\Throwable $e) {
            $storageError($e);
        }
        fwrite(STDOUT, Lang::t('cli.milestone_added', ['name' => Sanitize::untrusted($name)]) . "\n");
        exit(0);
    }

    if ($sub === 'list') {
        try {
            $milestones = $sqlite()->milestones();
        } catch (\Throwable $e) {
            $storageError($e);
        }
        if ($milestones === []) {
            fwrite(STDOUT, Lang::t('cli.milestone_list_empty') . "\n");
            exit(0);
        }
        fwrite(STDOUT, Lang::t('cli.milestone_list_header') . "\n");
        foreach ($milestones as $m) {
            fwrite(STDOUT, Lang::t('cli.milestone_entry', [
                'date'        => date('Y-m-d', $m->time),
                'name'        => Sanitize::untrusted($m->name),
                'description' => Sanitize::untrusted($m->description),
            ]) . "\n");
        }
        exit(0);
    }

    fwrite(STDERR, Lang::t('cli.milestone_usage') . "\n");
    exit(1);
}

if ($cmd === 'export') {
    $format = $positional[1] ?? null;
    // Same law as the push duration door: a non-numeric count is refused, not
    // silently coerced to 0 (which the clamp would then round up to one day).
    $daysRaw = $positional[2] ?? null;
    if ($daysRaw !== null && !ctype_digit($daysRaw)) {
        fwrite(STDERR, Lang::t('cli.invalid_days', ['value' => Sanitize::untrusted($daysRaw)]) . "\n");
        exit(1);
    }
    // Clamp to a sane ceiling so a huge $days can't walk a century of empty days.
    $days = $daysRaw === null ? 7 : Store::clampRangeDays((int)$daysRaw);

    if ($format === null || !in_array($format, ['csv', 'json', 'ics'], true)) {
        fwrite(STDERR, Lang::t('cli.export_invalid_format') . "\n");
        fwrite(STDERR, Lang::t('cli.export_usage') . "\n");
        exit(1);
    }

    $endDay = new \DateTimeImmutable('today');
    $fromDay = $endDay->modify('-' . ($days - 1) . ' days');
    try {
        $beats = $backend === 'sqlite'
            ? $sqlite()->query(
                (int) $fromDay->setTime(0, 0)->getTimestamp(),
                (int) $endDay->setTime(23, 59, 59)->getTimestamp(),
            )
            : $store->loadRange($fromDay, $endDay);
    } catch (\Throwable $e) {
        $storageError($e);
    }

    $exporter = match ($format) {
        'csv' => new CsvExporter(),
        'json' => new JsonExporter(),
        'ics' => new IcalExporter(),
    };
    // A stored name is untrusted data: control bytes must not paint the
    // terminal when the dump is piped to one. JSON already escapes them, so
    // the sweep is a no-op there; tab/newline survive, so record structure
    // is untouched. The encode itself sits inside the net: a row poisoned
    // before the UTF-8 door existed (a legacy db written under the raw
    // bind legs) must surface as a one-line error and exit 1 — never the
    // old bare PHP fatal at exit 255.
    try {
        $payload = Sanitize::untrusted($exporter->export('candy-codetime', $beats));
    } catch (\Throwable $e) {
        $storageError($e);
    }
    $writeStdout($payload);
    exit(0);
}

if ($cmd === 'gaps') {
    // Same law as the push duration door: a non-numeric count is refused, not
    // silently coerced to 0 (which the clamp would then round up to one day).
    $daysRaw = $positional[1] ?? null;
    if ($daysRaw !== null && !ctype_digit($daysRaw)) {
        fwrite(STDERR, Lang::t('cli.invalid_days', ['value' => Sanitize::untrusted($daysRaw)]) . "\n");
        exit(1);
    }
    // Clamp to a sane ceiling so a huge $days can't walk a century of empty days.
    $days = $daysRaw === null ? 7 : Store::clampRangeDays((int)$daysRaw);

    $endDay = new \DateTimeImmutable('today');
    $fromDay = $endDay->modify('-' . ($days - 1) . ' days');
    try {
        $beats = $backend === 'sqlite'
            ? $sqlite()->query(
                (int) $fromDay->setTime(0, 0)->getTimestamp(),
                (int) $endDay->setTime(23, 59, 59)->getTimestamp(),
            )
            : $store->loadRange($fromDay, $endDay);
    } catch (\Throwable $e) {
        $storageError($e);
    }

    $report = new GapsReport($beats);
    $gaps = $report->gaps();

    if ($gaps === []) {
        fwrite(STDOUT, Lang::t('cli.gaps_no_data') . "\n");
        exit(0);
    }

    fwrite(STDOUT, Lang::t('cli.gaps_header') . "\n");
    foreach ($gaps as $gap) {
        $startTs = (int) $gap['start'];
        $endTs = (int) $gap['end'];
        $start = date('M j H:i', $startTs);
        // A gap that ends the following day printed 'H:i' only — the entry
        // read as time running backwards. Same-day gaps keep the short clock.
        $end = date('Y-m-d', $startTs) === date('Y-m-d', $endTs)
            ? date('H:i', $endTs)
            : date('M j H:i', $endTs);
        fwrite(STDOUT, Lang::t('cli.gaps_entry', [
            'start' => $start,
            'end' => $end,
            'seconds' => $gap['gapSeconds'],
        ]) . "\n");
    }
    exit(0);
}

if ($cmd === 'backup') {
    $dataDir = $store->dir;
    $backupDir = $dataDir . '-backups';
    // M1: the archive only clones `*.jsonl`. A sqlite user who believes they
    // are covered must be told otherwise on every run, not by a footnote.
    // The WAL posture deepens the refusal: recent commits ride the
    // `-wal`/`-shm` sidecars until checkpointed, so even a byte-exact copy
    // of the `.db` alone would miss them (and sidecar files are no longer
    // transient to copy piecemeal either).
    if (in_array('--sqlite', array_slice($positional, 1), true)) {
        // CT-S23: the sqlite retention door. VACUUM INTO snapshots the
        // database consistently even while appenders hold it; a byte copy
        // could never say that, so plain rotate() still refuses the .db.
        try {
            $dest = (new AutoBackup($backupDir, [$dataDir]))->archiveSqliteDatabase($dbPath);
        } catch (\RuntimeException $e) {
            fwrite(STDERR, Sanitize::untrusted($e->getMessage()) . "\n");
            exit(1);
        }
        fwrite(STDOUT, Lang::t('cli.backup_sqlite_done', ['file' => Sanitize::untrusted($dest)]) . "\n");
        exit(0);
    }
    if (is_file($dbPath)) {
        fwrite(STDERR, Lang::t('cli.backup_sqlite_notice', ['db' => Sanitize::untrusted($dbPath)]) . "\n");
    }
    $autoBackup = new AutoBackup($backupDir, [$dataDir]);
    try {
        $count = $autoBackup->rotate(30);
    } catch (\RuntimeException $e) {
        // rotate() now throws on mkdir/copy failure rather than losing data
        // silently — surface it to the user with a non-zero exit.
        fwrite(STDERR, Sanitize::untrusted($e->getMessage()) . "\n");
        exit(1);
    }
    if ($count > 0) {
        fwrite(STDOUT, Lang::t($count === 1 ? 'cli.backup_done_one' : 'cli.backup_done', ['count' => $count]) . "\n");
    } else {
        fwrite(STDOUT, Lang::t('cli.backup_none') . "\n");
    }
    exit(0);
}

// Unknown command - show usage
if ($cmd !== 'dashboard') {
    fwrite(STDERR, Lang::t('cli.unknown_command', ['command' => Sanitize::untrusted($cmd)]) . "\n");
    fwrite(STDERR, Lang::t('cli.usage') . "\n");
    exit(1);
}

// The dashboard reads the SAME backend the other subcommands were routed to;
// pre-fix it always opened the JSONL store, so sqlite users saw an empty TUI.
// The TUI pumps escape sequences and waits on keypresses forever. With neither
// stream a terminal that just meant an alt-screen dump into a cron log and a
// process that never exits (bare `dashboard` on a pipe hung). Refuse loudly
// and point at the machine-readable door instead.
// CT-S06: the window is operator-selectable. Same refusal law as the gaps
// door — `dashboard 30x` is an error, never a silent fallback to 7. The
// argument is validated BEFORE the tty check so a mistyped width fails in a
// pipe exactly like it does on a terminal.
$daysRaw = $positional[1] ?? null;
if ($daysRaw !== null && !ctype_digit($daysRaw)) {
    fwrite(STDERR, Lang::t('cli.invalid_days', ['value' => Sanitize::untrusted($daysRaw)]) . "\n");
    exit(1);
}
$dashDays = $daysRaw === null ? 7 : Store::clampRangeDays((int) $daysRaw);
if (!TtyDetect::isAtty(STDIN) || !TtyDetect::isAtty(STDOUT)) {
    fwrite(STDERR, Lang::t('cli.dashboard_needs_tty') . "\n");
    exit(1);
}
try {
    $reader = $backend === 'sqlite' ? $sqlite() : $store;
    $dashboard = Dashboard::start($reader, null, $dashDays, $backend, goalSeconds: $goalSeconds);
} catch (\Throwable $e) {
    $storageError($e);
}
// CT-S19: from here the alt screen owns the terminal. The first recompute
// inside start() already printed this launch's notices to stderr pre-TUI;
// later loads report through the dashboard's in-frame notes instead, so no
// raw bytes ever land between sync frames.
if ($reader instanceof Store) {
    $reader->silenceDiagnostics();
}
(new Program($dashboard, new ProgramOptions(useAltScreen: true)))->run();
