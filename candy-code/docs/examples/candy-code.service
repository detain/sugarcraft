# candy-code server as a systemd USER unit (docs/SERVER.md, "systemd").
#
#   cp docs/examples/candy-code.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now candy-code
#   journalctl --user -u candy-code -f
#
# The server runs in the FOREGROUND here: systemd is the supervisor, so no
# --detach. Its stderr (the startup lines and the request log) goes to the
# journal. `candy-code serve status|stop|url` still work against it, through
# the same ~/.candy-code/server state directory.

[Unit]
Description=candy-code server (WebSocket + web UI)
After=network.target

[Service]
Type=simple
# The project the server works on. Adjust both paths; candy-code must be on
# the PATH below or named absolutely.
WorkingDirectory=%h/src/my-project
ExecStart=/usr/bin/env candy-code serve
# SIGTERM drains the server (stop accepting, close sockets, release the lock).
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
# Everything it creates is this user's alone.
UMask=0077

[Install]
WantedBy=default.target
