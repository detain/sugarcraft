{
    "name": "sugarcraft/sugar-flexbox",
    "description": "PHP port of 76creates/stickers \u2014 Lipgloss utility components. FlexBox (CSS flexbox-like responsive grid layout) and Table (sortable, filterable data table with column definitions).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "flexbox",
        "table",
        "layout",
        "grid",
        "sugarcraft",
        "stickers"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-flexbox",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-flexbox/issues",
        "source": "https://github.com/sugarcraft/sugar-flexbox"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-widgets": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Flexbox\\": "src/",
            "SugarCraft\\Flexbox\\Flex\\": "src/Flex/",
            "SugarCraft\\Flexbox\\Table\\": "src/Table/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Flexbox\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
