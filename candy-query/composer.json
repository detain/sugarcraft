{
    "name": "sugarcraft/candy-query",
    "description": "Terminal SQLite browser \u2014 port of jorgerojas26/lazysql on the SugarCraft stack.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "tui",
        "cli",
        "sql",
        "sqlite",
        "lazysql",
        "sugarcraft",
        "sugarcraft"
    ],
    "homepage": "https://sugarcraft.github.io/lib/candy-query.html",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-query/issues",
        "source": "https://github.com/sugarcraft/candy-query",
        "docs": "https://sugarcraft.github.io/lib/candy-query.html"
    },
    "bin": [
        "bin/candy-query"
    ],
    "require": {
        "php": ">=8.3",
        "sugarcraft/candy-async": "dev-master",
        "sugarcraft/candy-core": "dev-master",
        "sugarcraft/candy-forms": "dev-master",
        "sugarcraft/candy-kit": "dev-master",
        "sugarcraft/candy-layout": "dev-master",
        "sugarcraft/candy-sprinkles": "dev-master",
        "sugarcraft/sugar-bits": "dev-master",
        "sugarcraft/sugar-charts": "dev-master",
        "sugarcraft/sugar-dash": "dev-master",
        "sugarcraft/sugar-table": "dev-master",
        "sugarcraft/sugar-toast": "dev-master",
        "react/mysql": "0.7.x-dev",
        "react/promise-timer": "^1.9",
        "voryx/pgasync": "^2.2",
        "ext-pdo_sqlite": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Query\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Query\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
