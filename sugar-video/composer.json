{
    "name": "sugarcraft/sugar-video",
    "description": "Terminal video player for SugarCraft \u2014 plays mp4 (and more) by decoding frames on the fly and rendering them to ASCII / ANSI / truecolor half-block / sixel / kitty output.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "video",
        "video-player",
        "ascii",
        "ascii-art",
        "ansi",
        "sixel",
        "kitty",
        "ffmpeg",
        "tplay",
        "video-to-ascii",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-video",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-video/issues",
        "source": "https://github.com/sugarcraft/sugar-video",
        "docs": "https://sugarcraft.github.io/lib/sugar-video.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-cellbuffer": "dev-master",
        "sugarcraft/sugar-colorprofile": "dev-master",
        "sugarcraft/sugar-image": "dev-master",
        "sugarcraft/sugar-animation": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "dev-master"
    },
    "suggest": {
        "ext-gd": "Required for .gif playback and animated .webp decoding (the pure-PHP routes; no ffmpeg needed). mp4/avi/webm need the ffmpeg and ffprobe binaries on $PATH — a runtime toolchain, not a Composer package.",
        "ext-mbstring": "Used by the WebVTT subtitle parser for UTF-8-safe cue truncation in the caption overlay."
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Video\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Video\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
