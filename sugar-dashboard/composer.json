{
    "name": "sugarcraft/sugar-dashboard",
    "description": "Dashboard TUI library \u2014 column grid, constraint layout, ratio grid, data grid, tree, modal, status bar, tabs, plot/canvas, and module/plugin system. Ports patterns from bubble-grid, bubbletea-tilelayout, go-tealeaves, bubbleboxer, lattice, Homedash, and termui.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "cli",
        "dashboard",
        "layout",
        "grid",
        "panel",
        "table",
        "tree",
        "modal",
        "tabs",
        "plot",
        "chart",
        "status-bar",
        "bubbletea",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-dashboard",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-dashboard/issues",
        "source": "https://github.com/sugarcraft/sugar-dashboard",
        "docs": "https://sugarcraft.github.io/lib/sugar-dashboard.html"
    },
    "require": {
        "php": "^8.3",
        "react/promise": "^3.3",
        "sugarcraft/sugar-cellbuffer": "dev-master",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-focus": "dev-master",
        "sugarcraft/sugar-style": "dev-master",
        "sugarcraft/sugar-toast": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/candy-vcr": "@dev"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Dashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Dashboard\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Plugin/Support/sdk-eof-exit-child.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
