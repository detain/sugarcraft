{
    "name": "sugarcraft/sugar-charts",
    "description": "PHP port of NimbleMarkets/ntcharts \u2014 terminal charts (canvas, sparkline, bar, line, heatmap, scatter, time-series, OHLC, streamline, waveline) for SugarCraft.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "charts",
        "graphs",
        "sparkline",
        "bar-chart",
        "line-chart",
        "heatmap",
        "scatter",
        "time-series",
        "ohlc",
        "candlestick",
        "ntcharts",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-charts",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-charts/issues",
        "source": "https://github.com/sugarcraft/sugar-charts",
        "docs": "https://sugarcraft.github.io/lib/sugar-charts.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-cellbuffer": "dev-master",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-style": "dev-master",
        "sugarcraft/sugar-dashboard": "dev-master"
    },
    "suggest": {
        "ext-mbstring": "Codepoint handling across the renderers (labels, truncation, row walking).",
        "ext-intl": "Enables grapheme-cluster splitting in BufferHelper/Canvas so combining marks and ZW sequences keep exact display widths."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "dev-master",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Charts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Charts\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
