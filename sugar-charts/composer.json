{
    "name": "sugarcraft/sugar-charts",
    "description": "Terminal charts for PHP \u2014 sparkline, bar, line, heatmap, scatter, time-series, streamline, waveline, OHLC, and inline Sixel/Kitty/iTerm2 images. Design antecedent: NimbleMarkets/ntcharts.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "charts",
        "graphs",
        "sparkline",
        "bar-chart",
        "line-chart",
        "heatmap",
        "scatter",
        "time-series",
        "ohlc",
        "candlestick",
        "ntcharts",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-charts",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-charts/issues",
        "source": "https://github.com/sugarcraft/sugar-charts",
        "docs": "https://sugarcraft.github.io/lib/sugar-charts.html"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "sugarcraft/sugar-cellbuffer": "dev-master",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-style": "dev-master"
    },
    "suggest": {
        "sugarcraft/sugar-dashboard": "Optional display helpers whose BrailleGrid/Plot widgets pair with LineChart's braille mode — not a runtime dependency: withBraille() and the withCanvas() CellGrid bridge are self-contained to this lib (sugar-charts-007)."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "dev-master",
        "sugarcraft/sugar-dashboard": "dev-master",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Charts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Charts\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
