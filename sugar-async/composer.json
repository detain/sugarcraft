{
    "name": "sugarcraft/sugar-async",
    "description": "Shared async utilities for SugarCraft \u2014 cancellation tokens, subscriptions, timeout/deadline combinators, fan-in, debounce/throttle handles, retry, and a bounded cache-aside store, built on ReactPHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sugarcraft",
        "async",
        "cancellation",
        "reactphp",
        "promise",
        "event-loop"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-async",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/detain/sugarcraft/issues",
        "source": "https://github.com/sugarcraft/sugar-async",
        "docs": "https://github.com/sugarcraft/sugar-async/blob/master/README.md"
    },
    "require": {
        "php": "^8.3",
        "react/event-loop": "^1.6",
        "react/promise": "^3.3",
        "sugarcraft/sugar-core": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Async\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Async\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
