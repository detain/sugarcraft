#!/usr/bin/env php
<?php

/**
 * `start` — entry point for the bootstrapped SugarCraft app.
 *
 * Replace the `Counter` import below with your own Model once you've
 * forked this template. The Program harness (event loop, render
 * tick, signal handling, raw-mode setup, alt-screen lifecycle) is
 * production-ready out of the box — you just write the Model. Msgs
 * reach `update()` through four doors: the terminal is the harness's,
 * while `subscriptions()`, `Cmd::promise()` resolutions and the
 * public `Program::send()` are the three you wire — all four are
 * spelled out in the README's "Getting Msgs in".
 * Supports an opt-in panic handler via `Log::installPanicHandler()`
 * (uncomment below).
 */

declare(strict_types=1);

use App\Counter;
use SugarCraft\Core\Program;

// Resolve the autoloader relative to this file, not the working
// directory — the same script works as a fresh `composer
// create-project` app and inside the monorepo
// (`cd candy-starter && bin/start`).
(static function (): void {
    $autoload = __DIR__ . '/../vendor/autoload.php';
    if (is_file($autoload)) {
        require $autoload;
        return;
    }
    fwrite(STDERR, "bin/start: cannot find composer autoload.php — did you `composer install`?\n");
    exit(1);
})();

// -----------------------------------------------------------------------
// OPT-IN: Panic handler — uncomment to catch uncaught exceptions and
// display a styled backtrace on crash.  Run `composer require
// sugarcraft/sugar-log` first; in a monorepo add a path-repo to
// composer.json repositories[] as well (development only — never ship
// it, it breaks every create-project consumer of your app).
// -----------------------------------------------------------------------
// use SugarCraft\Log\Log;
// Log::installPanicHandler();

// Harness tunables live in ProgramOptions (framerate, alt-screen,
// mouse tracking, raw-mode details, cursor visibility — hideCursor
// defaults to true, which hides the terminal cursor) — pass one as
// the second argument
// when you need them, keeping the same run + stopSignal() shape at the
// tail of this file:
// $program = new Program(new Counter(), new \SugarCraft\Core\ProgramOptions(framerate: 30.0));

$program = new Program(new Counter());
$program->run();

// -----------------------------------------------------------------------
// Exit-code tail — the shell's convention for signal deaths. run() stops
// cooperatively (Cmd::quit(), a model-raised InterruptMsg) and on OS
// signals alike; stopSignal() answers an int ONLY for the signal arms.
// Cooperative quits therefore keep the conventional 0, while a SIGINT /
// SIGTERM / SIGHUP-stopped run exits 128+N — 130 / 143 / 129 — so
// supervisors, scripts and CI signal checks read this app the same way
// they read any signal-terminated child. Ctrl+C included: on a raw-mode
// tty the keypress is read as a KeyMsg and the demo quits cooperatively
// (exit 0) — 130 is reserved for a SIGINT delivered by the OS, such as
// `kill -INT` or a terminal whose raw-mode setup never landed. Discarding
// the stop reason made every fork exit 0 after a kill.
// -----------------------------------------------------------------------
$stoppedBySignal = $program->stopSignal();
if ($stoppedBySignal !== null) {
    exit(128 + $stoppedBySignal);
}
