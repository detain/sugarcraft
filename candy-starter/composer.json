{
    "name": "sugarcraft/candy-starter",
    "description": "Skeleton repo for bootstrapping a SugarCraft TUI app \u2014 `composer create-project sugarcraft/candy-starter my-app --stability=dev` (Packagist carries dev-master, plus read-only dev-legacy/* branches frozen at the pre-rename candy-mold era, until a `candy-starter/*` tag exists). Ships a runnable counter Model wired through Program, plus a docs-as-code walkthrough that maps each shipped file to the concept it demonstrates.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "sugarcraft",
        "template",
        "skeleton",
        "starter",
        "bootstrap",
        "tui",
        "create-project",
        "bubbletea-app-template"
    ],
    "homepage": "https://github.com/sugarcraft/candy-starter",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-starter/issues",
        "source": "https://github.com/sugarcraft/candy-starter",
        "docs": "https://sugarcraft.github.io/lib/candy-starter.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-style": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
