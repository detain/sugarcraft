#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // Guard shape ported from candy-code/candy-top (measured on PHP
    // 8.3.6): when `php candy-minesweeper.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Two identities cover the two phar
    // shapes: the stub names itself in __FILE__, and a require-from-inside
    // names the archive in Phar::running(). Both are addressed the only way
    // that works, as a phar:// URI. When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-minesweeper: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\MouseMode;
use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Core\Util\ColorProfile;
use SugarCraft\Minesweeper\Difficulty;
use SugarCraft\Minesweeper\Game;
use SugarCraft\Minesweeper\Lang;
use SugarCraft\Minesweeper\Stats\DifficultyStats;
use SugarCraft\Minesweeper\Support\Version;
use SugarCraft\Minesweeper\Ui\CustomDifficulty;
use SugarCraft\Style\Style;

// Activate the locale detected from LANG/LC_ALL/LC_MESSAGES before any string
// is translated (house pattern, cf. candy-mail): in-game text routes through
// Lang::t, and without this call T's 'en' default would make the shipped
// locales unreachable. The bin's OWN usage/refusal prose stays English below
// on purpose — it must be parseable even when the terminal's locale is broken.
// Board-validation refusals from CustomDifficulty::fromInput() are the
// deliberate exception: they arrive through Lang::t and ARE translated.
\SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());

// Pre-rename env compatibility: CANDY_MINES_STATS was this app's stats-path // @rename-keep
// var before the 2026-10 rename. Import any old-prefix exports under the new
// name (new name always wins), then warn once per var — naming the var's OWN
// replacement, not a hardcoded _STATS (CANDY_MINES_FOO's remedy is
// CANDY_MINESWEEPER_FOO).
foreach (\SugarCraft\Core\Util\LegacyEnv::import([
    'CANDY_MINES_' => 'CANDY_MINESWEEPER_', // @rename-keep
]) as $legacyVar) {
    fwrite(STDERR, "candy-minesweeper: " . cliVisible($legacyVar) . " is deprecated; set " . cliVisible('CANDY_MINESWEEPER_' . substr($legacyVar, strlen('CANDY_MINES_'))) . " instead.\n"); // @rename-keep
}

// Honour NO_COLOR / CLICOLOR=0 / TERM=dumb through the fleet colour authority
// (house pattern, cf. candy-git and candy-sql boots): sugar-style's default
// profile is process-global, so every Style minted afterwards — including the
// board's frame, banner and footer decorations — renders within the detected
// capability. Only the downgrades (Ascii / NoTty) are applied; the default
// profile stays untouched so a plain TrueColor terminal keeps the colours the
// style layer already renders. The deeper in-session renegotiation via
// ColorProfileMsg is a separate seam (the Model discards that message today).
$profile = ColorProfile::detect();
if ($profile === ColorProfile::Ascii || $profile === ColorProfile::NoTty) {
    Style::setDefaultProfile($profile);
}

/**
 * CLI:
 *   candy-minesweeper                        # default 10×10, 12 mines
 *   candy-minesweeper [width] [height] [mines]   # custom board
 *   candy-minesweeper --easy|--standard|--medium|--expert   # preset
 *
 * A preset flag and custom dimensions are mutually exclusive, and only one
 * preset may be given; violating either rule is an error, not a silent
 * precedence rule.
 *
 * Stats persistence is opt-in: set CANDY_MINESWEEPER_STATS=/path/to/stats.json and a
 * completed game's outcome is recorded there across sessions.
 * Mid-game saves (in-app 'S' / 'L') live at $HOME/.config/candy-minesweeper/savegame.json.
 */
$usage = "usage: candy-minesweeper --easy | --standard | --medium | --expert\n"
      . "       candy-minesweeper [width] [height] [mines]\n"
      . "       board sizes are columns (width) then rows (height) —\n"
      . "       e.g. candy-minesweeper 16 10 starts 16 wide by 10 tall\n"
      . "       keys: hjkl/arrows move · space reveal · f flag · c chord ·\n"
      . "             S save · L load · r restart · q quit\n"
      . "       save slot: " . (Game::savePath() ?? '$HOME/.config/candy-minesweeper/savegame.json') . "\n"
      . "       stats: set CANDY_MINESWEEPER_STATS=/path/stats.json to tally across sessions\n";
$args   = array_slice($argv ?? [], 1);

// Diagnostic flags answer before any board or stats file is touched, and
// bypass the unknown-option refusal below — that door exists for game flags.
if (in_array('--version', $args, true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}
if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
    fwrite(STDOUT, $usage
        . "       candy-minesweeper --version  Print the version\n"
        . "       candy-minesweeper --help     Show this help\n"
        . "       no pause; the board is fixed at launch (no mid-session resize re-fit)\n");
    exit(0);
}

/**
 * Render a raw argv fragment safely for stderr: control bytes (ESC, BEL, NUL,
 * newlines…) become '?' and anything past 40 cells is clipped. Deliberately
 * NOT sugar-core's Sanitize — its ANSI-arena handling targets terminal-payload
 * trust boundaries; argv echoes want printable-but-recognisable names, and the
 * '?' substitution keeps a pasted escape sequence from reformatting the very
 * error message that reports it.
 */
function cliVisible(string $raw): string
{
    $probe = preg_replace('/[\x00-\x1f\x7f]/', '?', $raw);
    if (strlen($probe) <= 40) {
        return $probe;
    }
    // Clip on CODEPOINT boundaries: a byte slice at 39 can cut a multi-byte
    // character in half and emit invalid UTF-8 (a replacement glyph or a
    // mangled name) into the very error line reporting the problem.
    $chars = preg_split('//u', $probe, -1, PREG_SPLIT_NO_EMPTY);
    if ($chars === false) {
        // Already not valid UTF-8 — the byte floor is all that exists. The
        // control scrub above ran first, so no truncated tail can re-form an
        // escape sequence.
        return substr($probe, 0, 39) . '…';
    }
    $keep = '';
    foreach ($chars as $char) {
        if (strlen($keep) + strlen($char) > 39) {
            break;
        }
        $keep .= $char;
    }
    return $keep . '…';
}

/**
 * Positional board sizes are PLAIN digit strings or nothing — the old
 * (int) cast happily booted '10x10', '9.5' and '10abc' as 10/9/10. Null means
 * the slot was absent (the caller applies its default).
 *
 * @param list<string> $positional
 */
function integerArgument(array $positional, int $index, string $name, string $usage): ?int
{
    if (!isset($positional[$index])) {
        return null;
    }
    $raw = $positional[$index];
    if ($raw === '' || !ctype_digit($raw)) {
        fwrite(STDERR, "candy-minesweeper: {$name} must be a plain integer (got '" . cliVisible($raw) . "')\n");
        fwrite(STDERR, $usage);
        exit(1);
    }
    // Range-cap BEFORE any arithmetic uses the value: a 20+ digit string
    // saturates to PHP_INT_MAX under (int), and the default-mines path then
    // computes intdiv((float) $w * $h, 8) — a TypeError fatal with a path
    // trace, not the clean translated refusal this CLI promises. 1e8 is past
    // every legal board (sides 2..50, mines <= 50*50 - 9) but multiplies as
    // an int, so CustomDifficulty::fromInput() stays the refusal authority.
    return min((int) $raw, 100_000_000);
}

$preset = null;
$positional = [];
$presets = [
    '--easy'     => Difficulty::EASY,
    '--standard' => Difficulty::STANDARD,
    '--medium'   => Difficulty::MEDIUM,
    '--expert'   => Difficulty::EXPERT,
];
foreach ($args as $arg) {
    if (isset($presets[$arg])) {
        if ($preset !== null) {
            // Two presets is a contradiction, not a last-wins rule.
            fwrite(STDERR, "candy-minesweeper: more than one preset flag given\n");
            fwrite(STDERR, $usage);
            exit(1);
        }
        $preset = $presets[$arg];
        continue;
    }
    if (str_starts_with($arg, '-')) {
        fwrite(STDERR, 'candy-minesweeper: unknown option ' . cliVisible($arg) . "\n");
        fwrite(STDERR, $usage);
        exit(1);
    }
    $positional[] = $arg;
}
if ($preset !== null && $positional !== []) {
    // Refuse loudly: silently letting the preset win turns `--expert 10 10`
    // into a game the player did not ask for, with no signal anything moved.
    fwrite(STDERR, "candy-minesweeper: a preset flag and custom dimensions are mutually exclusive\n");
    fwrite(STDERR, $usage);
    exit(1);
}
if (count($positional) > 3) {
    // A fourth size-looking word was never part of the grammar; ignoring it
    // silently reads as 'the board I asked for' when it is not.
    fwrite(STDERR, "candy-minesweeper: unexpected extra argument '" . cliVisible($positional[3]) . "'\n");
    fwrite(STDERR, $usage);
    exit(1);
}

// Opt-in stats persistence: seed accumulated stats from disk if the file exists.
$statsPathEnv = getenv('CANDY_MINESWEEPER_STATS');
$statsPath = ($statsPathEnv !== false && $statsPathEnv !== '') ? $statsPathEnv : null;
$stats = null;
if ($statsPath !== null && is_file($statsPath)) {
    try {
        $stats = DifficultyStats::load($statsPath)?->stats();
    } catch (\Throwable $e) {
        // The message interpolates FILE CONTENT (the refused
        // persistence version), so the stats file's own bytes must not reach
        // the terminal raw — same scrub the argv echoes use: control bytes
        // become '?' before the line is written to stderr.
        fwrite(STDERR, "candy-minesweeper: ignoring unreadable stats file (" . cliVisible($e->getMessage()) . ")\n");
    }
}

// Boot announcement: if a savegame sits in the slot, say so on frame
// one — the player no longer has to remember that L exists.
$slot = Game::savePath();
$resumeNotice = ($slot !== null && is_file($slot)) ? Lang::t('ui.resume') : null;

if ($preset !== null) {
    $game = Game::withDifficulty($preset, stats: $stats, statsPath: $statsPath, notice: $resumeNotice);
} else {
    $w = integerArgument($positional, 0, 'width', $usage) ?? 10;
    $h = integerArgument($positional, 1, 'height', $usage) ?? 10;
    $m = integerArgument($positional, 2, 'mines', $usage) ?? max(1, intdiv($w * $h, 8));
    // Route raw CLI ints through CustomDifficulty::fromInput() so unsafe boards
    // (e.g. a mine count that leaves no safe 3×3 for the first click) are
    // rejected loudly instead of producing a broken game.
    try {
        CustomDifficulty::fromInput($h, $w, $m);
    } catch (\InvalidArgumentException $e) {
        fwrite(STDERR, "candy-minesweeper: {$e->getMessage()}\n");
        exit(1);
    }
    $game = Game::start($w, $h, $m, stats: $stats, statsPath: $statsPath, notice: $resumeNotice);
}

// Terminal fit: measure the real screen (the kernel size ioctl first, env
// and stty behind it) and refuse BEFORE the Program paints anything if the
// board cannot be shown whole. A clipped minefield is unplayable and
// unreadable, so the boot contract is an honest translated refusal with the
// row budget, not a half-painted frame. The measurement also seeds the
// Model's viewport; from here the runtime owns it via WindowSizeMsg
// (startup dispatch + every SIGWINCH).
$tty = new \SugarCraft\Core\Util\Tty(STDIN);
$screen = $tty->size();
if ($screen['rows'] > 0 && $game->requiredRows() > $screen['rows']) {
    fwrite(STDERR, Lang::t('ui.fit_notice', ['need' => $game->requiredRows(), 'have' => $screen['rows']]) . "\n");
    exit(1);
}
if ($screen['cols'] > 0 && $screen['rows'] > 0) {
    $game = $game->withFrame($screen['cols'], $screen['rows']);
}

(new Program($game, new ProgramOptions(useAltScreen: true, mouseMode: MouseMode::CellMotion)))->run();
