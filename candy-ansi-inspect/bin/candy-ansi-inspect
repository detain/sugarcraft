#!/usr/bin/env php
<?php

declare(strict_types=1);

use SugarCraft\AnsiInspect\Exec\ExecRunner;
use SugarCraft\AnsiInspect\Inspector;
use SugarCraft\AnsiInspect\Lang;
use SugarCraft\AnsiInspect\StreamingInspector;

// Autoload guard (house shape ported from candy-kv's bin). Three filesystem
// roots for source installs, and — per finding 042 — a NAMED refusal instead
// of a silent fall-through: without vendor/ every later class reference dies
// as an "Class not found" fatal *after* the locale machinery, which blames
// the wrong layer.
(static function () {
    // Phar awareness (archive root law, measured on PHP 8.3.6): when
    // `php candy-ansi-inspect.phar` runs, THIS file is the archive's stub and
    // the process is NOT inside the archive — Phar::running() answers ''
    // there, and a bare '/x.phar/entry' path fails is_file()/require for every
    // caller. Three identities cover the three phar shapes: the stub names
    // itself in __FILE__, a require-from-inside names the archive in
    // Phar::running(), and a RENAMED download hands PHP an ordinary script
    // whose bytes seal an archive, invisible to both doors above because
    // PHP's phar:// layer is extension-gated. Phar::mapPhar() is the oracle
    // for that third shape: it loads the archive sealed inside the running
    // script under the build's alias (tools/build-phar.php pairs with the
    // literal below) and throws PharException on every UNSEALED script — a
    // composer checkout's own bin included — so no pre-gate is needed. When
    // an archive identity exists, the archive's own vendor is the ONLY root:
    // a stray vendor beside (or above) a downloaded phar must never boot the
    // app with code from outside the frozen archive, renamed or not.
    $candidates = [
        __DIR__ . '/../vendor/autoload.php',     // dev: standalone
        __DIR__ . '/../../../autoload.php',      // installed under vendor/bin
        __DIR__ . '/../../vendor/autoload.php',  // monorepo dev
    ];
    $running = \Phar::running(false);
    $archive = $running !== ''
        ? 'phar://' . $running
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive === '') {
        try {
            \Phar::mapPhar('candy-ansi-inspect.phar');
            $archive = 'phar://candy-ansi-inspect.phar';
        } catch (\PharException) {
            // Not a sealed script — the filesystem candidates above stand.
        }
    }
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        // TOCTOU note (finding 042): is_file-then-require races by design;
        // no @ suppression — if the path dies between check and load, the
        // require warning is the honest forensic, not a swallowed failure.
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-ansi-inspect: cannot find composer autoload.php\n");
    exit(1);
})();

// Locale selection from $LC_ALL / $LC_MESSAGES / $LANG (the order
// T::detect() actually walks): seventeen catalogues ship and both
// tool-printed messages route through Lang::t(), so this bin-entry
// line (house precedent: candy-tetris, candy-minesweeper, candy-git) is
// what makes that routing live. Report labels stay English-built inside
// Inspector regardless of locale.
\SugarCraft\Core\I18n\T::setLocale(\SugarCraft\Core\I18n\T::detect());

// Source-gate refusal composition: the generic `cannot read: {path}` line,
// plus the wrapper parenthetical ONLY when the named path actually carries
// a scheme-like `://` — the hint is noise for a typo'd or directory path
// (finding 031).
$refusal = static function (string $rawPath): string {
    $message = (string) Lang::t('cli.not_a_file', ['path' => Inspector::sanitizeLabelBytes($rawPath)]);
    if (str_contains($rawPath, '://')) {
        $message .= "\n" . (string) Lang::t('cli.wrapper_note');
    }
    return $message;
};

$input = '';
// Did the caller actually hand us a source (file argument or a piped stdin)?
// "No source at all" (interactive TTY, no argument) is misuse and answers with
// usage; a source that happens to be empty is a legitimate report of nothing.
$sawSource = false;
// Flags are scanned before any source is opened: `--help`/`-h` is a request
// for usage, not a path (m2-fresh ruling (a)); `--json` reports a JSON array
// instead of one line per segment (finding 005); `--` enters exec mode
// (finding 003). Operands: the first non-flag word names the file, and
// PRESENCE — not truthiness — is the gate (finding 012: empty() treats the
// string "0" as empty, so `candy-ansi-inspect 0` demoted a file literally
// named `0` to a stdin read).
$asJson = false;
$wantHelp = false;
$operand = null;
$operandSeen = false;
$execCmd = null;
for ($i = 1; $i < $argc; $i++) {
    if ($argv[$i] === '--') {
        $execCmd = array_slice($argv, $i + 1);
        break;
    }
    if ($argv[$i] === '--json') {
        $asJson = true;
        continue;
    }
    if ($argv[$i] === '--help' || $argv[$i] === '-h') {
        $wantHelp = true;
        continue;
    }
    if (!$operandSeen) {
        $operand = $argv[$i];
        $operandSeen = true;
    }
}

// The stream differs by intent — asked-for usage rides stdout with exit 0,
// misusage stays a stderr refusal with exit 1.
if ($wantHelp) {
    fwrite(STDOUT, Lang::t('cli.usage') . "\n");
    exit(0);
}

// Exec mode: `-- cmd [args…]` runs the command on a fresh pseudo-terminal
// (spawned by sugar-pty — this lib never reimplements a PTY primitive) and
// reports the raw bytes it prints segment by segment as they dispatch,
// sharing the streaming reader with the stdin arm. Everything after `--`
// belongs to the child: this tool's own flags do not apply there (the report
// stays line-mode), and the child's exit status is the tool's exit status.
if ($execCmd !== null) {
    if ($execCmd === []) {
        fwrite(STDERR, Lang::t('cli.usage') . "\n");
        exit(1);
    }
    stream_set_write_buffer(STDOUT, 0);
    exit(ExecRunner::run($execCmd, static function (string $line): void {
        fwrite(STDOUT, $line . "\n");
    }));
}

$input = '';
// Did the caller actually hand us a source (file argument or a piped stdin)?
// "No source at all" (interactive TTY, no argument) is misuse and answers with
// usage; a source that happens to be empty is a legitimate report of nothing.
$sawSource = false;
if ($operandSeen && $operand !== '') {
    // Reject stream wrappers (php://, data://, http://, …) — a file-path argument
    // must not be coerced into fetching a URL or evaluating a wrapper. is_file()
    // is false for every wrapper scheme and for non-existent paths, and the
    // readability half of the gate (M2) answers an existing-but-unreadable file
    // with the same refusal + exit 1 instead of letting the bare read below
    // emit a PHP warning and exit 0 over empty content.
    if (!is_file($operand) || !is_readable($operand)) {
        fwrite(STDERR, $refusal((string) $operand) . "\n");
        exit(1);
    }
    $sawSource = true;
    $input = (string) file_get_contents($operand);
} elseif ($operandSeen) {
    // `candy-ansi-inspect ""` — a present-but-empty argument names the source
    // as the empty string, which is never a file: refuse it (exit 1) rather
    // than quietly demoting to a stdin the caller never asked to read.
    fwrite(STDERR, $refusal('') . "\n");
    exit(1);
} elseif (!stream_isatty(STDIN)) {
    $sawSource = true;
    // Stream, do not slurp: a slow producer (`tail -f log | candy-ansi-inspect`)
    // must see each completed sequence the moment it dispatches, not only after
    // the writer closes — the old `stream_get_contents()` waited for EOF and
    // then rendered everything at once. Output is byte-identical to the
    // file-argument path: one `describe()` line per segment, newline-joined.
    // Under `--json` there is no live form: a partial JSON array is not
    // parseable, so segments are collected and one array is emitted at EOF
    // (a sequin-style NDJSON mode is an open question, parked with finding
    // 022's OG list — not decided here).
    stream_set_write_buffer(STDOUT, 0);
    $streaming = new StreamingInspector();
    $gotBytes = false;
    $printed = false;
    /** @var list<\SugarCraft\AnsiInspect\Segment> $segments */
    $segments = [];
    while (!feof(STDIN)) {
        $chunk = fread(STDIN, 8192);
        if ($chunk === false) {
            break;
        }
        if ($chunk === '') {
            if (feof(STDIN)) {
                break;
            }
            continue;
        }
        $gotBytes = true;
        foreach ($streaming->feed($chunk) as $segment) {
            if ($asJson) {
                $segments[] = $segment;
            } else {
                $printed = true;
                fwrite(STDOUT, $segment->describe() . "\n");
            }
        }
    }
    foreach ($streaming->finish() as $segment) {
        if ($asJson) {
            $segments[] = $segment;
        } else {
            $printed = true;
            fwrite(STDOUT, $segment->describe() . "\n");
        }
    }
    if ($asJson) {
        echo Inspector::encodeSegmentsJson($segments), PHP_EOL;
        exit(0);
    }
    if ($gotBytes && !$printed) {
        // Non-empty stream that dispatched nothing (a lone invalid byte — README
        // deviation 10): the old slurp echoed the one empty `report()` line.
        echo PHP_EOL;
    }
    exit(0);
}

if ($input === '') {
    if (!$sawSource) {
        // Nothing was piped and no file was named (interactive TTY): the caller
        // has not said what to inspect — usage is the honest answer.
        fwrite(STDERR, Lang::t('cli.usage') . "\n");
        exit(1);
    }
    // A source WAS given and it is empty (empty file, `printf '' | candy-ansi-inspect`):
    // the report of an empty stream is an empty report, and inspecting nothing
    // successfully is success. Exiting 1 here used to break scripts that pipe
    // possibly-empty command output into the inspector. Under `--json` the
    // parseable shape of "nothing reported" is the empty array.
    if ($asJson) {
        echo Inspector::encodeSegmentsJson([]), PHP_EOL;
    }
    exit(0);
}

echo ($asJson ? Inspector::reportAsJson($input) : Inspector::report($input)), PHP_EOL;
