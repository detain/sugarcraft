{
    "name": "sugarcraft/sugar-testing",
    "description": "Test harness for TEA programs \u2014 ProgramSimulator, golden-file assertions, and snapshot helpers for SugarCraft.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "testing",
        "tea",
        "elm-architecture",
        "bubbletea",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-testing",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-testing/issues",
        "source": "https://github.com/sugarcraft/sugar-testing",
        "docs": "https://sugarcraft.github.io/lib/sugar-testing.html"
    },
    "require": {
        "php": "^8.3",
        "react/event-loop": "^1.6",
        "sugarcraft/sugar-core": "@dev",
        "sugarcraft/sugar-cellbuffer": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Testing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
