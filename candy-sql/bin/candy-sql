#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // DST-1 (guard shape ported from candy-code/candy-top, measured on PHP
    // 8.3.6): when `php candy-sql.phar` runs, THIS file is the archive's stub
    // and Phar::running() answers '' here; a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. The stub names itself in __FILE__;
    // a require-from-inside names the archive in Phar::running(). Both are
    // addressed the only way that works, as a phar:// URI, and the archive's
    // own vendor becomes the EXCLUSIVE root (a stray vendor beside the phar
    // must never boot the app from outside the frozen archive). Composer
    // mode: both identities are empty and the candidates below are untouched.
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $path = $archive . '/vendor/autoload.php';
        if (!is_file($path)) {
            fwrite(STDERR, "candy-sql: the archive has no vendor/autoload.php — the phar was built without a packaged vendor.\n");
            exit(1);
        }
        require $path;

        return;
    }

    foreach (['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
        $path = str_starts_with($candidate, '/') ? $candidate : __DIR__ . '/../' . $candidate;
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-sql: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Sql\Admin\History\HistoryRecorder;
use SugarCraft\Sql\Admin\History\SqliteHistoryStore;
use SugarCraft\Sql\App;
use SugarCraft\Sql\App\AppBuilder;
use SugarCraft\Sql\Db\ConnectionFactory;
use SugarCraft\Sql\Db\DatabaseInterface;
use SugarCraft\Sql\Db\Flavor;
use SugarCraft\Sql\Db\MysqlDatabase;
use SugarCraft\Sql\Db\PostgresDatabase;
use SugarCraft\Sql\Db\SqliteDatabase;
use SugarCraft\Sql\Lang;
use SugarCraft\Sql\Version;

$argv = $argv ?? [];

// Handle --help/-h and --version/-V before anything else
$exit = handleGlobalFlags($argv);
if ($exit !== null) {
    exit($exit);
}

$historyPath = resolveHistoryPath($argv);
$argv = stripHistoryFlags($argv);

$database = buildDatabase($argv);

// Extract flavor from database type
$flavor = match (true) {
    $database instanceof MysqlDatabase => Flavor::MySQL,
    $database instanceof PostgresDatabase => Flavor::Postgres,
    $database instanceof SqliteDatabase => Flavor::Sqlite,
    default => Flavor::Sqlite,
};

$historyRecorder = null;
if ($historyPath !== null) {
    $historyRecorder = new HistoryRecorder(new SqliteHistoryStore($historyPath));
}

(new Program(
    App::start($database, $flavor, $historyRecorder),
    new ProgramOptions(useAltScreen: true),
))->run();

/**
 * Print help or handle version flag, return exit code or null to continue.
 *
 * @param array<string> $argv
 * @return int|null null means "continue", int means "exit with this code"
 */
function handleGlobalFlags(array $argv): ?int
{
    $args = array_slice($argv, 1);
    $hasHelp = false;
    $hasVersion = false;

    foreach ($args as $arg) {
        // Normalize: strip leading dashes, split on =, take the flag name
        $normalized = ltrim($arg, '-');
        if (str_contains($normalized, '=')) {
            [$flag] = explode('=', $normalized, 2);
        } else {
            $flag = $normalized;
        }

        if (in_array($flag, ['h', 'help'], true)) {
            $hasHelp = true;
        }
        if (in_array($flag, ['V', 'version'], true)) {
            $hasVersion = true;
        }
    }

    if ($hasVersion) {
        // Phar-aware (DST-1): inside an archive the stamped build metadata
        // wins; in composer mode the answer stays the installed package's own
        // Composer metadata (the 14a7e605a contract) — never a frozen literal.
        fwrite(STDOUT, 'candy-sql ' . Version::current() . "\n");
        return 0;
    }

    if ($hasHelp) {
        showHelp();
        return 0;
    }

    return null;
}

/**
 * Print the full help screen.
 */
function showHelp(): void
{
    fwrite(STDOUT, <<<'HELP'
candy-sql - Terminal SQL client for SQLite, MySQL and PostgreSQL

USAGE
  candy-sql [OPTIONS] [path-or-dsn]

ARGUMENTS
  path-or-dsn
    SQLite database file path, e.g.: app.sqlite
    Or a DSN string, e.g.:  mysql://user:pass@localhost:3306/dbname

  When omitted entirely, a short usage line is printed and the
  process exits with status 1; run --help for this full screen.

OPTIONS
  --help, -h
    Show this help screen.

  --version, -V
    Show the version number.

  --dsn=<dsn>
    Full DSN connection string.
    Format: <driver>://<user>:<pass>@<host>:<port>/<dbname>[?ssl-mode=<mode>]
    Examples:
      mysql://root:secret@localhost:3306/mydb?ssl-mode=require
      pgsql://postgres:pass@db.example.com:5432/production
      sqlite:///var/data/app.sqlite
      sqlite://:memory:

  --driver=<driver>
  --db=<dbname>
  --host=<host>
  --port=<port>
  --user=<user>
  --pass=<pass>
  --ssl-mode=<mode>
    Individual connection parameters (all except --driver and --db are optional).
    --driver must be one of: sqlite, mysql, pgsql
    --ssl-mode defaults to "prefer" for MySQL. "require" and "verify_*" enforce
    TLS with server-certificate verification; CA trust must be configured
    server-side or via my.cnf (see README).
    Prefer CANDY_SQL_PASS over --pass= to keep the password out of the
    process command line (visible in ps).

EXAMPLES
  # SQLite (default — bare path or DSN)
  candy-sql app.sqlite
  candy-sql sqlite:///var/data/app.sqlite
  candy-sql sqlite://:memory:

  # MySQL via DSN
  candy-sql mysql://root:secret@localhost:3306/mydb
  candy-sql --dsn=mysql://root:secret@localhost:3306/mydb

  # MySQL via individual flags
  CANDY_SQL_PASS=secret candy-sql --driver=mysql --host=localhost --port=3306 --user=root --db=mydb

  # PostgreSQL
  candy-sql pgsql://postgres:pass@db.example.com:5432/mydb
  candy-sql --driver=pgsql --host=db.example.com --port=5432 --user=postgres --pass=pass --db=mydb

HISTORY
  By default every admin poll is recorded to
  $HOME/.candy-sql/history.db (0700 dir / 0600 file), powering the
  Dashboard sparklines and the query-history reports.

  --no-history
    Disable recording entirely (nothing is written to disk).

  --history=<path>
    Store snapshots at <path> instead of the default location.

KEYBOARD SHORTCUTS (TUI)
  Tab         Cycle focus through panes (Tables → Rows → Query → Admin)
  ↑ / ↓       Navigate list rows (or j/k)
  Enter       Load selected table's rows
  Ctrl+Enter  Execute the current query
  Ctrl+R      Execute the current query
  Ctrl+E      Execute the current query
  Ctrl+F      Save the current query to the favorites store
  1-8         Jump to an admin pane (only while the Admin pane is focused)
  q           Quit

SEE ALSO
  https://github.com/sugarcraft/candy-sql

HELP
    );
}

/**
 * Build a DatabaseInterface from CLI arguments.
 *
 * Supports:
 *   - Bare path (e.g. app.sqlite) → SQLite connection
 *   - DSN as first argument (e.g. mysql://user:pass@host:3306/db)
 *   - --dsn=<dsn> → ConnectionFactory::fromDsn()
 *   - --driver=<driver> --db=<db> [--host=<host>] [--port=<port>]
 *     [--user=<user>] [--pass=<pass>] [--ssl-mode=<mode>]
 *
 * @param array<string> $argv Command line arguments (includes script name at index 0)
 * @return DatabaseInterface
 */
function buildDatabase(array $argv): DatabaseInterface
{
    // Filter out the script name at index 0
    $args = array_slice($argv, 1);

    // No arguments → show usage
    if ($args === []) {
        fwrite(STDOUT, "USAGE: candy-sql [OPTIONS] [path-or-dsn]\n");
        fwrite(STDOUT, "       candy-sql --help   # for full usage information\n");
        exit(1);
    }

    // Check if first argument is a bare path (doesn't start with --)
    // or is a DSN string (contains ://)
    $firstArg = $args[0];

    if (!str_starts_with($firstArg, '--') && !str_contains($firstArg, '://')) {
        // Bare path → SQLite connection (default behavior preserved)
        return ConnectionFactory::fromPath($firstArg);
    }

    // Check for DSN as first argument (e.g., mysql://user:pass@host:3306/db)
    if (str_contains($firstArg, '://')) {
        // DSN passed as first argument without --dsn= prefix
        array_unshift($args, '--dsn=' . $firstArg);
    }

    // Parse and build from ConnectionFactory
    return ConnectionFactory::fromArgv(injectPasswordFromEnv($args));
}

/**
 * Fall back to CANDY_SQL_PASS when no --pass= was given: keeps the password
 * out of the world-readable /proc/<pid>/cmdline (docs-review-1023 m6).
 *
 * @param array<string> $args
 * @return array<string>
 */
function injectPasswordFromEnv(array $args): array
{
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--pass=')) {
            return $args; // explicit flag wins
        }
    }
    $fromEnv = getenv('CANDY_SQL_PASS');
    if (is_string($fromEnv) && $fromEnv !== '') {
        $args[] = '--pass=' . $fromEnv;
    }
    return $args;
}

/**
 * Remove the history flags from argv so the connection parser never sees
 * them. --no-history disables persistence; --history=<path> overrides the
 * default store location.
 *
 * @param array<string> $argv
 * @return array<string>
 */
function stripHistoryFlags(array $argv): array
{
    return array_values(array_filter(
        $argv,
        static fn(string $arg): bool => $arg !== '--no-history' && !str_starts_with($arg, '--history=')
    ));
}

/**
 * Resolve the history path from the raw argv (history flags read before strip).
 *
 * Default: $HOME/.candy-sql/history.db, recorded on with no opt-in needed.
 * --no-history wins over --history=<path>. Returns null when disabled or
 * when HOME is unset (no writable well-known location to fall back to).
 */
function resolveHistoryPath(array $argv): ?string
{
    $explicit = null;
    foreach ($argv as $arg) {
        if ($arg === '--no-history') {
            return null;
        }
        if (str_starts_with($arg, '--history=')) {
            $explicit = substr($arg, strlen('--history='));
        }
    }
    if ($explicit !== null && $explicit !== '') {
        return $explicit;
    }
    $home = getenv('HOME');
    if (!is_string($home) || $home === '') {
        return null;
    }
    return rtrim($home, '/') . '/.candy-sql/history.db';
}
