#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // DST-1 (guard shape ported from candy-code/candy-top, measured on PHP
    // 8.3.6): when `php candy-sql.phar` runs, THIS file is the archive's stub
    // and Phar::running() answers '' here; a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. The stub names itself in __FILE__;
    // a require-from-inside names the archive in Phar::running(). Both are
    // addressed the only way that works, as a phar:// URI, and the archive's
    // own vendor becomes the EXCLUSIVE root (a stray vendor beside the phar
    // must never boot the app from outside the frozen archive). Composer
    // mode: both identities are empty and the candidates below are untouched.
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $path = $archive . '/vendor/autoload.php';
        if (!is_file($path)) {
            fwrite(STDERR, "candy-sql: the archive has no vendor/autoload.php — the phar was built without a packaged vendor.\n");
            exit(1);
        }
        require $path;

        return;
    }

    foreach (['vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
        $path = str_starts_with($candidate, '/') ? $candidate : __DIR__ . '/../' . $candidate;
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-sql: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\I18n\T;
use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Sql\Admin\History\HistoryRecorder;
use SugarCraft\Sql\Admin\History\SqliteHistoryStore;
use SugarCraft\Sql\App;
use SugarCraft\Sql\App\AppBuilder;
use SugarCraft\Sql\App\ConnectionPicker;
use SugarCraft\Sql\CellValue;
use SugarCraft\Sql\Db\ConnectionFactory;
use SugarCraft\Sql\Db\ConnectionStore;
use SugarCraft\Sql\Db\DatabaseInterface;
use SugarCraft\Sql\Db\Flavor;
use SugarCraft\Sql\Db\MysqlDatabase;
use SugarCraft\Sql\Db\PostgresDatabase;
use SugarCraft\Sql\Db\SqliteDatabase;
use SugarCraft\Sql\Lang;
use SugarCraft\Sql\Version;

$argv = $argv ?? [];

// client-013: bootstrap the i18n stack. Without this the registry answers
// the default 'en' every launch and the sixteen committed locale files are
// dead weight — this is the repo-documented startup pattern (T::setLocale
// with T::detect from $LANG/$LC_ALL), run before any Lang::t call site can
// fire (the first one is SqliteDatabase's no-file refusal).
T::setLocale(T::detect());

// Handle --help/-h and --version/-V before anything else
$exit = handleGlobalFlags($argv);
if ($exit !== null) {
    exit($exit);
}

try {
    // D-C11: everything that can reject the connection lives between here
    // and the event loop — an unsupported driver, an unparseable DSN, bad
    // credentials, an unwritable history store. Uncaught, each of those
    // died with a raw PHP fatal trace (exit 255), a wall of stack frames
    // burying the one sentence the user needs. Report that sentence,
    // control-byte-free and single-line, and exit 2 — a usage/launch
    // failure, distinct from the autoload refusal's exit 1 above.
    $historyPath = resolveHistoryPath($argv);
    $argv = stripHistoryFlags($argv);

    $database = buildDatabase($argv);

    // Extract flavor from database type
    $flavor = match (true) {
        $database instanceof MysqlDatabase => Flavor::MySQL,
        $database instanceof PostgresDatabase => Flavor::Postgres,
        $database instanceof SqliteDatabase => Flavor::Sqlite,
        default => Flavor::Sqlite,
    };

    // SQL-O17 (candy-sql-once-021): the TUI is a terminal program; piped
    // here it streamed alt-screen and TrueColor bytes forever. The fleet
    // contract is a named exit-2 refusal that says what to do instead —
    // checked after the dial so every input-refusal leg above still answers
    // with ITS own sentence first.
    if (!stream_isatty(STDOUT)) {
        fwrite(STDERR, "candy-sql: this launcher drives an interactive terminal and refuses to stream ANSI onto a pipe (exit 2) — run it under a pty (e.g. script -qec 'candy-sql app.sqlite' /dev/null), or render headless from library code (ResultTable::renderPlain()).\n");
        exit(2);
    }

    // SQL-O18 (candy-sql-once-042): react/mysql is pinned to an untagged
    // 0.7.x-dev float by documented law (PB-SQL-13 — the tagless supply
    // choice lives in ReactMysqlConnection's docblock). A branch-HEAD break
    // must answer loudly at launch, not mid-pane the first time the Admin
    // dashboard reaches for the async transport.
    if ($database instanceof MysqlDatabase && !class_exists('React\Mysql\MysqlClient')) {
        throw new \RuntimeException(
            'the react/mysql MysqlClient class is missing from vendor — reinstall dependencies'
            . ' (candy-sql requires react/mysql 0.7.x-dev for the async admin transport)',
        );
    }

    $historyRecorder = null;
    if ($historyPath !== null) {
        // D-M11: the history store is an offline audit trail, not a boot
        // dependency. A corrupt or unsecureable file warns once and the
        // session runs without snapshots - the whole client used to exit 2
        // over an unreadable $HOME/.candy-sql/history.db.
        try {
            $historyRecorder = new HistoryRecorder(new SqliteHistoryStore($historyPath));
        } catch (\Throwable $e) {
            fwrite(STDERR, sprintf(
                "candy-sql: history recording DISABLED (%s): %s\n",
                CellValue::sanitize($historyPath),
                CellValue::sanitize($e->getMessage() !== '' ? $e->getMessage() : $e::class),
            ));
        }
    }

    // One-time loud notice BEFORE the alt screen swallows the shell: a
    // TLS-verifying ssl-mode refuses the plaintext-capable React transport,
    // so admin live-refresh stands down and queries run synchronously
    // (App::asyncTransportRefusedByTls(); the in-app status line keeps the
    // state visible for the whole session).
    if ($database instanceof MysqlDatabase && MysqlDatabase::requiresVerifiedTls($database->sslMode())) {
        fwrite(STDERR, sprintf(
            "candy-sql: ssl-mode '%s' demands verified TLS — the ReactPHP admin transport cannot honour it,"
            . " so admin live-refresh is DISABLED and queries/table loads run synchronously over the TLS connection.\n",
            $database->sslMode(),
        ));
    }

    (new Program(
        App::start($database, $flavor, $historyRecorder),
        // D-M13: bracketed paste makes the terminal wrap pasted bytes in
        // ESC[200~ / ESC[201~ so the decoder emits one PasteMsg instead of
        // spraying the paste's control bytes (ESC especially) as live keys.
        new ProgramOptions(useAltScreen: true, bracketedPaste: true),
    ))->run();
} catch (\Throwable $e) {
    $reason = $e->getMessage() !== '' ? $e->getMessage() : $e::class;
    fwrite(STDERR, sprintf("candy-sql: %s\n", CellValue::sanitize($reason)));
    exit(2);
}

/**
 * Print help or handle version flag, return exit code or null to continue.
 *
 * @param array<string> $argv
 * @return int|null null means "continue", int means "exit with this code"
 */
function handleGlobalFlags(array $argv): ?int
{
    $args = array_slice($argv, 1);
    $hasHelp = false;
    $hasVersion = false;

    foreach ($args as $arg) {
        // Normalize: strip leading dashes, split on =, take the flag name
        $normalized = ltrim($arg, '-');
        if (str_contains($normalized, '=')) {
            [$flag] = explode('=', $normalized, 2);
        } else {
            $flag = $normalized;
        }

        if (in_array($flag, ['h', 'help'], true)) {
            $hasHelp = true;
        }
        if (in_array($flag, ['V', 'version'], true)) {
            $hasVersion = true;
        }
    }

    if ($hasVersion) {
        // Phar-aware (DST-1): inside an archive the stamped build metadata
        // wins; in composer mode the answer stays the installed package's own
        // Composer metadata (the 14a7e605a contract) — never a frozen literal.
        fwrite(STDOUT, 'candy-sql ' . Version::current() . "\n");
        return 0;
    }

    if ($hasHelp) {
        showHelp();
        return 0;
    }

    return null;
}

/**
 * Print the full help screen.
 */
function showHelp(): void
{
    fwrite(STDOUT, <<<'HELP'
candy-sql - Terminal SQL client for SQLite, MySQL and PostgreSQL

USAGE
  candy-sql [OPTIONS] [path-or-dsn]

ARGUMENTS
  path-or-dsn
    SQLite database file path, e.g.: app.sqlite
    Or a DSN string, e.g.:  mysql://user:pass@localhost:3306/dbname

  When omitted entirely: on an interactive terminal with saved
  connections, a picker offers them; otherwise a short usage line is
  printed and the process exits with status 2 (bad invocation) — run
  --help for this full screen.

OPTIONS
  --help, -h
    Show this help screen.

  --version, -V
    Show the version number.

  --connect=<name>
    Dial the named entry from the saved-connections file
    ($XDG_CONFIG_HOME/candy-sql/connections.json, defaulting to
    $HOME/.config/candy-sql/connections.json). Cannot be combined
    with explicit connection arguments. Passwords are never stored
    on disk: an entry names its secret via "pass-env" and the
    variable is read at dial time. See SAVED CONNECTIONS below.

  --dsn=<dsn>
    Full DSN connection string.
    Format: <driver>://<user>:<pass>@<host>:<port>/<dbname>[?ssl-mode=<mode>]
    Examples:
      mysql://root:secret@localhost:3306/mydb?ssl-mode=require
      pgsql://postgres:pass@db.example.com:5432/production
      sqlite:///var/data/app.sqlite
      sqlite://:memory:

  --driver=<driver>
  --db=<dbname>
  --host=<host>
  --port=<port>
  --user=<user>
  --pass=<pass>
  --ssl-mode=<mode>
    Individual connection parameters (all except --driver and --db are optional).
    --driver must be one of: sqlite, mysql, pgsql
    --ssl-mode defaults to "prefer" for MySQL. "require" and "verify_*" enforce
    TLS with server-certificate verification; CA trust must be configured
    server-side or via my.cnf (see README). In those verified modes the
    plaintext-capable ReactPHP transport is refused — queries run
    synchronously over the TLS connection and admin live-refresh is disabled
    (a startup notice and the in-app status line say so).
    Prefer CANDY_SQL_PASS over --pass= to keep the password out of the
    process command line (visible in ps).

EXAMPLES
  # SQLite (default — bare path or DSN)
  candy-sql app.sqlite
  candy-sql sqlite:///var/data/app.sqlite
  candy-sql sqlite://:memory:

  # MySQL via DSN
  candy-sql mysql://root:secret@localhost:3306/mydb
  candy-sql --dsn=mysql://root:secret@localhost:3306/mydb

  # MySQL via individual flags
  CANDY_SQL_PASS=secret candy-sql --driver=mysql --host=localhost --port=3306 --user=root --db=mydb

  # PostgreSQL
  candy-sql pgsql://postgres:pass@db.example.com:5432/mydb
  candy-sql --driver=pgsql --host=db.example.com --port=5432 --user=postgres --pass=pass --db=mydb

SAVED CONNECTIONS
  List named servers once, dial them forever:

    $HOME/.config/candy-sql/connections.json  (dir 0700, file 0600)

    {
      "connections": {
        "prod":  {"driver": "mysql", "host": "db.example.com",
                  "port": "3306", "user": "app", "db": "shop",
                  "ssl-mode": "verify_identity", "pass-env": "PROD_DB_PASS"},
        "local": {"driver": "pgsql", "host": "127.0.0.1",
                  "port": "5432", "user": "pg", "db": "dev"}
      }
    }

  Fields: driver (sqlite|mysql|pgsql), host, port, user, db, ssl-mode,
  pass-env. Any other field is refused, and a plaintext "pass" field
  is always refused — point pass-env at a variable instead. A launch
  with no arguments on an interactive terminal presents these entries
  as a picker; --connect=<name> dials one directly.

HISTORY
  By default every admin poll snapshot is recorded to
  $HOME/.candy-sql/history.db (0700 dir / 0600 file) as an offline
  audit trail. The in-app Dashboard and Reports pages do not read
  from this file — they poll the live server.

  --no-history
    Disable recording entirely (nothing is written to disk).

  --history=<path>
    Store snapshots at <path> instead of the default location.

KEYBOARD SHORTCUTS (TUI)
  Tab          Cycle focus through panes (Tables → Rows → Query → Admin)
  ↑ / ↓        Navigate list rows (or j/k) — in the Tables pane a move is
               local only; it never fetches a preview
  /            (Tables pane) open a live filter line over table names;
               letters extend it, ↑/↓ move the cursor, Enter commits and
               loads, Backspace edits, Esc abandons and clears
  Enter        Load selected table's rows
  Space        Load selected table's rows (alias for Enter)
  PgDn / PgUp  (Tables/Rows pane, on a table preview) page the preview in
               100-row windows — the browse cap became a page size
  Ctrl+Enter   Execute the current query
  Ctrl+R       Execute the current query
  Ctrl+E       Execute the current query
  Ctrl+F       Add the current query to the favorites list (session
               state only — no pane browses it, and it is not persisted)
  Ctrl+Shift+F Remove the current query from the favorites list
  1-8          Jump to an admin pane (only while the Admin pane is focused)
  q            Quit from the Tables/Rows panes; returns to Tables from Admin
  Esc          Quit from the Tables/Rows panes; cancels an open Admin dialog
  Backspace    Delete the character before the cursor (Query editor)

SEE ALSO
  https://github.com/sugarcraft/candy-sql

HELP
    );
}

/**
 * Build a DatabaseInterface from CLI arguments.
 *
 * Supports:
 *   - Bare path (e.g. app.sqlite) → SQLite connection
 *   - DSN as first argument (e.g. mysql://user:pass@host:3306/db)
 *   - --dsn=<dsn> → ConnectionFactory::fromDsn()
 *   - --connect=<name> → saved entry expanded (SQL-O02)
 *   - no-arg interactive launch → saved-connection picker (SQL-O02b)
 *   - --driver=<driver> --db=<db> [--host=<host>] [--port=<port>]
 *     [--user=<user>] [--pass=<pass>] [--ssl-mode=<mode>]
 *
 * @param array<string> $argv Command line arguments (includes script name at index 0)
 * @return DatabaseInterface
 */
function buildDatabase(array $argv): DatabaseInterface
{
    // Filter out the script name at index 0
    $args = array_slice($argv, 1);
    $store = ConnectionStore::open();

    // SQL-O02a: --connect=<name> dials a saved connection. The flag is
    // expanded here (bin level) rather than passed to ConnectionFactory, so
    // the factory's unknown-option contract stays untouched and combination
    // refusals name the launch grammar the user actually typed.
    [$connectName, $args] = extractConnectFlag($args);
    if ($connectName !== null) {
        if ($args !== []) {
            throw new \InvalidArgumentException(
                '--connect cannot be combined with explicit connection arguments (the saved entry is the connection)',
            );
        }
        if ($store === null) {
            throw new \RuntimeException(
                'No HOME or XDG_CONFIG_HOME — the connections file cannot be located; pass a DSN instead',
            );
        }
        return ConnectionFactory::fromArgv(injectPasswordFromEnv($store->argv($connectName)));
    }

    // No arguments → the picker for a live terminal with saved connections
    // (SQL-O02b), the guided usage refusal everywhere else.
    if ($args === []) {
        if ($store !== null && stream_isatty(STDOUT) && $store->names() !== []) {
            $final = (new Program(
                new ConnectionPicker($store->all()),
                new ProgramOptions(useAltScreen: true),
            ))->run();
            if (!$final instanceof ConnectionPicker) {
                throw new \LogicException('the picker program returned a foreign model');
            }
            $picked = $final->pickedName();
            if ($picked === null) {
                fwrite(STDERR, "candy-sql: no connection selected — pass a path, a DSN or --connect=<name>\n");
                exit(2);
            }
            return ConnectionFactory::fromArgv(injectPasswordFromEnv($store->argv($picked)));
        }
        fwrite(STDOUT, "USAGE: candy-sql [OPTIONS] [path-or-dsn]\n");
        fwrite(STDOUT, "       candy-sql --help   # for full usage information\n");
        if ($store !== null && $store->names() === []) {
            fwrite(STDOUT, "       Tip: save named connections in {$store->path()} and launch with --connect=<name>.\n");
        }
        exit(2);
    }

    // Check if first argument is a bare path (doesn't start with --)
    // or is a DSN string (contains ://)
    $firstArg = $args[0];

    if (!str_starts_with($firstArg, '--') && !str_contains($firstArg, '://')) {
        // Bare path → SQLite connection (default behavior preserved)
        return ConnectionFactory::fromPath($firstArg);
    }

    // Check for DSN as first argument (e.g., mysql://user:pass@host:3306/db)
    if (str_contains($firstArg, '://')) {
        // DSN passed as first argument without --dsn= prefix
        array_unshift($args, '--dsn=' . $firstArg);
    }

    // Parse and build from ConnectionFactory
    return ConnectionFactory::fromArgv(injectPasswordFromEnv($args));
}

/**
 * Split the `--connect=<name>` flag out of an argv tail.
 *
 * @param list<string> $args
 * @return array{0: ?string, 1: list<string>} the name (null when absent) and the remaining args
 */
function extractConnectFlag(array $args): array
{
    $name = null;
    $rest = [];
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--connect=')) {
            if ($name !== null) {
                throw new \InvalidArgumentException('Option --connect may be given only once');
            }
            $value = substr($arg, strlen('--connect='));
            if ($value === '') {
                throw new \InvalidArgumentException('Option --connect requires a value');
            }
            $name = $value;
            continue;
        }
        $rest[] = $arg;
    }
    return [$name, $rest];
}

/**
 * Fall back to CANDY_SQL_PASS when no --pass= was given: keeps the password
 * out of the world-readable /proc/<pid>/cmdline (review m6).
 *
 * @param array<string> $args
 * @return array<string>
 */
function injectPasswordFromEnv(array $args): array
{
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--pass=')) {
            return $args; // explicit flag wins
        }
    }
    $fromEnv = getenv('CANDY_SQL_PASS');
    if (is_string($fromEnv) && $fromEnv !== '') {
        $args[] = '--pass=' . $fromEnv;
    }
    return $args;
}

/**
 * Remove the history flags from argv so the connection parser never sees
 * them. --no-history disables persistence; --history=<path> overrides the
 * default store location.
 *
 * @param array<string> $argv
 * @return array<string>
 */
function stripHistoryFlags(array $argv): array
{
    return array_values(array_filter(
        $argv,
        static fn(string $arg): bool => $arg !== '--no-history' && !str_starts_with($arg, '--history=')
    ));
}

/**
 * Resolve the history path from the raw argv (history flags read before strip).
 *
 * Default: $HOME/.candy-sql/history.db, recorded on with no opt-in needed.
 * --no-history wins over --history=<path>. Returns null when disabled or
 * when HOME is unset (no writable well-known location to fall back to).
 */
function resolveHistoryPath(array $argv): ?string
{
    $explicit = null;
    foreach ($argv as $arg) {
        if ($arg === '--no-history') {
            return null;
        }
        if (str_starts_with($arg, '--history=')) {
            $explicit = substr($arg, strlen('--history='));
        }
    }
    if ($explicit !== null && $explicit !== '') {
        return $explicit;
    }
    $home = getenv('HOME');
    if (!is_string($home) || $home === '') {
        return null;
    }
    return rtrim($home, '/') . '/.candy-sql/history.db';
}
