{
    "name": "sugarcraft/sugar-quickpick",
    "description": "Fuzzy finder / quick-pick overlay for terminal UIs. Wraps a background view, renders a filterable, rankable list overlay on top with borders and styles, background continues to update underneath. JSONL-backed selection history. Inspired by Genekkion/theHermit (Go); developed as a native PHP project.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "fuzzy",
        "finder",
        "overlay",
        "quickfix",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-quickpick",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-quickpick/issues",
        "source": "https://github.com/sugarcraft/sugar-quickpick",
        "docs": "https://sugarcraft.github.io/lib/sugar-quickpick.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-fuzzy": "dev-master",
        "sugarcraft/sugar-style": "dev-master",
        "sugarcraft/sugar-pty": "dev-master"
    },
    "suggest": {
        "ext-pcntl": "Required for QuickPick::attachSigwinch() to re-render the overlay on SIGWINCH terminal resizes."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\QuickPick\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\QuickPick\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
