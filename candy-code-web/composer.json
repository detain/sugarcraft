{
    "name": "sugarcraft/candy-code-web",
    "description": "Browser UI for candy-code's WebSocket server mode, shipped as a pre-built Vite + Vue 3 bundle with a one-class PHP shim that locates it. `candy-code serve` serves it on the same port, so PHP users need no Node.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sugarcraft",
        "candy-code",
        "crush",
        "web-ui",
        "vue",
        "vite",
        "ai",
        "websocket"
    ],
    "homepage": "https://github.com/sugarcraft/candy-code-web",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-code-web/issues",
        "source": "https://github.com/sugarcraft/candy-code-web",
        "docs": "https://sugarcraft.github.io/lib/candy-code-web.html"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\CodeWeb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\CodeWeb\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/node_modules",
            "/src-web",
            "/public",
            "/e2e",
            "/package.json",
            "/package-lock.json",
            "/.nvmrc",
            "/index.html",
            "/env.d.ts",
            "/vite.config.ts",
            "/tsconfig.json",
            "/tsconfig.app.json",
            "/tsconfig.node.json",
            "/eslint.config.js",
            "/scripts",
            "/playwright.config.ts",
            "/tsconfig.vitest.json",
            "/tsconfig.e2e.json",
            "/playwright-report",
            "/test-results"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
