{
    "name": "sugarcraft/sugar-readline",
    "description": "Interactive line-editing prompts for terminal UIs \u2014 text input with validation/completion/hidden-password mode, selection prompts with filtering/pagination/cursor navigation, multi-select prompts, confirmation prompts and multi-line textarea input. Design antecedent: erikgeiser/promptkit; developed as a native PHP project.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "prompt",
        "readline",
        "input",
        "selection",
        "interactive",
        "promptkit",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-readline",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-readline/issues",
        "source": "https://github.com/sugarcraft/sugar-readline",
        "docs": "https://sugarcraft.github.io/lib/sugar-readline.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-core": "@dev",
        "sugarcraft/sugar-forms": "@dev",
        "sugarcraft/sugar-input": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Readline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Readline\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
