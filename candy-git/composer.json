{
    "name": "sugarcraft/candy-git",
    "description": "Terminal Git client \u2014 a TUI for staging, branching, log, diff, stash, worktrees and rebase on the SugarCraft stack.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "cli",
        "git",
        "lazygit",
        "sugarcraft"
    ],
    "homepage": "https://sugarcraft.github.io/lib/candy-git.html",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-git/issues",
        "source": "https://github.com/sugarcraft/candy-git",
        "docs": "https://sugarcraft.github.io/lib/candy-git.html"
    },
    "bin": [
        "bin/candy-git"
    ],
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-colorprofile": "dev-master",
        "sugarcraft/sugar-async": "dev-master",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-style": "dev-master",
        "sugarcraft/sugar-fuzzy": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Git\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Git\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "sugarcraft": {
            "deferred-wiring": {
                "sugarcraft/sugar-colorprofile": "P1-10a: ColorProfile::detect() delegates to sugarcraft/sugar-colorprofile's DetectionChain when that package is installed, behind a class_exists guard, so src/ never names its namespace. The require is what makes the chain answer colour; without it the call falls back to Ascii (no colour, text kept)."
            }
        }
    }
}
