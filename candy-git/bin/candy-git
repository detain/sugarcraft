#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // Guard shape ported from candy-code/candy-top (DST-1, measured on PHP
    // 8.3.6): when `php candy-git.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Two identities cover the two phar
    // shapes: the stub names itself in __FILE__, and a require-from-inside
    // names the archive in Phar::running(). Both are addressed the only way
    // that works, as a phar:// URI. When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-git: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Git\App;
use SugarCraft\Git\Git;
use SugarCraft\Git\Lang;
use SugarCraft\Git\Support\Version;

// Answered before the repository probe: a packaging script or a bug report
// runs these first, possibly from a directory that is not a repo at all.
$flags = array_slice($argv ?? [], 1);
if (in_array('--version', $flags, true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}
if (in_array('--help', $flags, true) || in_array('-h', $flags, true)) {
    fwrite(STDOUT, "candy-git — terminal git interface\n\n"
        . "Usage:\n"
        . "  candy-git            Browse the repository of the current directory\n"
        . "  candy-git --version  Print the version\n"
        . "  candy-git --help     Show this help\n");
    exit(0);
}

$cwd = getcwd();
// Probe via git itself rather than is_dir("$cwd/.git") so we launch inside a
// LINKED worktree too, where `.git` is a file (gitdir pointer), not a dir.
if ($cwd === false || !Git::isRepository($cwd)) {
    fwrite(STDERR, Lang::t('cli.not_a_repo', ['cwd' => (string) $cwd]) . "\n");
    exit(1);
}
(new Program(App::start(new Git($cwd)), new ProgramOptions(useAltScreen: true)))->run();
