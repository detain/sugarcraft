#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function () {
    // Guard shape ported from candy-code/candy-top (DST-1, measured on PHP
    // 8.3.6): when `php candy-git.phar` runs, THIS file is the archive's
    // stub and the process is NOT inside the archive — Phar::running()
    // answers '' there, and a bare '/x.phar/entry' path fails
    // is_file()/require for every caller. Two identities cover the two phar
    // shapes: the stub names itself in __FILE__, and a require-from-inside
    // names the archive in Phar::running(). Both are addressed the only way
    // that works, as a phar:// URI. When an archive identity exists, the
    // archive's own vendor is the ONLY root — a stray vendor beside (or
    // above) a downloaded phar must never boot the app with code from
    // outside the frozen archive. In every composer-mode checkout both
    // probes answer nothing and the filesystem candidates are untouched.
    $candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
    $archive = \Phar::running(false) !== ''
        ? 'phar://' . \Phar::running(false)
        : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
    if ($archive !== '') {
        $candidates = [$archive . '/vendor/autoload.php'];
    }
    foreach ($candidates as $path) {
        if (is_file($path)) {
            require $path;
            return;
        }
    }
    fwrite(STDERR, "candy-git: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\Core\I18n\T;
use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Core\Util\ColorProfile;
use SugarCraft\Git\App;
use SugarCraft\Git\TerminalGate;
use SugarCraft\Git\Git;
use SugarCraft\Git\Lang;
use SugarCraft\Git\Process;
use SugarCraft\Git\Support\GitRequirement;
use SugarCraft\Git\Support\Version;

// Adopt the user's locale before the first translated string is emitted.
// Without this the lang/ catalogue stays dead code: every message ships in
// English no matter what LANG says (audit A15).
T::setLocale(T::detect());

// Answered before the repository probe: a packaging script or a bug report
// runs these first, possibly from a directory that is not a repo at all.
$flags = array_slice($argv ?? [], 1);
if (in_array('--version', $flags, true)) {
    fwrite(STDOUT, Version::line());
    exit(0);
}
if (in_array('--help', $flags, true) || in_array('-h', $flags, true)) {
    // The help screen is canonical user-facing copy (candy-git-019): the
    // catalogue and locale are already loaded above, so nothing here may
    // bypass Lang::t. The command spellings are identifiers, not prose —
    // they stay literal while their descriptions translate.
    fwrite(STDOUT, Lang::t('cli.help_summary') . "\n\n"
        . Lang::t('cli.help_usage') . "\n"
        . '  candy-git            ' . Lang::t('cli.help_browse') . "\n"
        . '  candy-git --version  ' . Lang::t('cli.help_version') . "\n"
        . '  candy-git --help     ' . Lang::t('cli.help_help') . "\n");
    exit(0);
}
// Any leftover argument is one we do not serve — exiting 2 (the usage
// convention) beats silently booting a TUI that ignored what it was given.
foreach ($flags as $stray) {
    fwrite(STDERR, Lang::t('cli.unknown_flag', ['flag' => (string) $stray]) . "\n");
    fwrite(STDERR, Lang::t('cli.try_help') . "\n");
    exit(2);
}

// Preflight the binary itself: a missing or ancient git must surface as one
// readable sentence here, not as a stack trace from the first repository
// probe (or, worse, mid-operation failures on verbs like `git restore`).
try {
    $probe = Process::run(['git', '--version'], null, 10.0);
} catch (\RuntimeException $e) {
    // "git is not installed" and "git is installed but would not launch"
    // are different problems: only the first gets the install hint; the
    // second surfaces the OS reason (git.spawn_failed carries it).
    fwrite(STDERR, (\SugarCraft\Git\Platform::new()->findExecutable('git') === null
        ? Lang::t('cli.no_git')
        : 'candy-git: ' . $e->getMessage()) . "\n");
    exit(1);
}
$gitVersion = $probe['exit'] === 0 ? GitRequirement::parse((string) $probe['stdout']) : null;
if ($gitVersion === null) {
    fwrite(STDERR, Lang::t('cli.no_git') . "\n");
    exit(1);
}
if (!GitRequirement::satisfies($gitVersion)) {
    fwrite(STDERR, Lang::t('cli.old_git', [
        'version' => $gitVersion,
        'min'     => GitRequirement::MINIMUM,
    ]) . "\n");
    exit(1);
}

$cwd = getcwd();
// Probe via git itself rather than is_dir("$cwd/.git") so we launch inside a
// LINKED worktree too, where `.git` is a file (gitdir pointer), not a dir.
try {
    $inRepository = $cwd !== false && Git::isRepository($cwd);
} catch (\RuntimeException $e) {
    // "git is not installed" and "git is installed but would not launch"
    // are different problems: only the first gets the install hint; the
    // second surfaces the OS reason (git.spawn_failed carries it).
    fwrite(STDERR, (\SugarCraft\Git\Platform::new()->findExecutable('git') === null
        ? Lang::t('cli.no_git')
        : 'candy-git: ' . $e->getMessage()) . "\n");
    exit(1);
}
if (!$inRepository) {
    fwrite(STDERR, Lang::t('cli.not_a_repo', ['cwd' => (string) $cwd]) . "\n");
    exit(1);
}
try {
    $bare = Git::isBareRepository($cwd);
} catch (\RuntimeException) {
    $bare = false; // probe hiccup must not refuse a good work tree
}
if ($bare) {
    fwrite(STDERR, Lang::t('cli.bare_repo', ['cwd' => (string) $cwd]) . "\n");
    exit(1);
}
// The UI is a full-screen alt-buffer program; piping its output would emit
// unlabelled escape-sequence soup. But stream_isatty() only describes the
// STREAM, so mintty-class consoles (whose std handles are named pipes with a
// real console behind them) and one-sided redirects (< file, EOF stdin) get
// their answer from sugar-core's terminal probe, not the raw flag: refuse
// only when NO terminal is reachable (candy-git-055, candy-git-124).
$gate = TerminalGate::decide(
    stream_isatty(STDOUT),
    stream_isatty(STDIN),
    PHP_OS_FAMILY === 'Windows',
    static fn(): ?array => \SugarCraft\Core\Util\Tty::openTty(),
);
if (!$gate['boot']) {
    fwrite(STDERR, Lang::t((string) $gate['key']) . "\n");
    exit(1);
}
$gateStreams = $gate['streams'] ?? [STDIN, STDOUT];
// candy-git-052: a dumb terminal cannot act on alt-screen or cursor
// addressing at all — Program writes those sequences raw and sugar-style
// never sees them. Boot inline (the cursor modeline and plain text carry
// the UI) and hand Program the already-detected profile so detection runs
// once, here, not a second time inside the loop.
$profile = ColorProfile::detect(stdout: $gateStreams[1]);
(new Program(App::start(new Git($cwd)), new ProgramOptions(useAltScreen: $profile !== ColorProfile::NoTty, bracketedPaste: true, colorProfile: $profile, input: $gateStreams[0], output: $gateStreams[1])))->run();
