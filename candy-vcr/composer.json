{
    "name": "sugarcraft/candy-vcr",
    "description": "Record and replay sugar-core Program sessions into cassettes, render VHS .tape scripts to GIFs \u2014 bug-repro / regression / fuzzing.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "ansi",
        "vcr",
        "record",
        "replay",
        "cassette",
        "sugarcraft",
        "vhs",
        "gif",
        "tape",
        "asciinema"
    ],
    "homepage": "https://github.com/sugarcraft/candy-vcr",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-vcr/issues",
        "source": "https://github.com/sugarcraft/candy-vcr",
        "docs": "https://sugarcraft.github.io/lib/candy-vcr.html"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-ansi-parser": "dev-master",
        "sugarcraft/sugar-pty": "dev-master",
        "sugarcraft/sugar-vterm": "dev-master",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.65",
        "sugarcraft/sugar-testing": "dev-master",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "ext-gd": "Required by the default gd rasterizer backend (render-tape / render-batch GIF output); TapeToGif::new() fails loud when it is absent.",
        "ext-imagick": "Enables --backend=imagick for the ImageMagick rasterizer path in place of gd.",
        "symfony/yaml": "Enables YamlFormat for human-readable cassettes (test fixtures, hand-written replays); JsonlFormat is the primary format."
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\Vcr\\": "src/"
        }
    },
    "bin": [
        "bin/candy-vcr"
    ],
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\Vcr\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
