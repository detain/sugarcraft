#!/usr/bin/env php
<?php

declare(strict_types=1);

// Resolve the autoloader. Works when run from:
//   - the lib's own vendor/ (development): ../vendor/autoload.php
//   - a parent project's vendor/bin shim (path-repo or copy):
//       Composer 2.5+ sets $GLOBALS['_composer_autoload_path'].
//   - a parent project that installed candy-vcr from Packagist:
//       __DIR__ . '/../../../autoload.php' resolves to the parent vendor.
//   - via `php vendor/bin/candy-vcr` where vendor/bin is a Composer
//     proxy script that already required the autoload before delegating.
//   - as a phar archive: the archive's own vendor/, addressed as phar://
//     (see the DST-1 block below).
$autoload = null;

// DST-1 (guard shape ported from candy-code/candy-top, measured on PHP 8.3.6):
// when `php candy-vcr.phar` runs, THIS file is the archive's stub and the
// process is NOT inside the archive — Phar::running() answers '' in exactly
// this context, and a bare '/x.phar/entry' path fails is_file()/require for
// every caller. Two identities therefore cover the two phar shapes: the stub
// names itself in __FILE__, and a require-from-inside names the archive in
// Phar::running(). Both are addressed the only way that works, as a phar://
// URI. The archive's own vendor is then the ONLY root — a stray vendor beside
// (or above) a downloaded phar must never boot the app with code from outside
// the frozen archive — so the $GLOBALS hint and the filesystem candidates
// below are skipped entirely when the archive identity exists. In every
// composer-mode checkout Phar::running() is '' and __FILE__ is not a .phar,
// so the arms below are byte-untouched.
$archive = \Phar::running(false) !== ''
    ? 'phar://' . \Phar::running(false)
    : (str_ends_with(__FILE__, '.phar') ? 'phar://' . __FILE__ : '');
if ($archive !== '') {
    $path = $archive . '/vendor/autoload.php';
    if (!is_file($path)) {
        // A phar without its own vendor/ is a build defect, not a fallback
        // case: booting from an outside vendor would run code the frozen
        // archive does not contain, which is the exact lie the guard exists
        // to prevent. Fail loud.
        \fwrite(\STDERR, "candy-vcr: the archive has no vendor/autoload.php — the phar was built without a packaged vendor.\n");
        exit(1);
    }
    require $path;

    exit((new SugarCraft\Vcr\Cli\Application())->run($argv, STDOUT, STDERR));
}

if (isset($GLOBALS['_composer_autoload_path']) && \is_string($GLOBALS['_composer_autoload_path'])) {
    if (\file_exists($GLOBALS['_composer_autoload_path'])) {
        $autoload = $GLOBALS['_composer_autoload_path'];
    }
}

if ($autoload === null) {
    $candidates = [
        __DIR__ . '/../vendor/autoload.php',                  // candy-vcr standalone
        __DIR__ . '/../../../autoload.php',                   // installed under <root>/vendor/sugarcraft/candy-vcr/bin/
        __DIR__ . '/../../../../vendor/autoload.php',         // path-repo symlink one extra level deep
        \dirname(__DIR__, 2) . '/vendor/autoload.php',        // parent dir alongside candy-vcr
        \dirname(__DIR__, 3) . '/vendor/autoload.php',        // grandparent dir (monorepo root)
    ];
    foreach ($candidates as $candidate) {
        if (\file_exists($candidate)) {
            $autoload = $candidate;
            break;
        }
    }
}

if ($autoload === null) {
    $scanned = [];
    if (isset($GLOBALS['_composer_autoload_path'])) {
        $scanned[] = (string) $GLOBALS['_composer_autoload_path'] . ' (from $GLOBALS)';
    }
    foreach ([
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
        __DIR__ . '/../../../../vendor/autoload.php',
        \dirname(__DIR__, 2) . '/vendor/autoload.php',
        \dirname(__DIR__, 3) . '/vendor/autoload.php',
    ] as $c) {
        $scanned[] = $c;
    }
    \fwrite(\STDERR, "candy-vcr: cannot locate vendor/autoload.php\n");
    \fwrite(\STDERR, "candy-vcr: tried: \n  - " . \implode("\n  - ", $scanned) . "\n");
    exit(1);
}
require $autoload;

use SugarCraft\Vcr\Cli\Application;

exit((new Application())->run($argv, STDOUT, STDERR));
