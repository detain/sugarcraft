#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CandyGitServer — Self-hostable Git Server
 *
 * Usage:
 *   candy-git-server serve [--config path]        Refuses: server assembly not implemented
 *   candy-git-server serve --http --repo-root DIR  Smart-HTTP clone/fetch/push + LFS listener (--http-port N [--http-host H] [--config path])
 *   candy-git-server init                          Initialize a new data directory
 *   candy-git-server user add <username>           Add a user
 *   candy-git-server user key <username> <keyfile> Add an SSH key
 *   candy-git-server user remove <username>        Delete an account
 *   candy-git-server user deactivate <username>    Disable an account, keep its credentials
 *   candy-git-server repo list                     List repos
 *   candy-git-server repo create <name>            Create a repo
 *   candy-git-server repo collaborator <n> add|remove <user>   Manage the persisted ACL
 *   candy-git-server repo mirror <n> <url>|--clear Set/clear the upstream
 *   candy-git-server repo push-access <n> allow|deny           Toggle the allowPush posture
 *   candy-git-server help                          Show this help
 *
 * PHP port of the charmbracelet/soft-serve Go project; the binary was
 * named `soft-serve` before the 2026-10 rename to candy-git-server.
 * STATUS: scaffold for the ssh/daemon host wiring — bare `serve` still
 * refuses (no assembled multi-transport entrypoint); `serve --http`
 * starts the smart-HTTP listener: clone, fetch, push (auth-gated) and
 * LFS. See README "Known gaps". // @rename-keep
 */

namespace SugarCraft\GitServer\Bin;

// ---------------------------------------------------------------------------
// Autoloader (archive-aware). A phar build stamps THIS file as the archive
// stub, so under `php candy-git-server.phar` __FILE__ names the archive; the
// bundled vendor/ inside it is then the only correct source. Measured PHP 8.3
// law: in the stub context \Phar::running(false) answers '' (so a bare
// '/x.phar/entry' path — and any 'phar://'.running() — fails to locate it),
// and a required-from-inside file instead reports the archive via
// running(false). Handle BOTH identities, and once an archive is found drop
// the filesystem candidates entirely — a working-tree vendor sitting beside a
// published .phar must never outrank the archive it ships in.
// ---------------------------------------------------------------------------
(static function (): void {
    $archive = str_ends_with(__FILE__, '.phar')
        ? 'phar://' . __FILE__
        : (\Phar::running(false) !== '' ? 'phar://' . \Phar::running(false) : '');
    $candidates = $archive !== ''
        ? [$archive . '/vendor/autoload.php']
        : [__DIR__ . '/../vendor/autoload.php'];
    foreach ($candidates as $candidate) {
        if (is_file($candidate)) {
            require $candidate;
            return;
        }
    }
    fwrite(STDERR, "candy-git-server: cannot find composer autoload.php\n");
    exit(1);
})();

use SugarCraft\GitServer\{Config, Lang, Repo, User, UserStore, Visibility};
use SugarCraft\GitServer\Support\AtomicWriter;

// Pre-rename env compatibility (plan_rename.md R4.5): CANDY_SERVE_DATA_PATH was // @rename-keep
// this app's data-dir var before the 2026-10 rename. Import any old-prefix
// exports under the new name (new name always wins), then warn once per var.
foreach (\SugarCraft\Core\Util\LegacyEnv::import([
    'CANDY_SERVE_' => 'CANDY_GIT_SERVER_', // @rename-keep
]) as $legacyVar) {
    fwrite(STDERR, "candy-git-server: {$legacyVar} is deprecated; set CANDY_GIT_SERVER_DATA_PATH instead.\n"); // @rename-keep
}

const VERSION = '0.1.0';

/**
 * Absolute filesystem path of the running .phar, or '' when not executing
 * inside one. Under the stub __FILE__ is the archive path; a file required
 * from inside instead reports it through \Phar::running(false). Read the stamp
 * identically whichever identity is live. (This is the plain path, NOT a
 * phar:// URL — \Phar's constructor and is_file() both want the real file.)
 */
function runningArchivePath(): string
{
    if (str_ends_with(__FILE__, '.phar')) {
        return __FILE__;
    }
    $running = \Phar::running(false);

    return $running !== '' ? $running : '';
}

/**
 * Version the CLI prints: the archive's build stamp when running inside a
 * phar (the DST-1 law — InstalledVersions lies under a frozen vendor/), else
 * the compiled-in VERSION constant.
 */
function displayVersion(): string
{
    return \SugarCraft\GitServer\Support\Version::resolve(runningArchivePath(), VERSION);
}

function main(array $argv): int
{
    // Locale selection reaches the wire: CANDY_GIT_SERVER_LANG picks the
    // translation catalogue; unknown locales fall through to English.
    $locale = \getenv('CANDY_GIT_SERVER_LANG');
    if (\is_string($locale) && $locale !== '') {
        \SugarCraft\Core\I18n\T::setLocale($locale);
    }

    array_shift($argv);  // drop script name
    $command = $argv[0] ?? 'help';
    $args    = \array_slice($argv, 1);

    return match ($command) {
        'serve'  => cmdServe($args),
        'init'   => cmdInit($args),
        'user'   => cmdUser($args),
        'repo'   => cmdRepo($args),
        'help', '--help', '-h' => cmdHelp(),
        'version', '--version', '-v' => cmdVersion(),
        default  => cmdUnknown($command),
    };
}

// -------------------------------------------------------------------------
// Commands
// -------------------------------------------------------------------------

function cmdServe(array $args): int
{
    // Truthful-stub law: the server assembly that
    // binds the ssh/http/git listeners and dispatches protocol handlers was
    // never written. The old body printed a startup banner, listed repos,
    // and exited 0 without accepting a single connection — indistinguishable
    // from success to a deploy script, which is how a scaffold becomes a
    // silently-broken "production" server. Refuse loudly (non-zero exit,
    // stderr, no banner) until the wiring lands; --daemon and --pid-file are
    // refused the same way because nothing forks or binds here. The class
    // pieces (Config, Repo, GitDaemon, HttpSmartProtocol\Server, SSHServer)
    // exist and are individually tested; nobody has wired them into a
    // running host. Inventory: README "Known gaps — open work".
    //
    // Exception: the explicit --http flag
    // assembles ONLY the smart-HTTP listener (read, write and LFS), which
    // is now real. The bare refusal below stays byte-identical for every
    // other invocation — the ssh/git-daemon listeners remain unwired
    // scaffold.
    if (\in_array('--http', $args, true)) {
        return cmdServeHttp($args);
    }

    \fwrite(
        \STDERR,
        "candy-git-server: 'serve' refuses to start — server assembly is not implemented; see docs (status: scaffold).\n"
    );

    return 1;
}

/**
 * serve --http --repo-root DIR [--http-port N] [--http-host H] [--config path]
 *
 * Serves the smart-HTTP transport: clone, fetch, push and LFS over the
 * synchronous router, behind per-repo authorization. Anonymous reads pass
 * only when git.allow_anonymous_read is on AND the repo carries a public
 * visibility marker; unauthenticated requests for gated content answer
 * 401 with a WWW-Authenticate: Basic challenge, authenticated-but-refused
 * requests answer 403, and writes (git-receive-pack, LFS upload) require
 * an account with write access.
 *
 * Exit codes: 1 flag error (missing --repo-root / bad port) or bind failure,
 * 0 after a signal shutdown (SIGINT/SIGTERM when pcntl is loaded).
 */
function cmdServeHttp(array $args): int
{
    $repoRoot = null;
    $port = 23232;
    $host = '127.0.0.1';
    $configPath = null;
    $portRaw = '';

    for ($i = 0; $i < \count($args); $i++) {
        $arg = $args[$i];
        if ($arg === '--http') {
            continue; // the mode selector that dispatched here — not an option
        }
        if ($arg === '--daemon' || $arg === '--pid-file' || $arg === '--verbose'
            || \str_starts_with($arg, '--pid-file=')) {
            // These flags belong to the bare `serve` contract and to future
            // daemon wiring; the --http listener cannot honor any of them,
            // so they are refused loudly rather than silently ignored. The
            // listener stays in the foreground (daemonize via a supervisor).
            \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.serve_http_flag_unsupported',
                ['flag' => \str_starts_with($arg, '--pid-file') ? '--pid-file' : $arg]) . "\n");
            return 1;
        }
        $flagNames = ['--repo-root', '--http-port', '--http-host', '--config', '--port'];
        $value = null;
        if (\in_array($arg, $flagNames, true)) {
            $value = $args[$i + 1] ?? null;
            if ($value === null || \str_starts_with($value, '--')) {
                \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.option_needs_value', ['option' => $arg]) . "\n");
                return 1;
            }
            $i++;
        } else {
            $eq = \strpos($arg, '=');
            if ($eq === false || !\in_array(\substr($arg, 0, $eq), $flagNames, true)) {
                if (\str_starts_with($arg, '--')) {
                    // A '--'-shaped argument this listener does not know is a
                    // typo or an unwired flag: refusing beats silently serving
                    // something the operator never asked for.
                    \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.serve_http_unknown_flag',
                        ['flag' => $eq === false ? $arg : \substr($arg, 0, $eq)]) . "\n");
                    return 1;
                }
                continue; // not a flag at all: a positional value
            }
            $value = \substr($arg, $eq + 1);
            $arg = \substr($arg, 0, $eq);
        }
        if ($arg === '--repo-root') {
            $repoRoot = (string) $value;
        } elseif ($arg === '--http-port' || $arg === '--port') {
            if ($arg === '--port') {
                // Deprecated alias, kept honest: it works, but names itself
                // as legacy on stderr before anything else happens.
                \fwrite(\STDERR, Lang::t('cli.port_deprecated') . "\n");
            }
            $portRaw = (string) $value;
            $port = (int) $value;
        } elseif ($arg === '--http-host') {
            $host = (string) $value;
        } elseif ($arg === '--config') {
            $configPath = (string) $value;
        }
    }

    if ($repoRoot === null) {
        \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.serve_http_needs_repo_root') . "\n");
        return 1;
    }
    if (!\is_dir($repoRoot)) {
        \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.serve_repo_root_not_dir', ['path' => $repoRoot]) . "\n");
        return 1;
    }
    if ($portRaw !== '' && !\ctype_digit($portRaw)) {
        // (int)'abc' === 0 would pass the range check and ask the kernel for
        // an EPHEMERAL port: garbage is refused by name, never coerced.
        \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.serve_http_port_not_a_number',
            ['port' => $portRaw]) . "\n");
        return 1;
    }
    if ($port < 0 || $port > 65535) {
        \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.serve_http_port_range', ['port' => (string) $port]) . "\n");
        return 1;
    }

    try {
        $config = $configPath !== null
            ? \SugarCraft\GitServer\Config::load($configPath)
            : \SugarCraft\GitServer\Config::fromDefaults();
    } catch (\RuntimeException | \InvalidArgumentException $e) {
        // A corrupt or unsupported config must name itself and stop the
        // launch — not surface as an uncaught fatal trace.
        \fwrite(\STDERR, 'candy-git-server: ' . $e->getMessage() . "\n");
        return 1;
    }

    // 038: a serve-time data plane parked in the system temp directory
    // is enumerable by local users and deletable by tmp cleaners — the
    // serve command says so even when the path came from a config file.
    $serveTemp = \sys_get_temp_dir();
    if (\str_starts_with($config->dataPath, $serveTemp . '/') || $config->dataPath === $serveTemp) {
        \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.warn_tmp_data_path', ['path' => $config->dataPath]) . "\n");
    }

    // Authz wiring: the anonymous-read lever comes from config (default
    // OFF); accounts come from the persisted store so `user add` and
    // `user key` actually reach the wire. A corrupt store refuses the
    // launch loudly rather than serving an auth-less server.
    //
    // Finding 032 (G-6): the listener's posture is armed by its OWN
    // constructor from the parsed config below — the process-global
    // AccessControl lever belongs to the daemon and SSH transports, and
    // serve --http starts neither, so bin no longer writes it. A raw
    // global write here would re-couple this launch to any co-tenant
    // posture in the process, which is exactly the seam the finding
    // closed; the shape is pinned by BinServeRefusalTest.

    try {
        // all() reads (and validates) the persisted store: a corrupt file
        // throws and refuses the launch rather than serving auth-less.
        $storedUsers = \SugarCraft\GitServer\UserStore::forDataPath($config->dataPath)->all();
    } catch (\RuntimeException $e) {
        \fwrite(\STDERR, 'candy-git-server: ' . $e->getMessage() . "\n");
        return 1;
    }

    // 107 boot sweep: temps minted by a SIGKILLed earlier run (user-store
    // exchanges, LFS object writes, init config) must not fossilise in
    // the plane — cleanup was in-process only. Age-gated (an in-flight
    // exchange of a sibling worker stays >1 h untouched), signature-gated
    // (operator scratch is never a candidate), owner-gated.
    AtomicWriter::sweepStaleTemps($config->dataPath);
    AtomicWriter::sweepStaleTemps($config->dataPath . '/tmp');
    AtomicWriter::sweepStaleTemps($config->sshPath());
    if ($config->lfsEnabled) {
        AtomicWriter::sweepStaleTemps($config->lfsPath(), AtomicWriter::STALE_TEMP_AGE_SECONDS, 3);
    }

    $server = new \SugarCraft\GitServer\HttpSmartProtocol\Server($config);
    // 011 (G-2): the boot snapshot becomes a LIVE watch instead of a
    // registerUser dump. Registering persisted accounts into the instance
    // map at boot is what made every account change invisible until a
    // restart — the stale instance copy always shadowed the file. Arming
    // the watch makes users.json the authority for disk accounts (the
    // instance registry still wins for purely in-process/test users), and
    // a later `user add` / rotation / deactivation takes effect on the
    // next authenticated request with no restart.
    $storedUserCount = \count($storedUsers);
    $server->watchUserStore($config->dataPath);
    $served = 0;
    $published = 0;
    // 089: scandir returns FALSE for an unreadable-but-existing root, and
    // (array)false is [false] — the old shape walked a literal false entry
    // toward Repo::new and died with a TypeError instead of a clean error
    // line. Guard the result, name the path, exit 1.
    $rootEntries = @\scandir($repoRoot);
    if ($rootEntries === false) {
        \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.repo_root_unreadable', ['path' => $repoRoot]) . "\n");

        return 1;
    }
    foreach ($rootEntries as $entry) {
        if ($entry === '.' || $entry === '..') {
            continue;
        }
        $dir = $repoRoot . '/' . $entry;
        if (!\is_dir($dir)) {
            continue;
        }
        // Bare repo (HEAD + objects) directly, or a normal repo whose .git is bare.
        if (\is_file($dir . '/HEAD') && \is_dir($dir . '/objects')) {
            $gitDir = $dir;
        } elseif (\is_file($dir . '/.git/HEAD') && \is_dir($dir . '/.git/objects')) {
            $gitDir = $dir . '/.git';
        } else {
            continue;
        }
        // Scanned repos default to PRIVATE: visibility persists only via
        // the marker an operator minted (repo create --public, or the
        // file itself). Directory presence is never publication.
        $repo = \SugarCraft\GitServer\Repo::new($entry, $gitDir)
            ->withVisibility(\SugarCraft\GitServer\Repo::markerVisibility($gitDir))
            // S25 (finding 012): the scan no longer forgets everything the
            // marker does not carry — description/collaborators/allowPush/
            // mirrorFrom/highlight all come back off the metadata plane,
            // so a CollaboratorOnly repo is still collaborator-only after
            // a restart instead of silently degrading to admin-only.
            ->withMetaFromDisk();
        if ($repo->isVisiblePublic()) {
            $published++;
        }
        $server->registerRepo($repo);
        $served++;
    }

    // Worker-per-request pool (owner ruling 8b): when the config knob is
    // on AND the host can fork, every accepted connection is served by a
    // dedicated worker that exits when done — one wedged push can no
    // longer delay the client queued behind it. Both degraded arms are
    // named out loud before the banner: an explicit off, and a host
    // without pcntl, because the serial loop is a real throughput and
    // availability trade the operator deserves to see, not inherit.
    $pool = null;
    if ($config->httpWorkerPerRequest) {
        if (\SugarCraft\GitServer\Support\WorkerFork::supported()) {
            $pool = new \SugarCraft\GitServer\Support\WorkerFork();
        } else {
            \fwrite(\STDERR, "candy-git-server: worker_per_request is on but this host cannot fork (no pcntl) — serving SERIALLY: one wedged request delays every other client\n");
        }
    } else {
        \fwrite(\STDERR, "candy-git-server: worker_per_request is off — serving SERIALLY: one wedged request delays every other client\n");
    }

    $listener = new \SugarCraft\GitServer\HttpSmartProtocol\HttpListener($server, $host, $port, workers: $pool);
    try {
        $listener->start();
    } catch (\RuntimeException $e) {
        \fwrite(\STDERR, 'candy-git-server: ' . $e->getMessage() . "\n");
        return 1;
    }
    // Graceful stop when signals are available; without pcntl the process
    // dies on the terminal's SIGINT default, which is still truthful.
    //
    // The handlers MUST be armed before the readiness banner is published
    // (2026-11-11, CI 143-vs-0 race): launchers treat the banner as "TERM
    // will be handled gracefully", and a loaded runner that deschedules the
    // child between the banner write and pcntl_signal() took the default
    // disposition instead — exit 143 where the contract promises 0.
    if (\function_exists('pcntl_signal')) {
        $stop = static function () use ($listener): void {
            $listener->stop();
            \React\EventLoop\Loop::stop();
        };
        \pcntl_signal(2, $stop);
        \pcntl_signal(15, $stop);
        // react/event-loop invokes pending signal handlers between ticks when
        // pcntl is loaded; SIGTERM defaults to 15, SIGINT to 2 — literals on
        // purpose (no ext-pcntl constant assumptions in bin).
    }

    \fwrite(\STDOUT, 'candy-git-server: ' . Lang::t('cli.serve_http_banner', [
        'addr' => (string) $listener->listenAddress(),
        'repos' => (string) $served,
        'published' => (string) $published,
        'users' => (string) $storedUserCount,
        'anon' => $config->allowAnonymousRead ? 'on' : 'off',
    ]) . "\n");

    \React\EventLoop\Loop::get()->run();
    $listener->stop();

    return 0;
}

function cmdInit(array $args): int
{
    $dataPath = bin_data_path($args[0] ?? null);

    if (\is_dir($dataPath) && \is_file($dataPath . '/config.yaml')) {
        echo Lang::t('cli.already_initialized', ['path' => $dataPath]) . "\n";
        return 0;
    }

    // 038: refuse an existing tree another uid created before we layer
    // credentials onto it.
    $foreign = bin_refuse_foreign_owner($dataPath);
    if ($foreign !== null) {
        return error(Lang::t('cli.init_foreign_owner', [
            'path' => $foreign,
            'uid'  => (string) @\fileowner($foreign),
        ]) . "\n");
    }

    echo Lang::t('cli.initializing', ['path' => $dataPath]) . "\n";

    // Create directories (038: explicit modes, never a umask-roll — the
    // data plane goes private, the jail group-readable at most).
    AtomicWriter::ensureDir($dataPath, 0700);
    foreach ([
        'repositories' => 0750,
        'ssh'          => 0700,
        'hooks'        => 0750,
        'tmp'          => 0700,
    ] as $dir => $mode) {
        AtomicWriter::ensureDir("{$dataPath}/{$dir}", $mode);
    }

    // Create config
    $config = Config::fromDefaults();
    $configYaml = <<<YAML
name: "CandyGitServer"
ssh:
  listen_addr: ":23231"
  public_url: "ssh://localhost:23231"
  key_path: "ssh/soft_serve_host"
git:
  listen_addr: ":9418"
  allow_anonymous_read: false
http:
  listen_addr: ":23232"
  public_url: "http://localhost:23232"
lfs:
  enabled: true
YAML;

    // The config can carry http.auth_secret (the token-mode signing key),
    // so it gets the same treatment the user store promises: created
    // 0600 on the temp inode before the payload lands — a bare
    // file_put_contents would inherit the process umask, and deployers
    // routinely run the init step with a 0022 or looser umask where the
    // secret would sit world-readable from first byte. (042: the shape
    // is now the shared Support\AtomicWriter discipline, so init, the
    // visibility marker and the description can no longer drift apart.)
    try {
        AtomicWriter::write("{$dataPath}/config.yaml", $configYaml, 0600);
    } catch (\RuntimeException $e) {
        if (\preg_match('/cannot open temp (\S+)$/', $e->getMessage(), $m) === 1) {
            return error(Lang::t('cli.init_temp_open_failed', ['tmp' => $m[1]]) . "\n");
        }

        return error(Lang::t('cli.init_publish_failed', ['data' => $dataPath]) . "\n");
    }

    echo Lang::t('cli.done') . "\n";
    echo Lang::t('cli.next_steps') . "\n";
    echo Lang::t('cli.next_step_1', ['path' => $dataPath]) . "\n";
    echo Lang::t('cli.next_step_2', ['path' => $dataPath]) . "\n";
    echo Lang::t('cli.next_step_3', ['path' => $dataPath]) . "\n";

    return 0;
}

function cmdUser(array $args): int
{
    $subcommand = $args[0] ?? 'help';
    $subargs    = \array_slice($args, 1);

    return match ($subcommand) {
        'add'        => cmdUserAdd($subargs),
        'key'        => cmdUserKey($subargs),
        'list'       => cmdUserList($subargs),
        'token'      => cmdUserToken($subargs),
        'remove'     => cmdUserRemove($subargs),
        'deactivate' => cmdUserDeactivate($subargs),
        'help'       => say(Lang::t('cli.usage_user_root')),
        default      => cmdUnknown("user {$subcommand}"),
    };
}

/**
 * `user remove <username> [datadir]` — delete an account outright
 * (S23, finding 040: the deletion door the enforced isActive machinery
 * always needed). The answer comes from inside the transaction, never
 * a pre-check snapshot; an unknown name is an honest refusal.
 */
function cmdUserRemove(array $args): int
{
    $username = $args[0] ?? '';
    if ($username === '' || !bin_valid_account_name($username)) {
        return error(Lang::t('cli.usage_user_remove') . "\n");
    }
    $dataPath = bin_data_path($args[1] ?? null);

    try {
        $store = UserStore::forDataPath($dataPath);
        $removed = $store->transaction(static fn (UserStore $store): bool => $store->remove($username));
        if (!$removed) {
            return error(Lang::t('cli.user_not_found', ['username' => $username, 'path' => $store->path()]) . "\n");
        }
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    echo Lang::t('cli.user_removed', ['username' => $username, 'path' => $store->path()]) . "\n";

    return 0;
}

/**
 * `user deactivate <username> [datadir]` — flip the account inactive
 * while every credential stays intact (S23, finding 040). The echo
 * reports the REAL persisted row: deactivating an already-inactive
 * account says so honestly rather than pretending to revoke twice.
 */
function cmdUserDeactivate(array $args): int
{
    $username = $args[0] ?? '';
    if ($username === '' || !bin_valid_account_name($username)) {
        return error(Lang::t('cli.usage_user_deactivate') . "\n");
    }
    $dataPath = bin_data_path($args[1] ?? null);

    try {
        $store = UserStore::forDataPath($dataPath);
        $updated = $store->transaction(static fn (UserStore $store): ?User => $store->deactivate($username));
        if ($updated === null) {
            return error(Lang::t('cli.user_not_found', ['username' => $username, 'path' => $store->path()]) . "\n");
        }
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    echo Lang::t('cli.user_deactivated', [
        'username' => $username,
        'active'   => $updated->isActive ? 'true' : 'false',
    ]) . "\n";
    if (!$updated->isActive) {
        echo Lang::t('cli.user_already_deactivated_note', ['username' => $username]) . "\n";
    }

    return 0;
}

/**
 * Mint an HTTP proxy-token signature for the `token` trust mode: the
 * "<expiry-unix>.<hex-hmac>" string the server's verifyUserToken accepts.
 * Requires the data path's config.yaml to define a non-empty
 * http.auth_secret — that is the only secret key the loader parses
 * (Config reads it off the `http:` block), so a top-level `auth:` section
 * would be silently dead and mint nothing.
 */
function cmdUserToken(array $args): int
{
    $username = $args[0] ?? '';
    if ($username === '' || !bin_valid_account_name($username)) {
        return error(Lang::t('cli.usage_user_token') . "\n");
    }

    $ttl      = \max(1, (int) ($args[1] ?? '3600'));
    $dataPath = bin_data_path($args[2] ?? null);

    try {
        $config = Config::load($dataPath . '/config.yaml');
    } catch (RuntimeException | InvalidArgumentException $error) {
        return error(Lang::t('cli.token_no_config', ['data' => $dataPath]) . "\n");
    }

    if ($config->authSecret === '') {
        return error(Lang::t('cli.token_no_secret') . "\n");
    }

    // S22 (finding 039): the mint side refuses a TTL past the ceiling
    // OUT LOUD (naming the knob) rather than silently minting a shorter
    // life the operator did not ask for — and the verifier independently
    // refuses any signature that claims more than the ceiling anyway.
    if ($ttl > $config->httpTokenMaxTtl) {
        return error(Lang::t('cli.token_ttl_capped', [
            'ttl' => (string) $ttl,
            'max' => (string) $config->httpTokenMaxTtl,
            'key' => 'http.token_max_ttl',
        ]) . "\n");
    }

    return say(\SugarCraft\GitServer\HttpSmartProtocol\Server::mintUserToken(
        $username,
        \time() + $ttl,
        $config->authSecret,
    ) . "\n");
}

/**
 * Resolve the data directory the same way every persistence-touching
 * command does: explicit positional arg, then CANDY_GIT_SERVER_DATA_PATH,
 * then the /tmp default (see README "Data
 * directory" — a systemd-tmpfiles-hostile default, so set the env for real
 * deployments).
 */
function bin_data_path(?string $explicit): string
{
    $path = $explicit ?? (\getenv('CANDY_GIT_SERVER_DATA_PATH') ?: \sys_get_temp_dir() . '/candy-git-server');
    // 038 admission: the /tmp default is tmpfiles-hostile AND locally
    // disclosure-prone. The README always said tmpfiles; it never said
    // 'local users can see your jail'. Any explicit choice (arg or env)
    // silences this; only the bare default talks.
    $temp = \sys_get_temp_dir();
    if (\str_starts_with($path, $temp . '/') || $path === $temp) {
        \fwrite(\STDERR, 'candy-git-server: ' . Lang::t('cli.warn_tmp_data_path', ['path' => $path]) . "\n");
    }

    return $path;
}

/**
 * Refuse to adopt a data plane owned by a different uid (038): the old
 * init happily layered config + jail onto a FIRST-CREATOR-SQUATTED
 * directory, handing the squatter (or being handed to them) every
 * later-created repo and user store underneath.
 */
function bin_refuse_foreign_owner(string $dataPath): ?string
{
    if (!\function_exists('fileowner')) {
        return null;
    }
    foreach ([$dataPath, $dataPath . '/repositories', $dataPath . '/ssh'] as $probe) {
        if (!\is_dir($probe)) {
            continue;
        }
        $owner = @\fileowner($probe);
        if ($owner !== false && $owner !== \getmyuid()) {
            return $probe;
        }
    }

    return null;
}

/**
 * Account names double as file-store keys, so the old /^[a-zA-Z0-9._-]+$/
 * gate is not enough on its own: '.' and '..' pass it and would address
 * parent paths wherever a name is later interpolated into a path
 * (the traversal shape the jail gate targets). Reject all-dot names outright.
 */
function bin_valid_account_name(string $name): bool
{
    return \preg_match('/^[a-zA-Z0-9._-]+$/', $name) === 1 && \preg_match('/^\.+$/', $name) !== 1;
}

function cmdUserAdd(array $args): int
{
    if (!isset($args[0])) {
        return error(Lang::t('cli.usage_user_add') . "\n");
    }

    $username = $args[0];
    $password = null;
    // S21 least-privilege (finding 036): an account is NOT an admin by
    // default. --admin raises the full-can global posture; --read states
    // the default out loud (mutually exclusive with --admin). The old
    // shape minted every CLI account as a global admin — the lib's
    // weakest default posture, softened by explicit flags.
    $admin = false;
    $explicitRead = false;
    $positional = [];
    for ($i = 1; $i < \count($args); $i++) {
        if ($args[$i] === '--password') {
            $password = $args[$i + 1] ?? null;
            if ($password === null) {
                return error(Lang::t('cli.password_flag_needs_value') . "\n");
            }
            $i++;
            continue;
        }
        if (\str_starts_with($args[$i], '--password=')) {
            $password = \substr($args[$i], \strlen('--password='));
            continue;
        }
        if ($args[$i] === '--admin') {
            $admin = true;
            continue;
        }
        if ($args[$i] === '--read') {
            $explicitRead = true;
            continue;
        }
        $positional[] = $args[$i];
    }
    if ($admin && $explicitRead) {
        return error(Lang::t('cli.user_add_flags_conflict') . "\n");
    }
    if ($password === '-') {
        $raw = \stream_get_contents(\STDIN);
        $password = $raw === false ? '' : \rtrim($raw, "\r\n");
    }
    if ($password === '') {
        return error(Lang::t('cli.password_flag_empty') . "\n");
    }
    $dataPath = bin_data_path($positional[0] ?? null);
    if (!bin_valid_account_name($username)) {
        return error(Lang::t('cli.username_invalid', ['username' => $username]) . "\n");
    }

    // Digest first: bcrypt belongs OUTSIDE the store lock — serializing
    // a 300 ms hashing window under contention is its own slow shape.
    $user = User::new($username)->withAdmin($admin);
    if ($password !== null) {
        // Only the password_hash() digest is persisted; the plaintext
        // is used once and discarded (never reaches users.json).
        $user = $user->withPasswordHash(\password_hash($password, \PASSWORD_DEFAULT));
    }

    try {
        $store = UserStore::forDataPath($dataPath);
        // S11 (findings 010, 105): the duplicate answer comes from
        // INSIDE the transaction and add()'s bool is finally CHECKED —
        // the old shape pre-checked against a snapshot (TOCTOU), discarded
        // the refusal, and let two racing adds both print success while
        // the later rename erased one account.
        $added = $store->transaction(static fn (UserStore $store): bool => $store->add($user));
        if (!$added) {
            return error(Lang::t('cli.user_exists', ['username' => $username, 'path' => $store->path()]) . "\n");
        }
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    echo Lang::t('cli.user_created', ['username' => $username, 'admin' => $admin ? 'true' : 'false']) . "\n";
    echo Lang::t('cli.user_key_hint', ['username' => $username]) . "\n";
    if ($password !== null) {
        echo Lang::t('cli.user_password_stored') . "\n";
    }
    echo "Persisted to {$store->path()}\n";

    return 0;
}

function cmdUserKey(array $args): int
{
    if (!isset($args[0]) || !isset($args[1])) {
        return error(Lang::t('cli.usage_user_key') . "\n");
    }

    [$username, $keyFile] = $args;
    $dataPath = bin_data_path($args[2] ?? null);
    $key = $keyFile === '-' ? \stream_get_contents(\STDIN) : @\file_get_contents($keyFile);

    if ($key === false || $key === '') {
        return error(Lang::t('cli.user_key_read_failed', ['file' => $keyFile]) . "\n");
    }

    try {
        $store = UserStore::forDataPath($dataPath);
        // Keys belong to accounts that EXIST in the store — the pre-fix
        // version built a throwaway User in memory, printed success, and
        // persisted nothing. S11 moved the whole check-and-write under
        // the transaction lock, so a concurrent `user add` cannot land
        // between reading the account and saving its new key list.
        // Returns the UPDATED account (immutable VO — safe to carry out of
        // the lock) or null for "no such account", so the honest key-list
        // echo below reflects exactly what was persisted.
        $updated = $store->transaction(function (UserStore $store) use ($username, $key): ?User {
            $user = $store->find($username);
            if ($user === null) {
                return null;
            }
            $next = $user->addAuthorizedKey(\trim($key));
            $store->put($next);

            return $next;
        });
        if ($updated === null) {
            return error(Lang::t('cli.user_not_found', ['username' => $username, 'path' => $store->path()]) . "\n");
        }
    } catch (\InvalidArgumentException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    echo Lang::t('cli.user_key_added', ['username' => $username]) . "\n";
    echo Lang::t('cli.user_keys_header') . "\n";
    foreach ($updated->authorizedKeysList() as $k) {
        echo Lang::t('cli.user_key_entry', ['prefix' => \substr($k, 0, 60)]) . "\n";
    }

    return 0;
}

function cmdUserList(array $args): int
{
    $dataPath = bin_data_path($args[0] ?? null);
    try {
        $store = UserStore::forDataPath($dataPath);
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    $users = $store->all();
    if ($users === []) {
        echo Lang::t('cli.user_list_empty') . "\n";

        return 0;
    }

    echo Lang::t('cli.user_list_header', ['path' => $store->path()]) . "\n";
    foreach ($users as $user) {
        echo \sprintf(
            "  %s (admin: %s, active: %s, %d key%s, password: %s)\n",
            $user->username,
            $user->isAdmin ? Lang::t('cli.bool_yes') : Lang::t('cli.bool_no'),
            $user->isActive ? Lang::t('cli.bool_yes') : Lang::t('cli.bool_no'),
            \count($user->authorizedKeysList()),
            \count($user->authorizedKeysList()) === 1 ? '' : 's',
            $user->passwordHash !== null ? 'set' : 'none',
        );
    }

    return 0;
}

function cmdRepo(array $args): int
{
    $subcommand = $args[0] ?? 'help';
    $subargs    = \array_slice($args, 1);

    return match ($subcommand) {
        'list'         => cmdRepoList($subargs),
        'create'       => cmdRepoCreate($subargs),
        'info'         => cmdRepoInfo($subargs),
        'collaborator' => cmdRepoCollaborator($subargs),
        'mirror'       => cmdRepoMirror($subargs),
        'push-access'  => cmdRepoPushAccess($subargs),
        'help'         => say(Lang::t('cli.usage_repo_root')),
        default        => cmdUnknown("repo {$subcommand}"),
    };
}

function cmdRepoList(array $args): int
{
    $dataPath = $args[0] ?? \getenv('CANDY_GIT_SERVER_DATA_PATH') ?: \sys_get_temp_dir() . '/candy-git-server';
    $reposPath = $dataPath . '/repositories';

    if (!\is_dir($reposPath)) {
        echo Lang::t('cli.no_repos') . "\n";
        return 0;
    }

    echo Lang::t('cli.repos_header') . "\n";
    $found = false;

    foreach (\scandir($reposPath) as $entry) {
        if ($entry === '.' || $entry === '..') continue;
        $repoPath = $reposPath . '/' . $entry;
        // Repo shapes accepted exactly as the serve scan accepts them: a
        // bare repo (HEAD + objects) or a normal repo whose .git is bare.
        if (\is_file($repoPath . '/HEAD') && \is_dir($repoPath . '/objects')) {
            $gitDir = $repoPath;
        } elseif (\is_file($repoPath . '/.git/HEAD') && \is_dir($repoPath . '/.git/objects')) {
            $gitDir = $repoPath . '/.git';
        } else {
            continue;
        }

        // Visibility persists only via the marker — directory presence
        // is never publication, the same law the serve scan obeys.
        $visibility = Repo::markerVisibility($gitDir);

        $found = true;
        echo Lang::t(
            $visibility === Visibility::Public ? 'cli.repo_listing_public' : 'cli.repo_listing_plain',
            ['name' => $entry]
        ) . "\n";
    }

    if (!$found) {
        echo Lang::t('cli.repo_listing_none') . "\n";
    }

    return 0;
}

function cmdRepoCreate(array $args): int
{
    if (!isset($args[0])) {
        return error(Lang::t('cli.usage_repo_create') . "\n");
    }

    $makePublic = false;
    $positional = [];
    foreach (\array_slice($args, 1) as $arg) {
        if ($arg === '--public') {
            $makePublic = true;
            continue;
        }
        if (\str_starts_with($arg, '--')) {
            // '--publc' must never be reinterpreted as a data path or a
            // silently-dropped extra positional: a typo'd flag is a usage
            // error, refused before anything is created.
            return error(Lang::t('cli.usage_repo_create') . "\n");
        }
        $positional[] = $arg;
    }

    $dataPath = $positional[0] ?? \getenv('CANDY_GIT_SERVER_DATA_PATH') ?: \sys_get_temp_dir() . '/candy-git-server';
    $name     = $args[0];

    if (!Repo::isJailSafeName($name)) {
        // The charset regex alone let '.' and '..' through — those address
        // the parent of the repositories jail, not a repo inside it.
        return error(Lang::t('cli.repo_invalid_name', ['name' => $name]) . "\n");
    }

    $path = "{$dataPath}/repositories/{$name}";
    // 013: creating over an existing git directory is refused, not
    // silently adopted — init() would happily reuse $path/.git, so a typo
    // aimed at a live repo would print "created" over it (and --public
    // would rewrite its marker). The operator must pick a fresh name or
    // adopt the directory deliberately through serve --repo-root, whose
    // scan honors the existing marker.
    if (\is_dir(Repo::gitDirFor($path))) {
        return error(Lang::t('cli.repo_exists', ['name' => $name, 'path' => $path]) . "\n");
    }

    // Created PRIVATE by default (fail-closed): visibility is a publish
    // decision, made once with --public and persisted as a marker inside
    // the repository so the scan-based launcher honors it.
    $repo = Repo::new($name, $path)->init();
    if ($makePublic) {
        $repo = $repo->withVisibility(Visibility::Public)->withPublic(true);
        $repo->writeVisibilityMarker();
    }

    echo Lang::t('cli.repo_created', ['name' => $name, 'path' => $path]) . "\n";
    // No clone URL is printed: whether anything listens depends on a
    // running server, and a "Clone URL: ssh://…" line invites users to
    // believe the repo is reachable before one is (i18n law — raw string,
    // all 16 locales stay untouched and the cli.repo_clone_url key goes
    // unused). The hint names the command that actually serves it. The
    // visibility clause is state-aware: an operator who passed --public
    // has already satisfied "private until --public", so telling them to
    // do it again while the lever they still need is git.allow_anonymous_read
    // would send them hunting the wrong knob.
    $visibilityNote = $makePublic
        ? "published via its marker; anonymous-read still needs git.allow_anonymous_read on"
        : 'private until --public; anonymous-read needs git.allow_anonymous_read';
    echo "Note: start a listener to serve it: candy-git-server serve --http --repo-root {$dataPath}/repositories ({$visibilityNote}).\n";

    return 0;
}

function cmdRepoInfo(array $args): int
{
    if (!isset($args[0])) {
        return error(Lang::t('cli.usage_repo_info') . "\n");
    }

    $dataPath = $args[1] ?? \getenv('CANDY_GIT_SERVER_DATA_PATH') ?: \sys_get_temp_dir() . '/candy-git-server';
    $name     = $args[0];
    $path     = "{$dataPath}/repositories/{$name}";

    if (!Repo::isJailSafeName($name)) {
        return error(Lang::t('cli.repo_invalid_name', ['name' => $name]) . "\n");
    }

    // Same shapes the serve scan accepts, same fail-closed marker law.
    if (\is_file($path . '/HEAD') && \is_dir($path . '/objects')) {
        $gitDir = $path;
    } elseif (\is_file($path . '/.git/HEAD') && \is_dir($path . '/.git/objects')) {
        $gitDir = $path . '/.git';
    } else {
        return error(Lang::t('cli.repo_not_found', ['name' => $name]) . "\n");
    }

    $repo = Repo::new($name, $gitDir)
        ->withVisibility(Repo::markerVisibility($gitDir))
        ->withMetaFromDisk(); // S25 (finding 012): info prints the persisted plane, not always-empty fields

    $yes = Lang::t('cli.bool_yes');
    $no  = Lang::t('cli.bool_no');

    echo Lang::t('cli.repo_info', [
        'name'        => $repo->name,
        'description' => $repo->description !== '' ? $repo->description : Lang::t('cli.none_value'),
        'is_public'   => $repo->isPublic ? $yes : $no,
        'is_private'  => $repo->isPrivate() ? $yes : $no,
        'allow_push'  => $repo->allowPush ? $yes : $no,
        'path'        => $repo->path(),
        'branches'    => \implode(', ', $repo->branches()),
        'tags'        => \implode(', ', $repo->tags()),
    ]) . "\n";

    // S25 (finding 012): the plane fields the base template never had a
    // slot for. Empty collaborator list prints as the localized "none"
    // rather than vanishing — an operator reading "Collaborators:" off a
    // CollaboratorOnly repo must be able to see that it is EMPTY (the
    // 012 failure mode was invisible ACL loss, not missing garnish).
    echo Lang::t('cli.repo_info_plane', [
        'collaborators'     => $repo->collaborators() !== [] ? \implode(', ', $repo->collaborators()) : Lang::t('cli.none_value'),
        'mirror'            => $repo->mirrorFrom ?? Lang::t('cli.none_value'),
        'highlight'         => $repo->highlightLanguage !== '' ? $repo->highlightLanguage : Lang::t('cli.none_value'),
        'mirror_last_try'   => ($last = $repo->mirrorLastAttempt()) === null ? Lang::t('cli.none_value') : \date('Y-m-d H:i:s', $last),
    ]) . "\n";

    return 0;
}

/**
 * `repo collaborator <name> add|remove <user> [datadir]` — persist the
 * collaborator list into the metadata plane (S25, finding 012; the ACL
 * this list enforces was volatile before the plane existed).
 */
function cmdRepoCollaborator(array $args): int
{
    [$name, $action, $user] = [$args[0] ?? '', $args[1] ?? '', $args[2] ?? ''];
    if ($name === '' || !Repo::isJailSafeName($name) || !\in_array($action, ['add', 'remove'], true) || $user === '') {
        return error(Lang::t('cli.usage_repo_collaborator') . "\n");
    }
    $dataPath = bin_data_path($args[3] ?? null);
    $repoPath = "{$dataPath}/repositories/{$name}";
    if (!\is_dir(Repo::gitDirFor($repoPath))) {
        return error(Lang::t('cli.repo_not_found', ['name' => $name]) . "\n");
    }

    $repo = Repo::new($name, $repoPath);
    try {
        $published = $repo->mutateMeta(static function (array $meta) use ($user, $action): array {
            $list = $meta['collaborators'];
            if ($action === 'add') {
                if (!\in_array($user, $list, true)) {
                    $list[] = $user;
                }
            } else {
                $list = \array_values(\array_filter($list, static fn (string $u): bool => $u !== $user));
            }
            $meta['collaborators'] = $list;

            return $meta;
        });
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    echo Lang::t($action === 'add' ? 'cli.repo_collaborator_added' : 'cli.repo_collaborator_removed', [
        'name'  => $name,
        'user'  => $user,
        'plane' => \implode(', ', $published['collaborators']) ?: '-',
    ]) . "\n";

    return 0;
}

/**
 * `repo mirror <name> [--clear | <url>] [datadir]` — persist the
 * upstream that makes a repo a mirror (S25: zero shipped production
 * callers existed for withMirrorFrom, so MirrorPuller was
 * dead-on-arrival by construction). The URL passes the SAME admission
 * the job applies at fetch time — refused upstreams never enter the
 * plane.
 */
function cmdRepoMirror(array $args): int
{
    $name = $args[0] ?? '';
    if ($name === '' || !Repo::isJailSafeName($name)) {
        return error(Lang::t('cli.usage_repo_mirror') . "\n");
    }
    $rest = \array_slice($args, 1);
    $dataPath = bin_data_path($rest[1] ?? null);
    $repoPath = "{$dataPath}/repositories/{$name}";
    if (!\is_dir(Repo::gitDirFor($repoPath))) {
        return error(Lang::t('cli.repo_not_found', ['name' => $name]) . "\n");
    }

    $repo = Repo::new($name, $repoPath);
    if (($rest[0] ?? '') === '--clear') {
        try {
            $repo->mutateMeta(static function (array $meta): array {
                $meta['mirrorFrom'] = null;

                return $meta;
            });
        } catch (\RuntimeException $e) {
            return error('candy-git-server: ' . $e->getMessage() . "\n");
        }
        echo Lang::t('cli.repo_mirror_cleared', ['name' => $name]) . "\n";

        return 0;
    }

    $url = $rest[0] ?? '';
    if ($url === '' || \str_starts_with($url, '--')) {
        return error(Lang::t('cli.usage_repo_mirror') . "\n");
    }
    // Door admission (mirror of the job's runtime refusal): the git://
    // verdict follows THIS data path's config when one exists.
    $allowGit = false;
    try {
        $allowGit = Config::load($dataPath . '/config.yaml')->mirrorAllowGitProtocol;
    } catch (\Throwable) {
        // No parsable config: the strict default stands (git:// refused).
    }
    $refusal = \SugarCraft\GitServer\Jobs\MirrorPuller::upstreamRefusal($url, $allowGit);
    if ($refusal !== null) {
        return error(Lang::t('cli.repo_mirror_refused', ['why' => $refusal]) . "\n");
    }

    try {
        $repo->mutateMeta(static function (array $meta) use ($url): array {
            $meta['mirrorFrom'] = $url;
            // A re-pointed upstream restarts the cadence honestly: the
            // old mirror's stamp says nothing about the new one.
            $meta['mirrorLastAttempt'] = null;

            return $meta;
        });
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    echo Lang::t('cli.repo_mirror_set', ['name' => $name, 'url' => $url]) . "\n";

    return 0;
}

/**
 * `repo push-access <name> allow|deny [datadir]` — the missing producer
 * for the allowPush posture canWrite already consults (S25, G-4 default
 * under finding 087: persist the vocabulary rather than delete it — the
 * plane now carries it, so a CollaboratorOnly repo's "anyone can push"
 * opt-in is a recorded operator decision, not test-only fiction).
 */
function cmdRepoPushAccess(array $args): int
{
    [$name, $decision] = [$args[0] ?? '', $args[1] ?? ''];
    if ($name === '' || !Repo::isJailSafeName($name) || !\in_array($decision, ['allow', 'deny'], true)) {
        return error(Lang::t('cli.usage_repo_push_access') . "\n");
    }
    $dataPath = bin_data_path($args[2] ?? null);
    $repoPath = "{$dataPath}/repositories/{$name}";
    if (!\is_dir(Repo::gitDirFor($repoPath))) {
        return error(Lang::t('cli.repo_not_found', ['name' => $name]) . "\n");
    }

    $repo = Repo::new($name, $repoPath);
    try {
        $repo->mutateMeta(static function (array $meta) use ($decision): array {
            $meta['allowPush'] = $decision === 'allow';

            return $meta;
        });
    } catch (\RuntimeException $e) {
        return error('candy-git-server: ' . $e->getMessage() . "\n");
    }

    echo Lang::t('cli.repo_push_access_set', [
        'name'  => $name,
        'value' => Lang::t($decision === 'allow' ? 'cli.bool_yes' : 'cli.bool_no'),
    ]) . "\n";

    return 0;
}

function cmdHelp(): int
{
    echo Lang::t('cli.help') . "\n";
    return 0;
}

function cmdVersion(): int
{
    echo Lang::t('cli.banner', ['version' => displayVersion()]) . "\n";
    return 0;
}

// -------------------------------------------------------------------------
// Helpers
// -------------------------------------------------------------------------

function error(string $msg): int
{
    \fwrite(\STDERR, $msg);
    return 1;
}

function say(string $msg): int
{
    echo $msg . "\n";
    return 0;
}

function cmdUnknown(string $cmd): int
{
    return error(Lang::t('cli.unknown_command', ['cmd' => $cmd]) . "\n");
}

// -------------------------------------------------------------------------
// Bootstrap
// -------------------------------------------------------------------------

exit(main($argv));
