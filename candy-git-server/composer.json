{
    "name": "sugarcraft/candy-git-server",
    "description": "Self-hostable Git server: smart-HTTP clone/fetch/push plus LFS run today via 'serve --http' behind fail-closed access gates; config, accounts, repos, git-daemon advertisement and a ForceCommand SSH dispatcher round out the library. Modeled on the charmbracelet/soft-serve Go project.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "git",
        "git-server",
        "soft-serve",
        "self-hosted",
        "ssh",
        "lfs",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/candy-git-server",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/candy-git-server/issues",
        "source": "https://github.com/sugarcraft/candy-git-server",
        "docs": "https://sugarcraft.github.io/lib/candy-git-server.html"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/sugar-async": "dev-master",
        "sugarcraft/sugar-core": "dev-master",
        "react/event-loop": "^1.6",
        "react/promise": "^3.3",
        "symfony/yaml": "^6.4 || ^7.0",
        "ext-json": "*",
        "ext-hash": "*",
        "ext-sockets": "*"
    },
    "suggest": {
        "ext-ssh2": "Enables the anonymous-read capability gate on the SSH ForceCommand dispatcher; without it, that gate stays closed and SSH access requires a stored account key."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\GitServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\GitServer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/candy-git-server"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "serve": "php bin/candy-git-server serve --http"
    }
}
