{
    "name": "sugarcraft/sugar-datepicker",
    "description": "Interactive month-grid date picker for terminal UIs. Supports month/year navigation with min/max selection constraints, single and range selection via a model wrapper implementing the MVC-style Model-Update-View (TEA) loop, keyboard navigation with a visible cursor, i18n month/day names, and customizable styling. Design antecedent: EthanEFung/bubble-datepicker, implemented natively in PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "datepicker",
        "calendar",
        "date",
        "bubble",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-datepicker",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-datepicker/issues",
        "source": "https://github.com/sugarcraft/sugar-datepicker",
        "docs": "https://sugarcraft.github.io/lib/sugar-datepicker.html"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-cellbuffer": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/sugar-testing": "dev-master",
        "sugarcraft/sugar-vterm": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\DatePicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\DatePicker\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
