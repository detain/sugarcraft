{
    "name": "sugarcraft/sugar-datepicker",
    "description": "PHP port of EthanEFung/bubble-datepicker \u2014 interactive date picker component for terminal UIs. Supports month/year navigation, keyboard navigation, date selection with visual cursor, and customizable styling.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "datepicker",
        "calendar",
        "date",
        "bubble",
        "sugarcraft"
    ],
    "homepage": "https://github.com/sugarcraft/sugar-datepicker",
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/sugarcraft/sugar-datepicker/issues",
        "source": "https://github.com/sugarcraft/sugar-datepicker"
    },
    "require": {
        "php": "^8.3",
        "sugarcraft/candy-core": "dev-master",
        "sugarcraft/sugar-cellbuffer": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sugarcraft/candy-testing": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "SugarCraft\\DatePicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCraft\\DatePicker\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
